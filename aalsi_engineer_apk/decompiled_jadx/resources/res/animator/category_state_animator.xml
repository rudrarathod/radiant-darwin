<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <objectAnimator
            android:duration="250"
            android:valueTo="4dp"
            android:propertyName="translationZ"/>
    </item>
    <item>
        <objectAnimator
            android:duration="250"
            android:valueTo="0dp"
            android:propertyName="translationZ"/>
    </item>
</selector>
