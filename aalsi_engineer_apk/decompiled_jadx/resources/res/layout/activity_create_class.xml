<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/grayF1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@drawable/bg_primary_color_gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:title="Create Class"
        app:titleTextColor="@color/white"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_btn_done"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/tv_class_type"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/class_type"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginEnd="16dp"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/rg_class"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_4sdp">
                <RadioButton
                    android:id="@+id/rb_regular_class"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/regular_class"
                    android:layout_weight="1"/>
                <RadioButton
                    android:id="@+id/rb_one_time_class"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/one_time_class"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_20sdp"/>
            </RadioGroup>
            <TextView
                android:id="@+id/tv_class_name_label"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/class_name"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginEnd="16dp"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_class_name"
                android:background="@color/white"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="46dp">
                <EditText
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:id="@+id/tv_class_name"
                    android:background="@color/white"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_class_name"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:inputType="text"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tv_subject_label"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/select_subject"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_select_subject"
                android:background="@color/white"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="46dp">
                <TextView
                    android:textColor="@color/color_666666"
                    android:ellipsize="end"
                    android:id="@+id/tv_select_subject"
                    android:background="@color/white"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/select_subject"
                    android:maxLines="1"
                    android:layout_weight="1"
                    style="@style/BaseTextAppearance.Title"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_chevron_right"
                    app:tint="@color/black"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tv_faculty_label"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/select_faculty"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_select_faculty"
                android:background="@color/white"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="46dp">
                <TextView
                    android:textColor="@color/color_666666"
                    android:ellipsize="end"
                    android:id="@+id/tv_select_faculty"
                    android:background="@color/white"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_faculty"
                    android:maxLines="1"
                    android:layout_weight="1"
                    style="@style/BaseTextAppearance.Title"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_chevron_right"
                    app:tint="@color/black"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tv_date_label"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/date"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginEnd="16dp"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_select_date"
                android:background="@color/white"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="46dp">
                <TextView
                    android:textColor="@color/color_666666"
                    android:ellipsize="end"
                    android:id="@+id/tv_select_date"
                    android:background="@color/white"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_date"
                    android:maxLines="1"
                    android:layout_weight="1"
                    style="@style/BaseTextAppearance.Title"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_one_time_class_calendar"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tv_start_time_label"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/start_time"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_start_time"
                android:background="@color/white"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="46dp">
                <TextView
                    android:textColor="@color/color_666666"
                    android:ellipsize="end"
                    android:id="@+id/tv_start_time"
                    android:background="@color/white"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_time"
                    android:maxLines="1"
                    android:layout_weight="1"
                    style="@style/BaseTextAppearance.Title"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_clock_time_colorsecondarytext"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tv_end_time_label"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/end_time"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_select_end_time"
                android:background="@color/white"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="@dimen/_4sdp">
                <TextView
                    android:textColor="@color/color_666666"
                    android:ellipsize="end"
                    android:id="@+id/tv_select_end_time"
                    android:background="@color/white"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_time"
                    android:maxLines="1"
                    android:layout_weight="1"
                    style="@style/BaseTextAppearance.Title"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_clock_time_colorsecondarytext"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tv_select_days_label"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/select_days"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/llDaysLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:weightSum="7">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:gravity="center"
                        android:id="@+id/sunText"
                        android:background="@drawable/shape_circle_filled_white"
                        android:padding="@dimen/ayp_8dp"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_margin="6dp"
                        android:text="@string/activity_create_class_sunText_text"
                        android:layout_weight="1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/BaseTextAppearance.Title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:gravity="center"
                        android:id="@+id/monText"
                        android:background="@drawable/shape_circle_filled_white"
                        android:padding="@dimen/ayp_8dp"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_margin="6dp"
                        android:text="@string/activity_create_class_monText_text"
                        android:layout_weight="1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/BaseTextAppearance.Title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:gravity="center"
                        android:id="@+id/tueText"
                        android:background="@drawable/shape_circle_filled_white"
                        android:padding="@dimen/ayp_8dp"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_margin="6dp"
                        android:text="@string/activity_create_class_tueText_text"
                        android:layout_weight="1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/BaseTextAppearance.Title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:gravity="center"
                        android:id="@+id/wedText"
                        android:background="@drawable/shape_circle_filled_white"
                        android:padding="@dimen/ayp_8dp"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_margin="6dp"
                        android:text="@string/activity_create_class_wedText_text"
                        android:layout_weight="1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/BaseTextAppearance.Title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:gravity="center"
                        android:id="@+id/thusText"
                        android:background="@drawable/shape_circle_filled_white"
                        android:padding="@dimen/ayp_8dp"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_margin="6dp"
                        android:text="@string/activity_create_class_thusText_text"
                        android:layout_weight="1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/BaseTextAppearance.Title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:gravity="center"
                        android:id="@+id/friText"
                        android:background="@drawable/shape_circle_filled_white"
                        android:padding="@dimen/ayp_8dp"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_margin="6dp"
                        android:text="@string/activity_create_class_friText_text"
                        android:layout_weight="1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/BaseTextAppearance.Title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:gravity="center"
                        android:id="@+id/satText"
                        android:background="@drawable/shape_circle_filled_white"
                        android:padding="@dimen/ayp_8dp"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_margin="6dp"
                        android:text="@string/activity_create_class_satText_text"
                        android:layout_weight="1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/BaseTextAppearance.Title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_days"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.card.MaterialCardView
        android:orientation="vertical"
        android:id="@+id/ll_btn_done"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <Button
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/b_done"
            android:background="@drawable/bg_button_click_color_primary"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/done"
            android:textAllCaps="false"/>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
