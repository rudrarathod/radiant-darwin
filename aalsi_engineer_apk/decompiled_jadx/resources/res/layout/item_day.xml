<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_rectangle_filled_white_r7"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="15dp"
    android:layout_marginTop="15dp"
    android:layout_marginRight="15dp"
    android:layout_marginBottom="10dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginStart="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_777777"
            android:gravity="center_vertical"
            android:id="@+id/tv_day_name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textAllCaps="true"
            style="@style/BaseTextAppearance.Title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/red3"
            android:id="@+id/tv_remove_day"
            android:paddingLeft="8dp"
            android:paddingTop="16dp"
            android:paddingRight="8dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/remove"
            android:textAllCaps="true"/>
    </LinearLayout>
    <View
        android:background="@color/divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_no_class"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="10dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/red3"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/no_class"
            android:layout_weight="1"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rl_day_timing"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:gravity="start|center_vertical"
            android:id="@+id/rl_day_from"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="10dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/divider_day"
            android:paddingStart="16dp"
            android:paddingEnd="10dp"
            android:layout_toStartOf="@+id/divider_day">
            <TextView
                android:id="@+id/tv_day_from"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/item_day_tv_day_from_text"
                android:layout_alignParentTop="true"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <TextView
                android:id="@+id/tv_day_from_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/time_no_caps"
                android:layout_below="@+id/tv_day_from"
                style="@style/BaseTextAppearance.ShadowTitle"/>
        </RelativeLayout>
        <View
            android:id="@+id/divider_day"
            android:background="@color/divider"
            android:layout_width="0.5dp"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/rl_day_from"
            android:layout_alignBottom="@+id/rl_day_from"
            android:layout_centerInParent="true"/>
        <RelativeLayout
            android:gravity="start|center_vertical"
            android:id="@+id/rl_day_to"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="10dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/divider_day"
            android:paddingStart="16dp"
            android:paddingEnd="10dp"
            android:layout_toEndOf="@+id/divider_day">
            <TextView
                android:id="@+id/tv_day_to"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/item_day_tv_day_to_text"
                android:layout_alignParentTop="true"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <TextView
                android:id="@+id/tv_day_to_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/time_no_caps"
                android:layout_below="@+id/tv_day_to"
                style="@style/BaseTextAppearance.ShadowTitle"/>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>
