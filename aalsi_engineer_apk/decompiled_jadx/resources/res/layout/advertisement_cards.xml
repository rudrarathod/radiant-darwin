<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_view_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginLeft="@dimen/ayp_8dp"
            android:layout_marginRight="@dimen/ayp_8dp">
            <View
                android:background="@color/grayE5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <View
                android:background="@color/gray74"
                android:layout_width="99dp"
                android:layout_height="33dp"
                android:layout_marginRight="@dimen/ayp_8dp"
                android:layout_marginBottom="@dimen/ayp_8dp"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="@dimen/ayp_8dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/dynamic_card_heading"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:paddingLeft="@dimen/ayp_8dp"
            android:paddingRight="@dimen/ayp_8dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ayp_8dp"
            android:layout_marginBottom="@dimen/ayp_8dp"/>
    </LinearLayout>
</LinearLayout>
