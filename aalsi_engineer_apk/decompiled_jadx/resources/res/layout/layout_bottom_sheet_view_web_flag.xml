<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_price_details"
    android:paddingLeft="20dp"
    android:paddingTop="25dp"
    android:paddingRight="20dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_view_on_web"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/black"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/icon_course_web"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/black"
            android:id="@+id/tv_view_on_web_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="@string/view_on_desktop"
            android:layout_toRightOf="@+id/iv_view_on_web"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/tv_view_on_web_status"
            android:background="#99b8e986"
            android:padding="3dp"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="@string/state_on"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/black"
        android:id="@+id/tv_view_restriction_title"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/layout_bottom_sheet_view_web_flag_tv_view_restriction_title_text"/>
    <View
        android:background="@color/gray79"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="10dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/absent_red"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/layout_bottom_sheet_view_web_flag_tv_done_text"
        android:foregroundGravity="center"
        android:textAllCaps="true"/>
</LinearLayout>
