<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/gray91"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@drawable/bg_primary_color_gradient"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:minHeight="?attr/actionBarSize"
            android:layout_alignParentTop="true"
            app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/ll_btn_done"
            android:layout_below="@+id/toolbar">
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/gray91"
                android:paddingBottom="50dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/llEzCreditLearnMore"
                    android:visibility="gone"
                    layout="@layout/layout_ezcredit_learn_more"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/text_select_student"
                    android:textAllCaps="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_select_student"
                    android:background="@color/white"
                    android:paddingLeft="20dp"
                    android:paddingTop="10dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/royalblue"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_student_name"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/text_select_student"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:tint="@color/colorSecondaryText"
                        app:srcCompat="@drawable/ic_chevron_right"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/course_name"
                    android:textAllCaps="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_transaction_name"
                    android:background="@color/white"
                    android:paddingLeft="20dp"
                    android:paddingTop="5dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/colorSecondaryText"
                        android:gravity="start|center_vertical"
                        android:id="@+id/et_transaction_name"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/enter_here"
                        android:maxLines="1"
                        android:backgroundTint="@android:color/transparent"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/effective_joining_date"
                    android:textAllCaps="true"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_select_date"
                    android:background="@color/white"
                    android:paddingLeft="20dp"
                    android:paddingTop="15dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_date"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/fee_structure"
                    android:textAllCaps="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_select_fee_structure"
                    android:background="@color/white"
                    android:paddingLeft="20dp"
                    android:paddingTop="10dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/royalblue"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_fee_structure"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/text_select_structure"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:tint="@color/colorSecondaryText"
                        app:srcCompat="@drawable/ic_chevron_right"/>
                </LinearLayout>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/colorSecondaryText"
                    android:id="@+id/tv_gst_label"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/activity_fee_record_tv_gst_label_text"
                    android:textAllCaps="true"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_gst_type"
                    android:background="@color/white"
                    android:paddingLeft="20dp"
                    android:paddingTop="15dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="15dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_gst"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/internet_handling_charge"
                    android:textAllCaps="true"/>
                <Spinner
                    android:id="@+id/spinner_handling_charge"
                    android:background="@color/white"
                    android:paddingLeft="15dp"
                    android:paddingTop="5dp"
                    android:paddingRight="15dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dropdown"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:id="@+id/tvDiscountAdjustment"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:textAllCaps="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_discount"
                    android:background="@color/white"
                    android:paddingLeft="20dp"
                    android:paddingTop="5dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/colorSecondaryText"
                        android:gravity="start|center_vertical"
                        android:id="@+id/et_discount"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/enter_here"
                        android:maxLines="1"
                        android:maxLength="6"
                        android:digits="0123456789"
                        android:inputType="number"
                        android:imeOptions="actionDone"
                        android:backgroundTint="@android:color/transparent"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llEzCreditContainer"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/colorSecondaryText"
                            android:paddingTop="20dp"
                            android:paddingBottom="10dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="20dp"
                            android:text="@string/easy_emi_option"
                            android:layout_weight="1"
                            android:textAllCaps="true"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/colorPrimary"
                            android:gravity="end"
                            android:id="@+id/tvEmiSchemes"
                            android:paddingTop="20dp"
                            android:paddingBottom="10dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="20dp"
                            android:text="@string/view_emi_schemes"
                            android:layout_weight="1"
                            android:textAllCaps="true"/>
                    </LinearLayout>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="0dp"
                        app:cardElevation="1dp">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/ll_checkbox_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <CheckBox
                                android:id="@+id/cbAllowEzCredit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:layout_marginBottom="12dp"
                                android:text="@string/allow_students_to_pay_via"
                                android:layout_marginStart="16dp"/>
                            <ImageView
                                android:id="@+id/ivEzcredit"
                                android:background="@drawable/bg_ezcred"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:textSize="12sp"
                        android:id="@+id/tvEzCredStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/not_applicable_on_fee_less_than_15000"
                        android:layout_marginStart="16dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <include
            android:id="@+id/ll_help_videos"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_above="@+id/ll_btn_done"
            layout="@layout/layout_help_button"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_btn_done"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <Button
                android:textSize="18sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/b_done"
                android:background="@drawable/bg_button_click_color_primary"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="10dp"
                android:text="@string/label_next"
                android:textAllCaps="false"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
