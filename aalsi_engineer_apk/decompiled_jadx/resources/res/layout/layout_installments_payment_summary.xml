<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_installments_payment_summary"
    android:background="@color/white"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llTotalAmount"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorPrimaryText"
            android:gravity="start|center_vertical"
            android:id="@+id/tvTotalAmountTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/total_amount"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorPrimaryText"
            android:gravity="end|center_vertical"
            android:id="@+id/tvTotalAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llInstallmentPaid"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorPrimaryText"
            android:gravity="start|center_vertical"
            android:id="@+id/tvInstallmentPaidTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/total_amount"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorPrimaryText"
            android:gravity="end|center_vertical"
            android:id="@+id/tvInstallmentPaid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llNextInstallment"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorPrimaryText"
            android:gravity="start|center_vertical"
            android:id="@+id/tvNextInstallmentTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/total_amount"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorPrimaryText"
            android:gravity="end|center_vertical"
            android:id="@+id/tvNextInstallment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="#efefef"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/view_installments"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorPrimary"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_view_installments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
</LinearLayout>
