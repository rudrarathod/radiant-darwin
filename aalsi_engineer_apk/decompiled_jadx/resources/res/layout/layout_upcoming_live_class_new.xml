<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_upcoming_new"
    android:background="@color/white"
    android:padding="16dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_upcoming_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_DE000000"
            android:id="@+id/tv_upcoming_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/upcoming_live_classes"
            android:layout_weight="1"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/colorPrimary"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_view_more_upcoming"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_all"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_99000000"
        android:id="@+id/upcoming_sub_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/classes_you_have_scheduled_in_this_course"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <co.classplus.app.ui.custom.HeightWrappingViewPager
            android:scrollbarSize="16dp"
            android:id="@+id/upcoming_view_pager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="172dp"
            android:minHeight="140dp"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/upcoming_tab_layout"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"
            app:tabBackground="@drawable/tab_selector"
            app:tabGravity="center"
            app:tabIndicatorHeight="0dp"
            app:tabPaddingEnd="7dp"
            app:tabPaddingStart="7dp"/>
    </LinearLayout>
</LinearLayout>
