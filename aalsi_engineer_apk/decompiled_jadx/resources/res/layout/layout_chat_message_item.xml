<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/tv_unread_count"
        android:background="@color/lightblue"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"/>
    <TextView
        android:textSize="14sp"
        android:gravity="center"
        android:id="@+id/date"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_unread_count"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/message_layout_left"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/date">
        <RelativeLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layoutImage_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_user_image"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"/>
            <ImageView
                android:id="@+id/iv_online_status"
                android:visibility="gone"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_alignBottom="@+id/iv_user_image"
                android:layout_alignEnd="@+id/iv_user_image"
                app:srcCompat="@drawable/shape_circle_filled_green"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/message_container_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_message_left"
                android:background="@drawable/chat_message_shape_left"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="50dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/sender_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="16dp"
                    android:lineSpacingExtra="4dp"/>
                <RelativeLayout
                    android:id="@+id/rl_meta_layout_left"
                    android:background="@drawable/reply_chat_message_shape_left"
                    android:padding="@dimen/_2sdp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_6sdp">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:id="@+id/tv_meta_title_left"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:layout_marginBottom="@dimen/_6sdp"
                        android:maxLines="1"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="@dimen/_2sdp"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/image_text_container_left"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_4sdp"
                        android:layout_below="@+id/tv_meta_title_left"
                        android:layout_alignParentStart="true">
                        <ImageView
                            android:id="@+id/iv_meta_left"
                            android:visibility="gone"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:scaleType="fitXY"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:id="@+id/ll_meta_text_left"
                            android:padding="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/black"
                                android:ellipsize="end"
                                android:id="@+id/tv_meta_url_left"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/_4sdp"
                                android:maxLines="1"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/black"
                                android:ellipsize="end"
                                android:id="@+id/tv_meta_description_left"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"/>
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_reply_chat_left"
                    android:background="@drawable/reply_chat_message_shape_left"
                    android:padding="@dimen/_8sdp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_8sdp">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:id="@+id/tv_parent_message_user_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_4sdp"
                        android:maxLines="1"
                        android:lineSpacingExtra="@dimen/_4sdp"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:id="@+id/tv_parent_message_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:maxLines="2"
                        android:lineSpacingExtra="@dimen/_4sdp"
                        android:alpha="0.87"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/delete_image_right"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:srcCompat="@drawable/ic_deleted_blocked"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:textColorLink="@color/link"
                        android:autoLink="all"
                        android:id="@+id/message_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="15dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="right"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/black"
                        android:id="@+id/time_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/message_layout_right"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/date">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/message_container_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="8dp"
            android:layout_alignParentRight="true"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_message_right"
                android:background="@drawable/chat_message_shape_right"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <RelativeLayout
                    android:gravity="end"
                    android:id="@+id/rl_meta_layout_right"
                    android:background="@drawable/reply_chat_message_shape_right"
                    android:padding="@dimen/_6sdp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_6sdp">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:id="@+id/tv_meta_title_right"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_4sdp"
                        android:maxLines="1"
                        android:layout_alignParentTop="true"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/image_text_container_right"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_2sdp"
                        android:layout_below="@+id/tv_meta_title_right"
                        android:layout_alignParentStart="true">
                        <ImageView
                            android:id="@+id/iv_meta_right"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:scaleType="fitXY"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/ll_meta_text_right"
                            android:padding="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/white"
                                android:ellipsize="end"
                                android:id="@+id/tv_meta_url_right"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/_4sdp"
                                android:maxLines="1"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/white"
                                android:ellipsize="end"
                                android:id="@+id/tv_meta_description_right"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"/>
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_reply_chat_right"
                    android:background="@drawable/reply_chat_message_shape_right"
                    android:padding="@dimen/_8sdp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/_8sdp">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:id="@+id/tv_parent_message_user_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:maxLines="1"
                        android:lineSpacingExtra="@dimen/_4sdp"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_parent_message_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:maxLines="2"
                        android:lineSpacingExtra="4sp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/delete_image"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:srcCompat="@drawable/ic_deleted_blocked"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:textColorLink="@color/white"
                        android:autoLink="all"
                        android:id="@+id/message_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="end|center_vertical"
                    android:layout_gravity="end|center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/white"
                        android:id="@+id/time_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <ImageView
                        android:gravity="end|center_vertical"
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/imageSentStatus_right"
                        android:visibility="gone"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginStart="5dp"
                        app:srcCompat="@drawable/ic_clock_time"
                        app:tint="@color/white"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="end|center_vertical"
                    android:layout_gravity="end|center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/red3"
                        android:id="@+id/textViewTapToResend"
                        android:paddingTop="5dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tap_to_resend"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:layout_gravity="end"
                android:id="@+id/tvSeenRight"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/layout_chat_message_item_tvSeenRight_text"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
