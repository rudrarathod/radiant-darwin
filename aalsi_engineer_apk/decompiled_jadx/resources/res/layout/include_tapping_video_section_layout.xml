<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_0A162999"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivBackButton"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="@dimen/_8sdp"
        android:layout_height="@dimen/_13sdp"
        android:contentDescription="@string/app_name"
        android:layout_marginStart="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="@+id/tvLiveClassName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvLiveClassName"
        app:srcCompat="@drawable/ic_back"/>
    <TextView
        android:ellipsize="marquee"
        android:id="@+id/tvLiveClassName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:layout_marginStart="@dimen/_12sdp"
        app:layout_constraintEnd_toStartOf="@+id/ivNewEndCall"
        app:layout_constraintStart_toEndOf="@+id/ivBackButton"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/nunito_sans_semi_bold_16_white"/>
    <LinearLayout
        android:id="@+id/llPlayControls"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivBack"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_back_10_sec"/>
        <ImageView
            android:id="@+id/ivPlayPause"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:srcCompat="@drawable/ic_pause_new"/>
        <ImageView
            android:id="@+id/ivForward"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_forward_10_sec"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivMuteStatus"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_14sdp"
            android:contentDescription="@string/app_name"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.498"
            app:srcCompat="@drawable/ic_new_mic"/>
        <ImageView
            android:id="@+id/ivVideoStatus"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_14sdp"
            android:contentDescription="@string/app_name"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivMuteStatus"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_new_video"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:gravity="center"
        android:id="@+id/ivNewEndCall"
        android:background="@drawable/red_color_less_rounded_corners"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:text="@string/end_live"
        android:textAlignment="center"
        android:layout_marginEnd="@dimen/_14sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/nunito_sans_regular_14_white"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clChatPollNotificationContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivNewEndCall">
        <ImageView
            android:id="@+id/ivChatSignifier"
            android:background="@drawable/bg_rounded_white"
            android:padding="@dimen/_8sdp"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="45dp"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:contentDescription="@string/app_name"
            android:layout_marginEnd="@dimen/_8sdp"
            app:layout_constraintBottom_toTopOf="@+id/ivPollSignifier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_new_chat"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvMessageCount"
            android:background="@drawable/prime_color_less_rounded_corners"
            android:visibility="gone"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/nunito_sans_semi_bold_8_white"/>
        <ImageView
            android:id="@+id/ivPollSignifier"
            android:background="@drawable/bg_rounded_white"
            android:padding="@dimen/_2sdp"
            android:visibility="gone"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:contentDescription="@string/app_name"
            android:layout_marginEnd="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivChatSignifier"
            app:srcCompat="@drawable/ic_new_polls"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvPollSignifier"
            android:background="@drawable/prime_color_less_rounded_corners"
            android:visibility="gone"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_8sdp"
            android:layout_marginTop="-4dp"
            android:layout_marginEnd="@dimen/_6sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivPollSignifier"
            style="@style/nunito_sans_semi_bold_10_white"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/ivShareLiveClass"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:layout_marginRight="@dimen/_14sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:contentDescription="@string/share"
        android:layout_marginHorizontal="@dimen/_14sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivDots"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:srcCompat="@drawable/ic_share_live_class"/>
    <ImageView
        android:id="@+id/ivDots"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_14sdp"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_new_3_dot"/>
    <ImageView
        android:id="@+id/ivRotateCamera"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_14sdp"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivVideoQuality"
        app:srcCompat="@drawable/ic_camera_switch"/>
    <ImageView
        android:id="@+id/ivVideoQuality"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_14sdp"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivAspectRatio"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:srcCompat="@drawable/ic_new_quality"/>
    <ImageView
        android:id="@+id/ivAspectRatio"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_14sdp"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivShareLiveClass"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:srcCompat="@drawable/ic_new_maximize"/>
    <TextView
        android:textSize="@dimen/x_small_text"
        android:textColor="@color/colorNextToWhite"
        android:gravity="center"
        android:id="@+id/tvAspectRatio"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:text="@string/fit_screen_video"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/ivAspectRatio"
        app:layout_constraintStart_toStartOf="@+id/ivAspectRatio"
        app:layout_constraintTop_toBottomOf="@+id/ivAspectRatio"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvTotalParticipantCount"
        android:focusable="true"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_18sdp"
        android:text="1"
        android:drawablePadding="@dimen/_6sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        app:drawableStartCompat="@drawable/ic_new_profile_user"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivSpeaker"
        style="@style/nunito_sans_semi_bold_14_white"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvWifiQuality"
        android:focusable="true"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_18sdp"
        android:text="@string/good"
        android:drawablePadding="@dimen/_6sdp"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        app:drawableStartCompat="@drawable/ic_new_excellent_network"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvTotalParticipantCount"
        style="@style/nunito_sans_semi_bold_14_green"/>
    <ImageView
        android:id="@+id/ivNetworkStrength"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_16sdp"
        android:contentDescription="@string/app_name"
        android:layout_marginEnd="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvWifiQuality"
        app:srcCompat="@drawable/ic_new_wifi_square"/>
    <TextView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tvDuration"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        app:layout_constraintBottom_toBottomOf="@+id/tvWifiQuality"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/nunito_sans_semi_bold_12_white"/>
    <TextView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tvDuration1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_14sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/nunito_sans_semi_bold_14_white"/>
    <androidx.media3.ui.DefaultTimeBar
        android:id="@+id/exo_progress"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="@+id/tvDuration"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintStart_toEndOf="@+id/tvDuration"
        app:layout_constraintTop_toTopOf="@+id/tvDuration"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="tvLiveTag, tvGoLiveTag"/>
    <TextView
        android:textSize="@dimen/_12sdp"
        android:textColor="@color/colorPrimary"
        android:gravity="center"
        android:id="@+id/tvGoLiveTag"
        android:background="@drawable/shape_rectangle_filled_white_outline_blue_r5"
        android:paddingLeft="@dimen/ayp_4dp"
        android:paddingRight="@dimen/ayp_4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_18sdp"
        android:text="Go Live"
        android:textAllCaps="true"
        android:layout_marginEnd="@dimen/_14sdp"
        android:paddingHorizontal="@dimen/ayp_4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvTotalParticipantCount"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvLiveTag"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_18sdp"
        android:text="@string/live_tag"
        android:drawablePadding="@dimen/_6sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        app:drawableStartCompat="@drawable/ic_red_color_drawable"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvTotalParticipantCount"
        style="@style/nunito_sans_semi_bold_12_white"/>
    <ImageView
        android:id="@+id/ivSpeaker"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_14sdp"
        android:contentDescription="@string/app_name"
        app:drawableStartCompat="@drawable/ic_new_profile_user"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivRotateCamera"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:srcCompat="@drawable/ic_new_speaker_on"/>
</androidx.constraintlayout.widget.ConstraintLayout>
