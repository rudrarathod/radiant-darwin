<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/item_recommend_course_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp">
    <RelativeLayout
        android:id="@+id/rv_main"
        android:background="@color/white"
        android:paddingLeft="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/img_Thumbnail"
            android:background="@drawable/shape_rectangle_filled_white_outline_gray_r6"
            android:layout_width="120dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:maxWidth="120dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="5dp"
            android:layout_toRightOf="@+id/img_Thumbnail"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="5dp"
            android:layout_toEndOf="@+id/img_Thumbnail">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="5">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/course_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorPrimaryText"
                        android:ellipsize="end"
                        android:layout_gravity="center"
                        android:id="@+id/heading"
                        android:tag="binding_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ems="10"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_subheading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp">
                    <ImageView
                        android:id="@+id/img_subheading_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginRight="@dimen/ayp_8dp"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:ellipsize="end"
                        android:id="@+id/tv_subheading"
                        android:tag="binding_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_emblem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColorHighlight="@color/gray74"
                        android:id="@+id/tv_emblem_text"
                        android:tag="binding_3"
                        android:paddingTop="@dimen/ayp_2dp"
                        android:paddingRight="@dimen/ayp_8dp"
                        android:paddingBottom="@dimen/ayp_2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="@dimen/ayp_8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/price_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimaryText"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_price_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/colorSecondaryText"
                        android:gravity="start|center_vertical"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_striked_price_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/ayp_red"
                        android:gravity="start|center_vertical"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_off_percent_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/rl_Addition"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="3dp"
                android:layout_weight="13"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="3dp">
                <ImageView
                    android:id="@+id/iv_course_cart_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="#52b062"
                    android:id="@+id/tv_course_cart_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/remove"
                    android:singleLine="true"
                    android:textAllCaps="true"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_left_label"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="@dimen/ayp_16dp"
        android:layout_marginStart="6dp"
        app:elevation="@dimen/ayp_4dp">
        <TextView
            android:textSize="12sp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_left_label"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <ImageView
            android:id="@+id/iv_left_label_triangle"
            android:layout_width="8dp"
            android:layout_height="8dp"
            app:srcCompat="@drawable/bg_left_label_triangle"/>
    </LinearLayout>
</RelativeLayout>
