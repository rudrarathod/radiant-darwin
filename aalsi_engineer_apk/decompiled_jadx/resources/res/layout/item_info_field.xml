<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/llMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_data"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/list_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="centerCrop"/>
        <ImageView
            android:id="@+id/user_icon"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:srcCompat="@drawable/ic_logo"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:id="@+id/inputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:ellipsize="end"
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:maxLines="1"
                        style="@style/BaseTextAppearance.SubTitle"/>
                    <androidx.appcompat.widget.AppCompatEditText
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/value"
                        android:background="@android:color/transparent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/ayp_8dp"
                        android:singleLine="true"
                        android:imeOptions="actionDone"
                        android:layout_marginEnd="@dimen/ayp_8dp"
                        style="@style/BaseTextAppearance.Title"/>
                </LinearLayout>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/llActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_call"
                        android:visibility="gone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_weight="1"
                        app:srcCompat="@drawable/ic_call"
                        app:tint="@color/gray66"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_sms"
                        android:visibility="gone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginLeft="@dimen/ayp_16dp"
                        android:layout_weight="2"
                        android:layout_marginStart="@dimen/ayp_16dp"
                        app:srcCompat="@drawable/ic_message_black"
                        app:tint="@color/gray66"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_mail"
                        android:visibility="gone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginLeft="@dimen/ayp_16dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/ayp_16dp"
                        app:srcCompat="@drawable/ic_mark_as_read"
                        app:tint="@color/gray66"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_more"
                        android:visibility="gone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginLeft="@dimen/ayp_16dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/ayp_16dp"
                        app:srcCompat="@drawable/ic_dots"
                        app:tint="@color/gray66"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="14sp"
                android:textColor="#de000000"
                android:id="@+id/documentUploadButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-3dp"
                android:minWidth="120dp"
                android:text="@string/view_file"
                android:layout_marginStart="-3dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:gravity="center"
        android:id="@+id/tv_message"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/item_info_field_tv_message_text"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_add_parent"
        android:background="@drawable/bg_parent_dash"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="@color/colorPrimary"
            app:srcCompat="@drawable/ic_add_circle_outline"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/colorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="@string/add_parent"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:layout_gravity="center"
        android:id="@+id/sectionFooter"
        android:background="@drawable/shape_rectangle_filled_primary_r5"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        style="@style/BaseTextAppearance.SubTitle"/>
</androidx.appcompat.widget.LinearLayoutCompat>
