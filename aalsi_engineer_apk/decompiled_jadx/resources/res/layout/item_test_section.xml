<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/white"
    android:paddingLeft="10dp"
    android:paddingTop="10dp"
    android:paddingRight="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
        android:textSize="16sp"
        android:textColor="@color/colorPrimaryText"
        android:textColorHint="@color/colorSecondaryText"
        android:ellipsize="end"
        android:id="@+id/et_section_name"
        android:background="@drawable/shape_rectangle_gray_outline_white_filled_r6"
        android:paddingLeft="5dp"
        android:paddingTop="10dp"
        android:paddingRight="5dp"
        android:paddingBottom="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/item_test_section_et_section_name_hint"
        android:maxLines="1"
        android:layout_weight="1"
        android:inputType="text"/>
    <EditText
        android:textSize="16sp"
        android:textColor="@color/colorPrimaryText"
        android:textColorHint="@color/colorSecondaryText"
        android:id="@+id/et_section_marks"
        android:background="@drawable/shape_rectangle_gray_outline_white_filled_r6"
        android:paddingLeft="5dp"
        android:paddingTop="10dp"
        android:paddingRight="5dp"
        android:paddingBottom="10dp"
        android:longClickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:hint="@string/item_test_section_et_section_marks_hint"
        android:maxLines="1"
        android:selectAllOnFocus="true"
        android:maxLength="4"
        android:digits="0123456789"
        android:inputType="numberDecimal"/>
    <ImageView
        android:id="@+id/iv_delete"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:tint="@color/absent_red"
        app:srcCompat="@drawable/ic_delete"/>
</LinearLayout>
