<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh_layout"
    android:background="@color/gray91"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="20dp">
        <RelativeLayout
            android:background="@color/gray91"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layout_top_view"
                android:background="@color/white"
                android:paddingTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="7">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="invisible"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorSecondaryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/batches"/>
                    <TextView
                        android:textSize="30sp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_num_batches"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <RelativeLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3">
                    <ImageView
                        android:id="@+id/iv_dp"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_centerHorizontal="true"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/llName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_below="@+id/iv_dp"
                        android:layout_centerHorizontal="true">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/tv_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"/>
                        <TextView
                            android:textSize="8sp"
                            android:textColor="@color/white"
                            android:id="@+id/tv_pro"
                            android:background="@drawable/bg_rounded_golden"
                            android:paddingLeft="10dp"
                            android:paddingTop="2dp"
                            android:paddingRight="10dp"
                            android:paddingBottom="2dp"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pro"
                            android:layout_marginStart="3dp"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorPrimary"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/tv_profile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/view_profile"
                        android:maxLines="1"
                        android:layout_below="@+id/llName"/>
                </RelativeLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="invisible"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorSecondaryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sms_sent"/>
                    <TextView
                        android:textSize="30sp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_sms_sent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:gravity="center_vertical"
                android:id="@+id/tv_sms_header"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/recharge"
                android:layout_below="@+id/layout_top_view"
                android:textAllCaps="true"
                android:paddingStart="15dp"
                android:paddingEnd="10dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layout_recharge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_sms_header">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/layout_sms"
                    android:background="@color/white"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="4dp">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        app:srcCompat="@drawable/ic_sms"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorText_Black_Alpha_99"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/sms"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorPrimaryText"
                        android:gravity="center"
                        android:id="@+id/tv_sms_left"
                        android:background="@drawable/bg_blue_corner_radius_2"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/layout_live"
                    android:background="@color/white"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="8dp">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        app:srcCompat="@drawable/ic_live"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorText_Black_Alpha_99"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/live_stream"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorPrimaryText"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/tv_live_left"
                        android:background="@drawable/bg_blue_corner_radius_2"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:gravity="center_vertical"
                android:id="@+id/tv_stats"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/fragment_dashboard_tv_stats_text"
                android:layout_below="@+id/layout_recharge"
                android:paddingStart="15dp"
                android:paddingEnd="10dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorSecondaryText"
                android:gravity="center_vertical"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/last_7_days"
                android:layout_alignTop="@+id/tv_stats"
                android:layout_alignBottom="@+id/tv_stats"
                android:layout_alignParentRight="true"
                android:textAllCaps="true"
                android:layout_alignParentEnd="true"/>
            <LinearLayout
                android:id="@+id/layout_stats_top"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginBottom="2dp"
                android:weightSum="2"
                android:layout_below="@+id/tv_stats">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="1dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="1dp">
                    <TextView
                        android:textSize="33sp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/tv_total_students"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/colorSecondaryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/total_students"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="1dp"
                    android:layout_weight="1"
                    android:layout_marginStart="1dp">
                    <TextView
                        android:textSize="33sp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/tv_signed_up_students"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/colorSecondaryText"
                        android:id="@+id/tv_signed_up_students_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layout_stats_bottom"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:baselineAligned="false"
                android:weightSum="2"
                android:layout_below="@+id/layout_stats_top">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="1dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="1dp">
                    <TextView
                        android:textSize="33sp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/tv_classes_conducted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/colorSecondaryText"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/classes_conducted_out_of"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/colorSecondaryText"
                        android:id="@+id/tv_total_classes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="1dp"
                    android:layout_weight="1"
                    android:layout_marginStart="1dp">
                    <TextView
                        android:textSize="33sp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/tv_tests_conducted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/colorSecondaryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/tests_conducted"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/colorSecondaryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:gravity="center_vertical"
                android:id="@+id/tv_coins"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/coins"
                android:layout_below="@+id/layout_stats_bottom"
                android:textAllCaps="true"
                android:paddingStart="15dp"
                android:paddingEnd="10dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layout_coins"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:weightSum="3"
                android:layout_below="@+id/tv_coins">
                <RelativeLayout
                    android:gravity="center"
                    android:background="@color/white"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="1dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="1dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/colorSecondaryText"
                        android:id="@+id/tv_coin_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/available_credits"
                        android:layout_centerHorizontal="true"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tv_coin_status">
                        <TextView
                            android:textSize="20sp"
                            android:textColor="@color/black"
                            android:id="@+id/tv_num_coins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <ImageView
                            android:id="@+id/iv_num_coins"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginLeft="5dp"
                            android:layout_marginStart="5dp"
                            app:srcCompat="@drawable/ic_coins"/>
                    </LinearLayout>
                </RelativeLayout>
                <RelativeLayout
                    android:gravity="center"
                    android:background="@color/white"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="1dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="1dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/colorSecondaryText"
                        android:id="@+id/tv_last_month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fragment_dashboard_tv_last_month_text"
                        android:layout_centerHorizontal="true"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tv_last_month">
                        <TextView
                            android:textSize="20sp"
                            android:textColor="@color/black"
                            android:id="@+id/tv_last_month_coins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <ImageView
                            android:id="@+id/iv_last_month_coins"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginLeft="5dp"
                            android:layout_marginStart="5dp"
                            app:srcCompat="@drawable/ic_coins"/>
                    </LinearLayout>
                </RelativeLayout>
                <RelativeLayout
                    android:gravity="center"
                    android:background="@color/white"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/colorSecondaryText"
                        android:id="@+id/tv_projected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fragment_dashboard_tv_projected_text"
                        android:layout_centerHorizontal="true"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tv_projected">
                        <TextView
                            android:textSize="20sp"
                            android:textColor="@color/black"
                            android:id="@+id/tv_projected_coins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <ImageView
                            android:id="@+id/iv_projected_coins"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginLeft="5dp"
                            android:layout_marginStart="5dp"/>
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
            <include
                android:visibility="gone"
                layout="@layout/common_progressbar"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
