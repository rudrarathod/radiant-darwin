<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="4dp">
    <RelativeLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rl_header"
            android:paddingLeft="10dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_alignParentTop="true"
            android:paddingStart="10dp"
            android:paddingEnd="20dp">
            <ImageView
                android:id="@+id/iv_close"
                android:padding="5dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:tint="@color/colorSecondaryText"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ic_close_cross"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:id="@+id/tv_heading"
                android:paddingLeft="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_toRightOf="@+id/iv_close"
                android:layout_centerVertical="true"
                android:textAllCaps="true"
                android:paddingStart="20dp"
                android:layout_toEndOf="@+id/iv_close"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorPrimary"
                android:id="@+id/tv_clear_all"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:textAllCaps="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/divider_1"
            android:background="@color/gray79"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_below="@+id/rl_header"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/sv_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/divider_2"
            android:layout_below="@+id/divider_1">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="13sp"
                    android:id="@+id/tv_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/layout_bottom_sheet_n_options_tv_filter_text"
                    android:layout_marginStart="15dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_filters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="13sp"
                    android:id="@+id/tv_categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/categories_cards_tv_day_name_text"
                    android:layout_marginStart="15dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_categories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <View
            android:id="@+id/divider_2"
            android:background="@color/gray79"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_above="@+id/btn_apply_filter"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="start|bottom"
            android:id="@+id/btn_apply_filter"
            android:background="@drawable/bg_button_click_color_primary"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="24dp"
            android:text="@string/apply"
            android:layout_alignParentBottom="true"
            android:textAllCaps="false"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
