<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/gray91"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@drawable/bg_primary_color_gradient"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/colorSecondaryText"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:text="@string/enter_billing_details"
        android:textAllCaps="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingLeft="20dp"
        android:paddingTop="5dp"
        android:paddingRight="20dp"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="18sp"
            android:textColor="@color/black"
            android:gravity="start|top"
            android:id="@+id/et_billing_details"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="@string/activity_tax_details_et_billing_details_hint"
            android:maxLines="4"
            android:imeOptions="actionGo"
            android:backgroundTint="@android:color/transparent"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/colorSecondaryText"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:text="@string/tax"
        android:textAllCaps="true"/>
    <LinearLayout
        android:background="@color/white"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="18sp"
            android:textColor="@color/black"
            android:gravity="start|center_vertical"
            android:id="@+id/et_tax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:maxLength="5"
            android:digits="0123456789."
            android:inputType="number"
            android:imeOptions="actionNext"
            android:backgroundTint="@android:color/transparent"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/colorSecondaryText"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:text="@string/gstin"
        android:textAllCaps="true"/>
    <LinearLayout
        android:background="@color/white"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="18sp"
            android:textColor="@color/black"
            android:gravity="start|center_vertical"
            android:id="@+id/et_gstin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/activity_tax_details_et_gstin_hint"
            android:maxLines="1"
            android:maxLength="15"
            android:inputType="text"
            android:imeOptions="actionNext"
            android:backgroundTint="@android:color/transparent"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/colorSecondaryText"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:text="@string/address"
        android:textAllCaps="true"/>
    <LinearLayout
        android:background="@color/white"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="18sp"
            android:textColor="@color/black"
            android:gravity="start|center_vertical"
            android:id="@+id/et_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:backgroundTint="@android:color/transparent"/>
    </LinearLayout>
</LinearLayout>
