<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layoutForBackground"
        android:background="@color/coupon_dot_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/rvStudentErrorList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@drawable/bg_primary_color_gradient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/ayp_12sp"
            android:textColor="@color/black"
            android:id="@+id/headerText"
            android:background="@drawable/bg_blue_corner_radius_2"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4sp"
            android:textAlignment="center"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <TextView
            android:textSize="@dimen/ayp_12sp"
            android:textColor="@color/color_99000000"
            android:id="@+id/errorCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ayp_16dp"
            android:layout_marginBottom="12dp"
            android:text="@string/error_count"
            android:textAllCaps="true"
            android:layout_marginStart="@dimen/ayp_16dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStudentErrorList"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/divider1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutForBackground"/>
    <View
        android:id="@+id/divider1"
        android:background="@drawable/bg_button_click_disabled"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginBottom="@dimen/ayp_16dp"
        android:elevation="0.5dp"
        app:layout_constraintBottom_toTopOf="@+id/footerDescription"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/ayp_12sp"
        android:textColor="@color/black"
        android:id="@+id/footerDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/ayp_16dp"
        android:lineSpacingExtra="4sp"
        app:layout_constraintBottom_toTopOf="@+id/btnAddStudent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Button
        android:textSize="@dimen/ts_16sp"
        android:id="@+id/btnAddStudent"
        android:background="@drawable/bg_button_click_gradient"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="@dimen/ayp_16dp"
        android:text="@string/accept_and_add_student"
        android:lineSpacingExtra="5sp"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
