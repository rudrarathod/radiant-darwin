<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_view_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="@dimen/ayp_8dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="@dimen/ayp_8dp">
        <View
            android:layout_width="match_parent"
            android:layout_height="68dp"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ayp_8dp"
            android:layout_marginBottom="@dimen/ayp_8dp"
            app:elevation="2dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/bgimage"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="1">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:layout_weight="0.7"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#de000000"
                            android:id="@+id/tv_heading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <ImageView
                            android:id="@+id/ivHeadingIcon"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#99000000"
                            android:id="@+id/tv_subheading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorPrimary"
                            android:id="@+id/tv_emblem"
                            android:background="@drawable/bg_round_transparent_primary"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"/>
                    </LinearLayout>
                </LinearLayout>
                <ImageView
                    android:layout_gravity="end"
                    android:id="@+id/ivCrossIcon"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"/>
            </FrameLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</LinearLayout>
