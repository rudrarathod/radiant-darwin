<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginRight="1dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="4dp"
        app:cardElevation="2dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/image"
                    android:layout_width="22dp"
                    android:layout_height="18dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="@dimen/ayp_16dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="@dimen/ayp_16dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#000000"
                        android:id="@+id/heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#777777"
                        android:id="@+id/subHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="24dp"/>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14sp"
                    android:textColor="#009ae0"
                    android:id="@+id/tv_emblem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="24dp"
                    android:layout_marginTop="@dimen/ayp_16dp"
                    android:layout_marginRight="16dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_accept_reject"
                    android:background="@drawable/shape_rectangle_gray_outline_r6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    android:outlineSpotShadowColor="#d3d3d3">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/iv_accept"
                        android:padding="8dp"
                        android:layout_width="31dp"
                        android:layout_height="29dp"
                        android:layout_weight="1"
                        app:srcCompat="@drawable/check"/>
                    <View
                        android:id="@+id/divider2"
                        android:background="#d3d3d3"
                        android:layout_width="1dp"
                        android:layout_height="28dp"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/iv_reject"
                        android:padding="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/ayp_8dp"
                        android:layout_weight="1"
                        app:srcCompat="@drawable/ic_cross_cp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.appcompat.widget.LinearLayoutCompat>
