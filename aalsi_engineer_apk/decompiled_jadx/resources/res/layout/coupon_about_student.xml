<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/studentName"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/aya_24dp"/>
    <View
        android:background="#e5e5e5"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/aya_24dp">
        <TextView
            android:textColor="@color/colorText_Black_Alpha_99"
            android:id="@+id/titleBatches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ayp_8dp"
            android:text="@string/batches"
            android:textAllCaps="true"/>
        <TextView
            android:textColor="@color/black"
            android:ellipsize="end"
            android:id="@+id/batches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/aya_24dp"
            android:maxLines="2"/>
        <TextView
            android:textColor="@color/colorText_Black_Alpha_99"
            android:id="@+id/titleCourses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ayp_8dp"
            android:text="@string/courses"
            android:textAllCaps="true"/>
        <TextView
            android:textColor="@color/black"
            android:ellipsize="end"
            android:id="@+id/courses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
    </LinearLayout>
    <View
        android:background="#e5e5e5"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <Button
        android:textColor="@color/filter_done"
        android:id="@+id/cancel"
        android:background="@color/white"
        android:padding="@dimen/ayp_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel_caps"/>
</LinearLayout>
