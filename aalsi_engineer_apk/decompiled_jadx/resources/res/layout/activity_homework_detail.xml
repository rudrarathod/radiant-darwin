<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/assignment_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@drawable/bg_primary_color_gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <LinearLayout
        android:gravity="start"
        android:orientation="horizontal"
        android:id="@+id/layout_search"
        android:background="@drawable/shape_rectangle_filled_white_r7"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="8dp"
        android:layout_below="@+id/toolbar">
        <androidx.appcompat.widget.SearchView
            android:layout_gravity="start"
            android:id="@+id/search_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/colorSecondaryText"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_search"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/search_students"/>
    </LinearLayout>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/ll_edit_status"
        android:layout_below="@+id/layout_search">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:background="@color/assignment_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="enterAlways|scroll">
                <include
                    android:id="@+id/item_homework_details_head"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/item_homework_detail_head"/>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/rlViewDetails"
                    android:background="@color/white"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:id="@+id/view"
                        android:background="@color/grayE5"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:padding="14dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/view_details"
                        android:layout_below="@+id/view"/>
                    <ImageView
                        android:padding="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tint="@color/black"
                        android:layout_below="@+id/view"
                        android:layout_alignParentEnd="true"
                        app:srcCompat="@drawable/ic_chevron_down"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llDetails"
                    android:background="@color/white"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_hint"
                        android:background="@drawable/bg_blue_corner_radius_2"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/late_submission_text"
                            android:layout_weight="1"
                            android:lineSpacingExtra="1.5dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_notes"
                        android:background="@color/white"
                        android:paddingTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/colorText_Black_Alpha_99"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/notes"
                            android:textAllCaps="true"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorPrimaryText"
                            android:id="@+id/tv_notes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/link"
                            android:id="@+id/tv_read_more"
                            android:paddingBottom="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/view_more_non_caps"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/link"
                            android:id="@+id/tv_read_less"
                            android:paddingBottom="8dp"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/view_less_non_caps"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_attachments"
                        android:background="@color/white"
                        android:paddingTop="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/colorText_Black_Alpha_99"
                            android:id="@+id/tv_attachment_heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/attachments"
                            android:textAllCaps="true"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"/>
                        <View
                            android:background="@color/grayE5"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_attachements"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/link"
                            android:id="@+id/tv_attachment_view_more"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/view_more_non_caps"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/link"
                            android:id="@+id/tv_attachment_view_less"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/view_less_non_caps"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"/>
                    </LinearLayout>
                    <RelativeLayout
                        android:gravity="center_vertical"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/rlHideDetails"
                        android:background="@color/white"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <View
                            android:id="@+id/view2"
                            android:background="@color/grayE5"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:padding="14dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hide_details"/>
                        <ImageView
                            android:padding="10dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tint="@color/black"
                            android:layout_alignParentEnd="true"
                            app:srcCompat="@drawable/ic_arrow_up"/>
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/colorText_Black_Alpha_99"
                    android:id="@+id/tv_students_heading"
                    android:paddingTop="16dp"
                    android:paddingBottom="11dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/text_students"
                    android:layout_weight="1"
                    android:textAllCaps="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
                <RelativeLayout
                    android:layout_width="25dp"
                    android:layout_height="25dp">
                    <ImageView
                        android:id="@+id/iv_filter"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:tint="@color/colorSecondaryText"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="3dp"
                        android:layout_alignParentEnd="true"
                        app:srcCompat="@drawable/ic_filter_outline"/>
                    <View
                        android:id="@+id/dot_view"
                        android:background="@drawable/shape_circle_filled_red"
                        android:visibility="gone"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginBottom="10dp"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:backgroundTint="@color/present_green"/>
                </RelativeLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/colorText_Black_Alpha_99"
                    android:id="@+id/tvFilter"
                    android:paddingTop="@dimen/ayp_8dp"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_caps"
                    android:paddingStart="6dp"
                    android:paddingEnd="16dp"/>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <LinearLayout
            android:background="@color/assignment_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_hw_status"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/ll_edit_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardElevation="12dp">
        <Button
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/btn_edit_status"
            android:background="@drawable/bg_button_click_color_primary"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/activity_homework_detail_btn_edit_status_text"
            android:textAllCaps="false"/>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_no_data"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/layout_search"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            app:srcCompat="@drawable/ic_students_empty"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/colorPrimaryText"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="@string/student_not_found"/>
    </LinearLayout>
</RelativeLayout>
