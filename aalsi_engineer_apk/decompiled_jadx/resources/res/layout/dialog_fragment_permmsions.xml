<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:layout_marginBottom="20dp"
    app:cardCornerRadius="10dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_title"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:text="@string/enable_permissions"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"/>
                <View
                    android:background="#e5e5e5"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_permission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/btn_bottom"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/nested_scroll_view"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:id="@+id/tv_dismiss"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:layout_weight="1"
                android:textAlignment="center"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="16sp"
                android:textColor="@color/white"
                android:id="@+id/btn_accept"
                android:background="@color/green"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/dialog_fragment_permmsions_btn_accept_text"
                android:layout_weight="1"
                app:elevation="0dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
