<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@drawable/bg_primary_color_gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <ScrollView
        android:id="@+id/ll_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clDocsListContainer"
            android:background="@drawable/shape_rectangle_gray_outline_r8"
            android:paddingBottom="@dimen/ayp_16dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/ayp_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/ts_16sp"
                android:textColor="@color/black"
                android:gravity="center_vertical"
                android:id="@+id/tvHeadingFileCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/ayp_16dp"
                android:drawablePadding="@dimen/ayp_16dp"
                android:drawableStart="@drawable/ic_question_paper_green_book"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_collapseButtonUp"
                android:padding="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="7dp"
                app:layout_constraintBottom_toTopOf="@+id/viewSeparator"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/coupon_arrow_up"/>
            <ImageView
                android:id="@+id/iv_collapseButtonDown"
                android:padding="15dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="7dp"
                app:layout_constraintBottom_toTopOf="@+id/viewSeparator"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/coupon_arrow_bottom"/>
            <View
                android:id="@+id/viewSeparator"
                android:background="@color/gray90"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/ayp_16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvHeadingFileCount"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/ts_16sp"
                android:gravity="center_horizontal"
                android:id="@+id/tvUserHintMessage"
                android:paddingBottom="@dimen/aya_72dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="@string/add_your_answers_for_this_test_here"
                android:layout_marginStart="@dimen/ayp_16dp"
                android:layout_marginEnd="@dimen/ayp_16dp"
                app:layout_constraintBottom_toTopOf="@+id/rvAttachmentList"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/viewSeparator"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAttachmentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvUserHintMessage"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:id="@+id/addFiles"
                android:background="@drawable/ic_dotted_blue_rectangle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/ayp_16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="48dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rvAttachmentList">
                <TextView
                    android:textSize="@dimen/ts_16sp"
                    android:textColor="#009ae0"
                    android:id="@+id/add_button"
                    android:padding="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_file_s"
                    android:drawablePadding="10dp"
                    app:drawableStartCompat="@drawable/ic_add_blue_circle_outline"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:id="@+id/disableAddFiles"
                android:background="@drawable/ic_dotted_grey_rect"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/ayp_16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rvAttachmentList">
                <TextView
                    android:textSize="@dimen/ts_16sp"
                    android:textColor="@color/gray_light"
                    android:id="@+id/disable_add_button"
                    android:padding="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_file_s"
                    android:drawablePadding="10dp"
                    android:drawableStart="@drawable/ic_add_grey_circle_button"
                    app:layout_constraintBottom_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="parent"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llBtnDone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/b_done"
            android:background="@drawable/rounded_corner_bg"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="12dp"
            android:text="@string/preview_amp_submit"
            android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
