<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/aya_24dp"
        android:layout_marginRight="@dimen/aya_24dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ayp_16dp"
            android:layout_marginBottom="@dimen/ayp_16dp">
            <TextView
                android:id="@+id/tv_overview_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/class_details"
                style="@style/BaseTextAppearance.HeavyWeightTitle"/>
            <ImageView
                android:id="@+id/iv_close"
                android:padding="@dimen/ayp_8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="@color/color_DE000000"
                app:srcCompat="@drawable/ic_close_cross"/>
        </LinearLayout>
        <View
            android:background="@color/grayE5"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="@dimen/aya_24dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="top"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="4dp"
                app:srcCompat="@drawable/ic_topic"/>
            <TextView
                android:id="@+id/tv_topic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ayp_16dp"
                android:maxLines="2"
                android:layout_marginStart="@dimen/ayp_16dp"
                style="@style/BaseTextAppearance.ShadowTitle"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/submit_your_feedback"
                style="@style/BaseTextAppearance.ShadowTitle"/>
            <RatingBar
                android:theme="@style/RatingBar"
                android:id="@+id/rating_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:numStars="5"
                android:stepSize="1"
                android:soundEffectsEnabled="true"/>
            <RelativeLayout
                android:id="@+id/ll_feedback_doubt"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_doubt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ayp_8dp"
                    android:text="@string/layout_student_feedback_tv_doubt_text"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentStart="true"
                    style="@style/BaseTextAppearance.ShadowTitle"/>
                <EditText
                    android:textSize="14sp"
                    android:gravity="center"
                    android:id="@+id/et_feedback"
                    android:background="@drawable/rectangle_4"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="@string/layout_student_feedback_et_feedback_hint"
                    android:maxLines="2"
                    android:layout_below="@+id/tv_doubt"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="@color/grayE5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/aya_24dp"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="18sp"
        android:textColor="@color/white"
        android:id="@+id/b_done"
        android:background="@drawable/bg_button_click_color_primary_alpha"
        android:paddingLeft="20dp"
        android:paddingTop="15dp"
        android:paddingRight="20dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ayp_16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="@dimen/ayp_16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/layout_student_feedback_b_done_text"
        android:textAllCaps="false"/>
</LinearLayout>
