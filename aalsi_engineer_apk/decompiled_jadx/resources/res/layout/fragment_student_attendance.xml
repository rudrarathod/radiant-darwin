<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/grayF1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.appbar.AppBarLayout
                android:background="@color/grayF1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_scrollFlags="enterAlwaysCollapsed|scroll">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <androidx.cardview.widget.CardView
                            android:gravity="center"
                            android:id="@+id/cv_date_picker"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginLeft="8dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginRight="8dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="@dimen/ayp_4dp"
                            app:cardElevation="@dimen/ayp_4dp">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:background="@color/white"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <ImageView
                                    android:id="@+id/calendar_image"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginLeft="20dp"
                                    android:layout_marginStart="20dp"
                                    app:srcCompat="@drawable/ic_calendar"/>
                                <TextView
                                    android:textSize="16sp"
                                    android:textColor="@color/black"
                                    android:id="@+id/tv_date"
                                    android:layout_width="0dp"
                                    android:layout_height="20dp"
                                    android:layout_marginLeft="14dp"
                                    android:text=""
                                    android:layout_weight="1"
                                    android:layout_marginStart="14dp"/>
                                <ImageView
                                    android:id="@+id/date_left_arrow"
                                    android:paddingLeft="@dimen/ayp_12dp"
                                    android:paddingRight="@dimen/ayp_12dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginLeft="12dp"
                                    android:layout_marginRight="12dp"
                                    android:tint="@color/color_666666"
                                    app:srcCompat="@drawable/ic_chevron_left"/>
                                <ImageView
                                    android:id="@+id/date_right_arrow"
                                    android:paddingLeft="@dimen/ayp_12dp"
                                    android:paddingRight="@dimen/ayp_12dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginLeft="12dp"
                                    android:layout_marginRight="12dp"
                                    android:tint="@color/grayE5"
                                    app:srcCompat="@drawable/ic_chevron_right"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/ll_attendance_data_present"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/ayp_16dp">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/rl_attendance_overview"
                                android:background="@color/white"
                                android:padding="16dp"
                                android:paddingTop="10dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <com.github.mikephil.charting.charts.PieChart
                                    android:id="@+id/pc_attendance"
                                    android:layout_width="106dp"
                                    android:layout_height="106dp"
                                    android:layout_marginLeft="2dp"
                                    android:layout_marginRight="2dp"/>
                                <View
                                    android:id="@+id/view_center_line"
                                    android:background="@color/grayE5"
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginLeft="32dp"
                                    android:layout_marginRight="32dp"/>
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:weightSum="1"
                                    android:layout_toRightOf="@+id/view_center_line"
                                    android:layout_toEndOf="@+id/view_center_line">
                                    <View
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0"/>
                                    <LinearLayout
                                        android:orientation="vertical"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1">
                                        <TextView
                                            android:textSize="14sp"
                                            android:textColor="@color/color_DE000000"
                                            android:id="@+id/attendance_text"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="@dimen/aya_24dp"
                                            android:text="@string/fragment_student_attendance_attendance_text_text"/>
                                        <LinearLayout
                                            android:orientation="horizontal"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content">
                                            <TextView
                                                android:textSize="14sp"
                                                android:textColor="@color/colorSecondaryText"
                                                android:gravity="center_vertical"
                                                android:id="@+id/tv_classesatt"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="@string/fragment_student_attendance_tv_classesatt_text"/>
                                            <TextView
                                                android:textColor="@color/black"
                                                android:id="@+id/tv_num_classes_attended"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"/>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:orientation="horizontal"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content">
                                            <TextView
                                                android:textSize="14sp"
                                                android:textColor="@color/colorSecondaryText"
                                                android:gravity="center_vertical"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="5dp"
                                                android:text="@string/total_classes"/>
                                            <TextView
                                                android:textColor="@color/black"
                                                android:id="@+id/tv_num_total_classes"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="5dp"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                            <View
                                android:background="@color/grayE5"
                                android:layout_width="wrap_content"
                                android:layout_height="1dp"/>
                            <LinearLayout
                                android:orientation="vertical"
                                android:background="@color/white"
                                android:padding="@dimen/ayp_16dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:id="@+id/ll_this_month_attendance"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="@dimen/ayp_8dp">
                                    <TextView
                                        android:id="@+id/ll_this_month"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        style="@style/BaseTextAppearance.SubTitle"/>
                                    <TextView
                                        android:id="@+id/tv_this_month_attendance_ratio"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        style="@style/BaseTextAppearance.SubTitle"/>
                                </LinearLayout>
                                <ProgressBar
                                    android:id="@+id/pb_this_month_attendance"
                                    android:layout_width="match_parent"
                                    android:layout_height="8dp"
                                    android:max="100"
                                    android:progressDrawable="@drawable/drawable_view_progress_batch"
                                    app:srcCompat="@drawable/drawable_view_progress_batch"
                                    style="@android:style/Widget.Holo.Light.ProgressBar.Horizontal"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.appbar.CollapsingToolbarLayout>
            </com.google.android.material.appbar.AppBarLayout>
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_refresh_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_attendance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"/>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_no_data"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_attendance_empty"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/colorPrimaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/no_attendance_data"/>
        </LinearLayout>
        <include
            android:visibility="gone"
            layout="@layout/common_progressbar"/>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
