<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="@dimen/_20sdp">
    <androidx.core.widget.NestedScrollView
        android:scrollbarSize="2dp"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ivOptionMenu"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:layout_margin="@dimen/_16sdp"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/app_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tvOptionMenuName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_16sdp"
                android:text="@string/request_a_call_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/nunito_sans_bold_18"/>
            <View
                android:id="@+id/view3"
                android:background="@color/color_7D8592"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvOptionMenuName"/>
            <TextView
                android:id="@+id/tvNamasteTeacher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_16sdp"
                android:text="@string/live_namaste_teacher"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view3"
                style="@style/nunito_sans_bold_16"/>
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_16sdp"
                android:text="@string/request_call_back_description"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvNamasteTeacher"
                style="@style/nunito_sans_medium_14"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_enter_no"
                android:background="@drawable/shape_rectangle_filled_white_outline_gray_r16"
                android:paddingLeft="10dp"
                android:paddingTop="3dp"
                android:paddingRight="10dp"
                android:paddingBottom="3dp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_48sdp"
                android:layout_margin="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDescription">
                <TextView
                    android:textColor="@color/colorText"
                    android:gravity="center"
                    android:id="@+id/tv_cc_initial"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/india_code"
                    style="@style/nunito_sans_regular_16_black"/>
                <View
                    android:id="@+id/divider"
                    android:background="@color/divider"
                    android:layout_width="1dp"
                    android:layout_height="38dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:layout_marginStart="10dp"/>
                <EditText
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/et_mobile"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_mobile_number_hint"
                    android:lines="1"
                    android:layout_marginStart="10dp"
                    style="@style/nunito_sans_regular_16_black"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/faculty_text"
                android:id="@+id/tv_error_info"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="@string/wrong_otp"
                android:layout_marginStart="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/ll_enter_no"
                app:layout_constraintTop_toBottomOf="@+id/ll_enter_no"
                style="@style/nunito_sans_regular_16_red"/>
            <TextView
                android:gravity="center"
                android:id="@+id/bRequestCallBack"
                android:background="@drawable/right_less_rounded_corners"
                android:layout_width="0dp"
                android:layout_height="@dimen/_37sdp"
                android:layout_margin="@dimen/_16sdp"
                android:text="@string/request_call_back"
                android:drawablePadding="@dimen/_8sdp"
                app:drawableEndCompat="@drawable/ic_new_menu_option_call"
                app:drawableTint="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_enter_no"
                style="@style/nunito_sans_semi_bold_16_white"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.cardview.widget.CardView>
