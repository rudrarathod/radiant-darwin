<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_zoom_live_new"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp">
    <LinearLayout
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_thumbnail_zoom"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:srcCompat="@drawable/ic_go_live"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_DE000000"
            android:id="@+id/tv_zoom_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_zoom_in_course_msg"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <View
        android:background="@color/grayE5"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/colorPrimary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_start_zoom"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/start_class"
        android:textAllCaps="false"/>
</LinearLayout>
