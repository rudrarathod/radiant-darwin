<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clLiveSessionPollsParent"
    android:background="@drawable/shape_rectangle_filled_color_white_r16"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="@dimen/_25sdp"
        android:layout_height="@dimen/_25sdp"
        android:layout_margin="@dimen/_12sdp"
        android:src="@drawable/ic_new_close"
        android:contentDescription="@string/app_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvOptionMenuName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_14sdp"
        android:text="@string/poll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/nunito_sans_semi_bold_sub_large_18_black"/>
    <View
        android:id="@+id/view3"
        android:background="@color/separator_grey"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/_16sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvOptionMenuName"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/noPoll"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_16sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view3">
        <ImageView
            android:id="@+id/ivEmptyPolls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_16sdp"
            android:src="@drawable/ic_new_poll_illustration"
            android:contentDescription="@string/app_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_16sdp"
            android:layout_marginTop="43dp"
            android:text="@string/your_educator_has_not_createdany_poll"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivEmptyPolls"
            style="@style/nunito_sans_semi_bold_12_black"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/llTimerPortrait"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view3">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint_layout"
            android:paddingTop="@dimen/ayp_16dp"
            android:paddingBottom="@dimen/ayp_16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/title_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/please_select_your_answer"
                android:lineSpacingExtra="7sp"
                android:layout_marginStart="@dimen/_14sdp"
                app:layout_constraintEnd_toStartOf="@+id/close_iv"
                app:layout_constraintStart_toStartOf="@+id/left_guide"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/nunito_sans_semi_bold_sub_medium_text_16"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/close_iv"
                android:background="?android:attr/selectableItemBackground"
                android:padding="@dimen/_16sdp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/timer_tv"
                app:layout_constraintEnd_toEndOf="@+id/right_guide"
                app:layout_constraintStart_toEndOf="@+id/title_tv"
                app:layout_constraintTop_toTopOf="@+id/title_tv"
                app:srcCompat="@drawable/ic_poll_down"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/question_tv"
                android:background="@drawable/shape_rectangle_filled_white_outline_black_r16"
                android:padding="@dimen/_10sdp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:lineSpacingExtra="7sp"
                app:layout_constraintEnd_toEndOf="@+id/right_guide"
                app:layout_constraintStart_toStartOf="@+id/left_guide"
                app:layout_constraintTop_toBottomOf="@+id/title_tv"
                style="@style/nunito_sans_semi_bold_sub_medium_text_16"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="vertical"
                android:id="@+id/option_rv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginEnd="@dimen/_16sdp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/question_tv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/timer_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_12sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/close_iv"
                app:layout_constraintStart_toStartOf="@+id/left_guide"
                app:layout_constraintTop_toBottomOf="@+id/option_rv"
                style="@style/nunito_sans_regular_14_green"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/max_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="option_rv,divider,question_tv"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/left_guide"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:layout_constraintGuide_begin="@dimen/_1sdp"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/right_guide"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:layout_constraintGuide_percent="0.9611"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llTimerPortrait"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/llCorrectAnswers"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:id="@+id/bottomView1"
            android:background="@color/separator_grey"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:id="@+id/tvTimerPortrait"
            android:background="@color/white"
            android:padding="@dimen/_16sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/nunito_sans_regular_14_black"/>
        <View
            android:id="@+id/bottomView2"
            android:background="@color/separator_grey"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llCorrectAnswers"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        app:layout_constraintBottom_toTopOf="@+id/llWrongAnswers"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:id="@+id/labelCorrectAnswers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/no_of_correct_answers"
            android:layout_weight="1"
            style="@style/nunito_sans_regular_14_black"/>
        <TextView
            android:textColor="@color/color_32A22A"
            android:id="@+id/valueCorrectAnswers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/nunito_sans_semi_bold_14_black"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llWrongAnswers"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        app:layout_constraintBottom_toTopOf="@+id/llQuesAttempted"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:id="@+id/labelWrongAnswers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/no_of_wrong_answers"
            android:layout_weight="1"
            style="@style/nunito_sans_regular_14_black"/>
        <TextView
            android:textColor="@color/color_F65160"
            android:id="@+id/valueWrongAnswers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/nunito_sans_semi_bold_14_black"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llQuesAttempted"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:id="@+id/labelQuesAttempted"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/no_of_question_unattempted"
            android:layout_weight="1"
            style="@style/nunito_sans_regular_14_black"/>
        <TextView
            android:textColor="@color/color_7D8592"
            android:id="@+id/valueQuesAttempted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/nunito_sans_semi_bold_14_black"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
