<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_course_bundle_tutor"
    android:background="@color/white"
    android:paddingTop="@dimen/_14sdp"
    android:paddingBottom="@dimen/_14sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/_14sdp">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_DE000000"
        android:id="@+id/tv_course_bundle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/included_in_this_bundle"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/_14sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_course_bundle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginStart="@dimen/_14sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_course_bundle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
