<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/trans_grad"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/exo_setting"
        android:padding="5dp"
        android:layout_width="35dp"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:tint="@color/white"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:tintMode="src_in"
        app:srcCompat="@drawable/ic_settings"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/exo_rew"
                android:layout_width="0dp"
                android:tint="@color/white"
                android:layout_weight="1"
                android:tintMode="src_in"
                style="@style/ExoMediaButton.Rewind"/>
            <ImageButton
                android:id="@+id/exo_play_pause"
                android:layout_width="0dp"
                android:tint="@color/white"
                android:layout_weight="1"
                android:tintMode="src_in"
                style="@style/ExoMediaButton.Play"/>
            <ImageButton
                android:id="@+id/exo_ffwd"
                android:layout_width="0dp"
                android:tint="@color/white"
                android:layout_weight="1"
                android:tintMode="src_in"
                style="@style/ExoMediaButton.FastForward"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/exo_quality"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:tint="@color/white"
                android:layout_weight="1"
                android:tintMode="src_in"
                app:srcCompat="@drawable/ic_high_quality"/>
            <ImageView
                android:id="@+id/exo_fulscreen"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/exo_icon_fullscreen_enter"
                android:tint="@color/white"
                android:layout_weight="1"
                android:tintMode="src_in"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="start"
                android:id="@+id/exo_position"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="end"
                android:id="@+id/exo_duration"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
        </LinearLayout>
        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            app:played_color="@color/colorPrimary"
            app:scrubber_color="@color/colorPrimaryDark"
            app:unplayed_color="@color/colorSecondaryText"/>
    </LinearLayout>
</RelativeLayout>
