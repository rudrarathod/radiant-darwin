<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="20dp">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:id="@+id/tv_heading_with_tips"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:maxLines="2"
        app:autoSizeTextType="uniform"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:id="@+id/tv_tip1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/ic_orange_point"
        app:layout_constraintLeft_toLeftOf="@+id/tv_heading_with_tips"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_heading_with_tips"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:id="@+id/tv_tip2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/ic_orange_point"
        app:layout_constraintLeft_toLeftOf="@+id/tv_heading_with_tips"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:id="@+id/tv_tip3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/ic_orange_point"
        app:layout_constraintLeft_toLeftOf="@+id/tv_heading_with_tips"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip2"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:id="@+id/tv_tip4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/ic_orange_point"
        app:layout_constraintLeft_toLeftOf="@+id/tv_heading_with_tips"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip3"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:id="@+id/tv_orgName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_whatsapp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/ll_whatsapp"
        android:background="@drawable/bg_btn_whatsapp"
        android:paddingLeft="20dp"
        android:paddingTop="5dp"
        android:paddingRight="20dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">
        <TextView
            android:textSize="14sp"
            android:textColor="#1bb11e"
            android:id="@+id/tv_whatsapp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:drawableStart="@drawable/ic_whatsapp_green"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
