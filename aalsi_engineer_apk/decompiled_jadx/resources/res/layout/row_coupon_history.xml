<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/item_coupon_history"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="120dp">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="50dp"
        android:layout_height="match_parent">
        <View
            android:id="@+id/upper_line"
            android:background="@color/gray91"
            android:layout_width="1dp"
            android:layout_height="15dp"/>
        <View
            android:id="@+id/view_circle"
            android:background="@drawable/shape_circle_color_primary"
            android:layout_width="15dp"
            android:layout_height="15dp"/>
        <View
            android:id="@+id/lower_line"
            android:background="@color/gray91"
            android:layout_width="1dp"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/black"
            android:gravity="bottom"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:id="@+id/textDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ayp_8dp"
            android:maxLines="2"/>
        <TextView
            android:textSize="15sp"
            android:gravity="top"
            android:id="@+id/updated_At"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ayp_8dp"/>
    </LinearLayout>
</LinearLayout>
