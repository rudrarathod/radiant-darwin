<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/shape_rectangle_filled_white_r7"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_weight="3">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_student_image"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="2dp"
        android:src="@mipmap/ic_launcher"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="5dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:layout_weight="2">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:id="@+id/tv_student_name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="2"/>
        <LinearLayout
            android:orientation="horizontal"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/black"
                android:id="@+id/tv_marks"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.25"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/black"
                android:id="@+id/tv_time_taken"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/black"
                android:id="@+id/tv_percentile"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.25"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/black"
        android:gravity="center_vertical"
        android:id="@+id/tv_hrank"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"/>
    <ImageView
        android:gravity="center_vertical"
        android:id="@+id/iv_rank"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        app:srcCompat="@drawable/ic_leaderboard_first"/>
</LinearLayout>
