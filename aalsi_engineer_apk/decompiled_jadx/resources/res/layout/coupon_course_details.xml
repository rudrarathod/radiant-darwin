<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/coupons_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@drawable/bg_primary_color_gradient"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="end"
        android:id="@+id/editList"
        android:padding="@dimen/ayp_16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/edit"
        android:textAllCaps="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/button_container"
        android:layout_below="@+id/toolbar">
        <LinearLayout
            android:gravity="start"
            android:orientation="horizontal"
            android:id="@+id/layout_search"
            android:background="@drawable/shape_rectangle_filled_white_radius_2"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="@dimen/ayp_8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="@dimen/ayp_8dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/iv_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_search"
                app:tint="@color/colorSecondaryTextAlpha"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="14sp"
                android:textColorHint="@color/colorSecondaryText"
                android:gravity="start|center_vertical"
                android:layout_gravity="center"
                android:id="@+id/et_search"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/search_courses_here"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_course_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ayp_16dp"
                android:layout_marginTop="@dimen/ayp_8dp"
                android:layout_marginRight="@dimen/ayp_16dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:background="@drawable/coupon_coursedetailsbluebackground"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/all_the_courses_which_satisfy_the_minimum_criteria_will_automatically_be_added_to_the_eligible_list"
                    android:textAlignment="center"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/gray66"
                android:id="@+id/title_eligible"
                android:paddingTop="@dimen/ayp_8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/eligible_courses"
                android:textAllCaps="true"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_courseSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:paddingLeft="@dimen/ayp_16dp"
                android:paddingRight="@dimen/ayp_16dp"
                android:paddingBottom="@dimen/ayp_16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorText_Black_Alpha_99"
                    android:paddingTop="@dimen/ayp_16dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/select_courses_caps"
                    android:layout_weight="1"
                    android:textAllCaps="true"/>
                <RelativeLayout
                    android:layout_gravity="bottom"
                    android:layout_width="25dp"
                    android:layout_height="25dp">
                    <ImageView
                        android:id="@+id/iv_filter"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:tint="@color/colorSecondaryText"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="3dp"
                        android:layout_alignParentEnd="true"
                        app:srcCompat="@drawable/ic_filter_outline"/>
                    <View
                        android:id="@+id/dot_view"
                        android:background="@drawable/shape_circle_filled_red"
                        android:visibility="gone"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginBottom="12dp"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:backgroundTint="@color/present_green"/>
                </RelativeLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorText_Black_Alpha_99"
                    android:id="@+id/tvFilter"
                    android:paddingTop="@dimen/ayp_8dp"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coupon_course_details_tvFilter_text"
                    android:paddingStart="6dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/white"
                android:paddingTop="@dimen/ayp_8dp"
                android:paddingBottom="@dimen/ayp_8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/ayp_16dp"
                android:paddingEnd="8dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/gray66"
                    android:id="@+id/selectedCourses"
                    android:paddingTop="@dimen/ayp_8dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/all_courses"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/link"
                    android:id="@+id/selectDeselectCourses"
                    android:paddingTop="@dimen/ayp_8dp"
                    android:paddingBottom="@dimen/ayp_8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_all"
                    android:textAllCaps="false"
                    android:paddingStart="2dp"
                    android:paddingEnd="@dimen/ayp_8dp"/>
            </LinearLayout>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCourses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"/>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardElevation="10dp">
        <Button
            android:textSize="18sp"
            android:textColor="@color/white"
            android:id="@+id/button"
            android:background="@drawable/bg_button_click_color_primary"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/finish"
            android:textAllCaps="false"/>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_no_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="80dp">
        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/store_no_course"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/colorPrimaryText"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="@string/no_course_found"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/colorSecondaryText"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_courses_found_to_display"/>
    </LinearLayout>
</RelativeLayout>
