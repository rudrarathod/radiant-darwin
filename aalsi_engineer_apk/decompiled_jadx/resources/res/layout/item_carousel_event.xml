<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="5dp"
    app:cardElevation="2dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/ayp_16dp"
        android:layout_marginRight="4dp"
        android:layout_marginEnd="4dp">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_282828"
                android:ellipsize="end"
                android:id="@+id/tvHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:maxEms="8"
                android:scrollHorizontally="true"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <RelativeLayout
                android:gravity="center_vertical"
                android:id="@+id/labels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true">
                <LinearLayout
                    android:layout_gravity="end"
                    android:id="@+id/ll_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/ayp_16dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ayp_16dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/color_666666"
                        android:gravity="end"
                        android:layout_gravity="center"
                        android:id="@+id/tvStatus"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_threedots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_toRightOf="@+id/ll_status"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp">
                    <ImageView
                        android:id="@+id/imgThreeDots"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:srcCompat="@drawable/ic_overflow_menu"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorText_Black_Alpha_99"
            android:ellipsize="end"
            android:id="@+id/subHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:maxEms="15"
            android:scrollHorizontally="true"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/color_online_test_text_color"
            android:id="@+id/tvEmblem"
            android:paddingLeft="16dp"
            android:paddingTop="5dp"
            android:paddingRight="16dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ayp_8dp"
            android:layout_marginBottom="@dimen/ayp_8dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_Date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ayp_8dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/imgFootericon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:scaleType="fitXY"
                android:tint="@color/color_777777"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_DE000000"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/tvTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="9dp"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="9dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
