<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ayp_16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="@dimen/ayp_16dp"
        app:cardCornerRadius="4dp"
        app:cardElevation="2dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ayp_16dp"
            android:layout_marginRight="16dp"
            android:layout_marginStart="@dimen/ayp_16dp"
            android:layout_marginEnd="16dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:ellipsize="end"
                    android:id="@+id/tv_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:maxEms="14"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/tvEmblem1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/assignment_emblem"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:id="@+id/tvEmblem2"
                    android:paddingLeft="8dp"
                    android:paddingTop="5dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ayp_8dp"
                    android:layout_marginRight="@dimen/ayp_8dp"
                    android:textAllCaps="true"
                    app:srcCompat="@drawable/assignment_emblem"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/tv_subheading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="1"/>
            </LinearLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_16dp"
                android:layout_marginBottom="@dimen/ayp_16dp">
                <RelativeLayout
                    android:id="@+id/ll_deadline_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:textSize="16sp"
                        android:layout_gravity=""
                        android:id="@+id/image"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:tint="@color/gray66"/>
                    <TextView
                        android:textSize="@dimen/ayp_12sp"
                        android:textColor="@color/gray66"
                        android:id="@+id/tv_dateTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_toRightOf="@+id/image"
                        android:layout_marginStart="10dp"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/ll_deadline_start"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:textSize="16sp"
                        android:id="@+id/image2"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:tint="@color/gray66"
                        android:layout_toLeftOf="@+id/tv_heading2"
                        android:layout_toStartOf="@+id/tv_heading2"/>
                    <TextView
                        android:textSize="@dimen/ayp_12sp"
                        android:textColor="@color/gray66"
                        android:id="@+id/tv_heading2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_alignParentRight="true"
                        android:layout_marginStart="10dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.appcompat.widget.LinearLayoutCompat>
