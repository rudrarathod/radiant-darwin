<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="35dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/black"
        android:id="@+id/shareText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="@string/upload_que_paper"
        android:layout_marginStart="25dp"
        app:layout_constraintBottom_toTopOf="@+id/viewDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toTopOf="@+id/viewDivider"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_close"/>
    <View
        android:id="@+id/viewDivider"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:alpha="0.1"
        app:layout_constraintTop_toBottomOf="@+id/shareText"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/info_layout"
        android:background="@drawable/shape_rectangle_filled_white_outline_gray_r6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewDivider">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black"
            android:id="@+id/tvAddImageInfo"
            android:background="#fff1dc"
            android:paddingTop="20dp"
            android:paddingBottom="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_image_pdf"
            android:drawablePadding="25dp"
            android:lineSpacingExtra="4sp"
            android:drawableStart="@drawable/ic_add_pdf_image"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <TextView
            android:textSize="12sp"
            android:id="@+id/tv_FilesCountInfo"
            android:background="#fffbf5"
            android:paddingTop="20dp"
            android:paddingBottom="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/you_can_add_upto"
            android:drawablePadding="25dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/black"
        android:id="@+id/take_pictures"
        android:paddingLeft="25dp"
        android:paddingTop="26dp"
        android:paddingBottom="19dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/take_picture"
        android:drawablePadding="18dp"
        android:drawableStart="@drawable/ic_camera_pic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/info_layout"/>
    <View
        android:id="@+id/viewDivider1"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.1"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@+id/take_pictures"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/black"
        android:id="@+id/upload_pdfs"
        android:paddingLeft="25dp"
        android:paddingTop="26dp"
        android:paddingBottom="19dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/upload_pdfs"
        android:drawablePadding="18dp"
        android:drawableStart="@drawable/ic_file"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewDivider1"/>
    <View
        android:id="@+id/viewDivider2"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.1"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@+id/upload_pdfs"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/black"
        android:id="@+id/add_images"
        android:paddingLeft="25dp"
        android:paddingTop="26dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_image"
        android:drawablePadding="18dp"
        android:drawableStart="@drawable/ic_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewDivider2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
