<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#f1f1f1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="40dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_emptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/empty_imageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_black_87_opacity"
                android:layout_gravity="center_horizontal"
                android:id="@+id/empty_title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="@dimen/ayp_16dp"
                android:layout_marginRight="40dp"
                android:singleLine="false"
                android:lineSpacingExtra="3sp"
                android:inputType="textMultiLine"
                android:textAlignment="center"/>
            <TextView
                android:textAppearance="@style/empty_subhead"
                android:gravity="top|center_horizontal"
                android:id="@+id/empty_subtitle_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/student_courses_empty_subheading"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:lineSpacingExtra="4sp"
                android:alpha="0.6"
                android:translationY="-2.15sp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
