<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/feed"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/ayp_8dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="start|center_vertical"
                android:layout_gravity="center"
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                style="@style/BaseTextAppearance.Title"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/ll_red_dot"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/ayp_8dp"
                android:layout_toLeftOf="@+id/tv_absent"
                android:layout_toRightOf="@+id/tv_date">
                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:src="@drawable/shape_circle_filled_red"/>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ayp_4dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_weight="1">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_topic"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/tv_topic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        style="@style/BaseTextAppearance.SubTitle"/>
                    <TextView
                        android:id="@+id/tv_by_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="@string/row_student_attendance_history_tv_by_label_text"
                        android:layout_marginStart="5dp"
                        style="@style/BaseTextAppearance.SubTitle"/>
                    <TextView
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/tv_faculty_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:maxLines="1"
                        android:layout_marginStart="5dp"
                        style="@style/BaseTextAppearance.SubTitle"/>
                </LinearLayout>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#cd3649"
                    android:gravity="center"
                    android:id="@+id/tv_absent"
                    android:background="@drawable/shape_rectangle_filled_absent_red"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="65dp"
                    android:layout_height="wrap_content"
                    android:text="@string/row_student_attendance_history_tv_absent_text"
                    android:textAllCaps="true"/>
            </LinearLayout>
            <ImageView
                android:layout_gravity="end"
                android:id="@+id/iv_feedback_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="@color/colorSecondaryText"
                app:srcCompat="@drawable/ic_chevron_down"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="right"
            android:orientation="horizontal"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:tint="@color/colorSecondaryText"
                app:srcCompat="@drawable/ic_clock_time_blue"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#99000000"
                android:id="@+id/tv_class_start_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ayp_8dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#99000000"
                android:id="@+id/tv_feedback_rating"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
