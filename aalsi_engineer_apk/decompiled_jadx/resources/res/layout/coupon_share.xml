<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#e5e5e5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@drawable/bg_primary_color_gradient"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:minHeight="?attr/actionBarSize"
            android:layout_alignParentTop="true"
            app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/buttonll"
            android:background="@color/white"
            android:padding="@dimen/ayp_12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="54dp"
            android:layout_alignParentBottom="true">
            <Button
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:layout_gravity="center"
                android:id="@+id/button"
                android:background="@drawable/bg_primary_color_gradient"
                android:padding="@dimen/ayp_16dp"
                android:layout_width="382dp"
                android:layout_height="wrap_content"
                android:text="@string/coupon_share_button_text"/>
        </RelativeLayout>
        <ScrollView
            android:background="#e5e5e5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:layout_above="@+id/buttonll"
            android:layout_below="@+id/toolbar">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/ayp_12sp"
                    android:textColor="@color/colorText_Black_Alpha_99"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/ayp_16dp"
                    android:layout_marginTop="@dimen/ayp_16dp"
                    android:layout_marginBottom="@dimen/ayp_8dp"
                    android:text="@string/text_recipients"
                    android:textAllCaps="true"
                    android:layout_marginStart="@dimen/ayp_16dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:textSize="12sp"
                        android:layout_gravity="center"
                        android:id="@+id/recipients"
                        android:background="@color/white"
                        android:padding="@dimen/ayp_16dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="@string/to"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:background="@drawable/coupon_check"
                        android:padding="@dimen/ayp_16dp"
                        android:visibility="visible"
                        android:layout_width="@dimen/ayp_16dp"
                        android:layout_height="@dimen/ayp_16dp"
                        android:layout_marginRight="@dimen/ayp_16dp"
                        android:layout_marginEnd="@dimen/ayp_16dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/ayp_12sp"
                    android:textColor="#ff4058"
                    android:id="@+id/couponCodeError"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/ayp_16dp"
                    android:layout_marginTop="@dimen/ayp_4dp"
                    android:text="@string/field_required"/>
                <TextView
                    android:textSize="@dimen/ayp_12sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/ayp_16dp"
                    android:layout_marginTop="@dimen/ayp_16dp"
                    android:layout_marginBottom="@dimen/ayp_8dp"
                    android:text="@string/title"
                    android:textAllCaps="true"
                    android:layout_marginStart="@dimen/ayp_16dp"/>
                <EditText
                    android:textSize="16sp"
                    android:layout_gravity="center"
                    android:id="@+id/editCodeMaximum"
                    android:background="@color/white"
                    android:padding="@dimen/ayp_16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/share_coupon_name"/>
                <TextView
                    android:textSize="@dimen/ayp_12sp"
                    android:textColor="#ff4058"
                    android:id="@+id/editCodeMaximumError"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/ayp_16dp"
                    android:layout_marginTop="@dimen/ayp_2dp"
                    android:text="@string/field_required"/>
                <TextView
                    android:textSize="@dimen/ayp_12sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/ayp_16dp"
                    android:layout_marginTop="@dimen/ayp_16dp"
                    android:layout_marginBottom="@dimen/ayp_8dp"
                    android:text="@string/text"
                    android:layout_marginStart="@dimen/ayp_16dp"/>
                <EditText
                    android:textSize="16sp"
                    android:id="@+id/editStudentMaximum"
                    android:background="@color/white"
                    android:padding="@dimen/ayp_16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/coupon_share_editStudentMaximum_text"
                    android:inputType="textMultiLine"/>
                <TextView
                    android:textSize="@dimen/ayp_12sp"
                    android:textColor="#ff4058"
                    android:id="@+id/editStudentMaximumError"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/ayp_16dp"
                    android:layout_marginTop="@dimen/ayp_4dp"
                    android:text="@string/field_required"/>
                <RelativeLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/rl_usage_per_student_checkbox"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <CheckBox
                        android:id="@+id/chk_per_student"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="2dp"
                        android:checked="false"
                        android:layout_marginStart="10dp"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:paddingTop="@dimen/ayp_4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/check_if_you_want_to_allow_usage_per_student_to_be_unlimited"
                        android:layout_toRightOf="@+id/chk_per_student"
                        android:layout_toEndOf="@+id/chk_per_student"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:padding="@dimen/ayp_16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <CheckBox
                        android:id="@+id/toggle"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:checked="true"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#de000000"
                        android:layout_gravity="center"
                        android:background="@color/white"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/send_sms"
                        android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</RelativeLayout>
