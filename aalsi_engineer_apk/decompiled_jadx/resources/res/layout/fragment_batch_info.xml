<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gray91"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_above="@+id/ll_btn_done">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/gray91"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tv_batch_name"
                android:paddingTop="24dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/sort_by_batch_name"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <EditText
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/et_batch_name"
                android:background="@color/white"
                android:paddingLeft="@dimen/ayp_16dp"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:hint="@string/fragment_batch_info_et_batch_name_hint"
                android:maxLines="1"
                android:maxLength="55"
                android:inputType="textCapSentences"
                android:imeOptions="actionNext"
                style="@style/BaseTextAppearance.Title"/>
            <TextView
                android:id="@+id/tv_batch_code"
                android:paddingTop="24dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/fragment_batch_info_tv_batch_code_text"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/white"
                android:paddingLeft="@dimen/ayp_16dp"
                android:paddingRight="@dimen/ayp_16dp"
                android:layout_width="match_parent"
                android:layout_height="46dp">
                <EditText
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/et_batch_code"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="@string/fragment_batch_info_et_batch_code_hint"
                    android:maxLines="1"
                    android:maxLength="15"
                    android:layout_weight="1"
                    android:inputType="text"
                    android:imeOptions="actionGo"
                    android:backgroundTint="@android:color/transparent"
                    style="@style/BaseTextAppearance.Title"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_tick"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_check_circle"/>
                <RelativeLayout
                    android:gravity="center"
                    android:id="@+id/rl_progress_bar"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <ProgressBar
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:progressBackgroundTint="@color/colorAccent"
                        style="?android:attr/progressBarStyleSmall"/>
                </RelativeLayout>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorSecondaryText"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/you_can_share_this_code_with_your_students_to_join_this_batch"/>
            <TextView
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/batch_start_date"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_batch_create_date"
                android:background="@color/white"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_batch_create_date"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:hint="@string/click_to_select_select"
                    android:maxLines="1"
                    android:layout_weight="1"
                    style="@style/BaseTextAppearance.Title"/>
                <TextView
                    android:textSize="@dimen/ayp_12sp"
                    android:textColor="@color/link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/change"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:paddingTop="20dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/category"
                    style="@style/BaseTextAppearance.UpperCaseTitle"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_select_category"
                    android:background="@color/white"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_select_category"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:text="@string/fragment_batch_info_tv_select_category_text"
                        android:maxLines="1"
                        android:layout_weight="1"
                        style="@style/BaseTextAppearance.Title"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/ic_chevron_right"
                        app:tint="@color/black"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_course"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:paddingTop="20dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/course"
                    style="@style/BaseTextAppearance.UpperCaseTitle"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_select_course"
                    android:background="@color/white"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_select_course"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="@string/fragment_batch_info_tv_select_course_text"
                        android:maxLines="1"
                        android:layout_weight="1"
                        style="@style/BaseTextAppearance.Title"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/ic_chevron_right"
                        app:tint="@color/black"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_subjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:paddingTop="20dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/subject_caps"
                    style="@style/BaseTextAppearance.UpperCaseTitle"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_select_subject"
                    android:background="@color/white"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="30dp">
                    <TextView
                        android:ellipsize="end"
                        android:id="@+id/tv_select_subject"
                        android:background="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fragment_batch_info_tv_select_subject_text"
                        android:maxLines="1"
                        android:layout_weight="1"
                        style="@style/BaseTextAppearance.Title"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/ic_chevron_right"
                        app:tint="@color/black"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_btn_done"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:elevation="8dp">
        <Button
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/b_done"
            android:background="@drawable/bg_button_click_color_primary"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/done"
            android:textAllCaps="false"/>
    </LinearLayout>
    <include
        android:id="@+id/layout_common_progressbar"
        android:visibility="gone"
        layout="@layout/common_progressbar"/>
</RelativeLayout>
