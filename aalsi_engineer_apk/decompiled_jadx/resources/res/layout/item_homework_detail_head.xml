<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_head"
    android:background="@color/white"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:id="@+id/tvHomeworkTopic"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="5"
        android:layout_marginEnd="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tvHomeworkStatus"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/colorText_Black_Alpha_99"
        android:id="@+id/tvHomeworkStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tvHomeworkTopic"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/colorText_Black_Alpha_99"
        android:id="@+id/tvHomeworkTutor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHomeworkTopic"/>
    <ImageView
        android:id="@+id/clock"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginTop="11dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHomeworkTutor"
        app:srcCompat="@drawable/ic_clock_time_colorsecondarytext"
        app:tint="@color/colorText_Black_Alpha_99"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/black"
        android:id="@+id/tvDeadline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/item_homework_detail_head_tvDeadline_text"
        android:layout_marginStart="5dp"
        app:layout_constraintStart_toEndOf="@+id/clock"
        app:layout_constraintTop_toBottomOf="@+id/tvHomeworkTutor"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/colorText_Black_Alpha_99"
        android:id="@+id/tvHomeworkDateTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="5dp"
        app:layout_constraintStart_toEndOf="@+id/tvDeadline"
        app:layout_constraintTop_toBottomOf="@+id/tvHomeworkTutor"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ayp_red"
        android:id="@+id/tvLateSubmission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/item_homework_detail_head_tvLateSubmission_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHomeworkDateTime"/>
</androidx.constraintlayout.widget.ConstraintLayout>
