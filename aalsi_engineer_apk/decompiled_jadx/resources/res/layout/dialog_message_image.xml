<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="10dp">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/ic_close_dialog"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:src="@drawable/ic_close"
        android:layout_marginEnd="@dimen/_8sdp"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_dialog_top"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#99000000"
            android:gravity="center_horizontal"
            android:id="@+id/tv_dialog_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#99000000"
            android:gravity="center"
            android:id="@+id/tv_dialog_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:drawablePadding="8dp"
            android:lineSpacingExtra="4sp"
            app:drawableTint="@color/color_FB8C00"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/ayp_red"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_no"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/royalblue"
                android:gravity="end"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_done"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
