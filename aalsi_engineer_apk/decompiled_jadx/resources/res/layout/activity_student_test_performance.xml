<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/gray91"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@drawable/bg_primary_color_gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_above="@+id/buttonsContainer"
        android:layout_below="@+id/toolbar"
        android:elevation="3dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:id="@+id/item_batch"
                layout="@layout/item_batch_test"/>
            <include
                android:id="@+id/cv_empty_done"
                android:visibility="gone"
                layout="@layout/layout_empty_done_test"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_label_result"
                    android:background="#14009ae0"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:id="@+id/tv_challenges"
                    android:paddingTop="16dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/challenges_caps"
                    android:textAllCaps="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="10dp"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/ll_challenges_card"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    app:cardCornerRadius="8dp">
                    <include
                        android:id="@+id/ll_challenges"
                        layout="@layout/layout_challenges_card"/>
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_done_test"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorSecondaryText"
                        android:id="@+id/tv_label_first_done"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/first_attempt"/>
                    <include
                        android:id="@+id/cv_first_attempt_done"
                        layout="@layout/layout_done_test"/>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_sections_done_first_attempt"
                        android:background="@color/white"
                        android:focusable="true"
                        android:visibility="gone"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="10dp"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardCornerRadius="8dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="10dp">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_marginRight="8dp">
                                <ImageView
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:tint="@color/colorSecondaryText"
                                    app:srcCompat="@drawable/ic_list"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/colorSecondaryText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginRight="10dp"
                                    android:text="@string/section_details"/>
                            </LinearLayout>
                            <View
                                android:background="@color/gray91"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="10dp"/>
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_sections_done_first_attempt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorSecondaryText"
                        android:id="@+id/tv_label_last_done"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/latest_attempt"/>
                    <include
                        android:id="@+id/cv_last_attempt_done"
                        layout="@layout/layout_latest_done_test"/>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_sections_done_last_attempt"
                        android:background="@color/white"
                        android:focusable="true"
                        android:visibility="gone"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="10dp"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardCornerRadius="8dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="10dp">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_marginRight="8dp">
                                <ImageView
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:tint="@color/colorSecondaryText"
                                    app:srcCompat="@drawable/ic_list"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/colorSecondaryText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginRight="10dp"
                                    android:text="@string/section_details"/>
                            </LinearLayout>
                            <View
                                android:background="@color/gray91"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="10dp"/>
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_sections_done_last_attempt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_ongoing_test"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorSecondaryText"
                        android:id="@+id/tv_label_first_ongoing"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/first_attempt"/>
                    <include
                        android:id="@+id/cv_first_attempt_ongoing"
                        layout="@layout/layout_ongoing_test"/>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_sections_ongoing_first_attempt"
                        android:background="@color/white"
                        android:focusable="true"
                        android:visibility="gone"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="10dp"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardCornerRadius="8dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="10dp">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_marginRight="8dp">
                                <ImageView
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:tint="@color/colorSecondaryText"
                                    app:srcCompat="@drawable/ic_list"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/colorSecondaryText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginRight="10dp"
                                    android:text="@string/section_details"/>
                            </LinearLayout>
                            <View
                                android:background="@color/gray91"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="10dp"/>
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_sections_ongoing_first_attempt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorSecondaryText"
                        android:id="@+id/tv_label_last_ongoing"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/latest_attempt"/>
                    <include
                        android:id="@+id/cv_last_attempt_ongoing"
                        layout="@layout/layout_ongoing_test"/>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_sections_ongoing_last_attempt"
                        android:background="@color/white"
                        android:focusable="true"
                        android:visibility="gone"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="10dp"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardCornerRadius="8dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="10dp">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_marginRight="8dp">
                                <ImageView
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:tint="@color/colorSecondaryText"
                                    app:srcCompat="@drawable/ic_list"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/colorSecondaryText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginRight="10dp"
                                    android:text="@string/section_details"/>
                            </LinearLayout>
                            <View
                                android:background="@color/gray91"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="10dp"/>
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_sections_ongoing_last_attempt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/llAttemptsLeft"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="@dimen/ayp_8dp"
                    android:layout_marginRight="10dp">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_margin="5dp"
                        android:tint="@color/red3"
                        app:srcCompat="@drawable/ic_store_bottom_caution"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/red3"
                        android:id="@+id/tvReattemptsLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/buttonsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:elevation="3dp">
        <RelativeLayout
            android:id="@+id/button_container"
            android:background="@color/white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:gravity="center"
                android:id="@+id/rl_button_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp">
                <ImageView
                    android:id="@+id/ivWinPoints"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    app:srcCompat="@drawable/ic_win_points"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:id="@+id/tvButtonPointsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_student_test_performance_tvButtonPointsText_text"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@+id/ivWinPoints"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/button_color"
                    android:id="@+id/tvHow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_student_test_performance_tvHow_text"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/tvButtonPointsText"/>
            </RelativeLayout>
            <Button
                android:textSize="16sp"
                android:textColor="@color/white"
                android:id="@+id/button"
                android:background="@drawable/bg_button_click_color_primary"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="10dp"
                android:text="@string/activity_student_test_performance_button_text"
                android:layout_below="@+id/rl_button_text"
                android:textAllCaps="false"/>
        </RelativeLayout>
        <include
            android:layout_gravity="bottom"
            android:id="@+id/layout_whatsapp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/layout_whatsapp_button"/>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/cvContent"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ayp_8dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTemplate"
            android:layout_width="240dp"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/bgImage"
                android:background="@drawable/bg_round_empty_gray"
                android:padding="1dp"
                android:layout_width="240dp"
                android:layout_height="240dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/white"
                android:id="@+id/tvTitle1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:text="@string/test_name"
                android:maxLines="1"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="@dimen/_32sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/tvTitle2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:maxLines="2"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="@dimen/_32sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle1"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/white"
                android:id="@+id/tvTitle3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:text="@string/my_score"
                android:maxLines="1"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="@dimen/_32sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle2"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/tvTitle4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:maxLines="2"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="@dimen/_32sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle3"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:id="@+id/tvMaxMarks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="1dp"
                android:maxLines="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="@dimen/_32sdp"
                app:layout_constraintBottom_toBottomOf="@+id/tvTitle4"
                app:layout_constraintStart_toEndOf="@+id/tvTitle4"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/white"
                android:id="@+id/tvTitle5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:text="@string/my_rank"
                android:maxLines="1"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="@dimen/_32sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle4"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/tvTitle6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:maxLines="2"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="@dimen/_32sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle5"/>
            <ImageView
                android:id="@+id/ivPhone"
                android:layout_width="64dp"
                android:layout_height="52dp"
                android:layout_marginBottom="1dp"
                android:src="@drawable/ic_phone_template_footer"
                android:scaleType="centerCrop"
                android:layout_marginStart="20dp"
                app:layout_constraintBottom_toBottomOf="@+id/bgImage"
                app:layout_constraintStart_toStartOf="@+id/bgImage"/>
            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_marginTop="14dp"
                android:scaleType="centerCrop"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/ivPhone"
                app:layout_constraintEnd_toEndOf="@+id/ivPhone"
                app:layout_constraintStart_toStartOf="@+id/ivPhone"
                app:layout_constraintTop_toTopOf="@+id/ivPhone"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/white"
                android:id="@+id/tvOrgName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_8dp"
                android:layout_marginBottom="@dimen/ayp_2dp"
                android:lineSpacingExtra="2dp"
                android:layout_marginStart="@dimen/ayp_4dp"
                app:layout_constraintBottom_toTopOf="@+id/tvFooterSubtitle"
                app:layout_constraintStart_toEndOf="@+id/ivPhone"/>
            <TextView
                android:textSize="8sp"
                android:textColor="@color/white"
                android:id="@+id/tvFooterSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ayp_2dp"
                android:lineSpacingExtra="1dp"
                android:layout_marginStart="@dimen/ayp_4dp"
                app:layout_constraintBottom_toTopOf="@+id/blankView2"
                app:layout_constraintStart_toEndOf="@+id/ivPhone"/>
            <View
                android:id="@+id/blankView2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/bgImage"
                app:layout_constraintEnd_toEndOf="@+id/bgImage"
                app:layout_constraintStart_toEndOf="@+id/ivPhone"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
