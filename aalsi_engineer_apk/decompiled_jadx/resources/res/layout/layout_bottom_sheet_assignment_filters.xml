<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/rl_header"
            android:paddingLeft="10dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="20dp">
            <ImageView
                android:id="@+id/iv_close"
                android:padding="5dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:tint="@color/colorSecondaryText"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ic_close_cross"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_282828"
                android:id="@+id/tv_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_toRightOf="@+id/iv_close"
                android:layout_centerVertical="true"
                android:textAllCaps="true"
                android:layout_marginStart="15dp"
                android:layout_toEndOf="@+id/iv_close"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="14sp"
                android:textColor="@color/colorAccent"
                android:id="@+id/tv_clear_all_button"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clear_all"
                android:layout_centerVertical="true"
                android:textAllCaps="true"
                android:layout_alignParentEnd="true"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_batches_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <View
                android:background="@color/gray79"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/batches_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_batches_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:textColor="@color/colorPrimary"
                        android:gravity="right"
                        android:id="@+id/tv_select_all"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_Batches"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="7dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorPrimary"
                    android:id="@+id/tv_view_more_less"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginBottom="16dp"
                    android:textAllCaps="true"
                    android:layout_marginStart="16dp"/>
                <View
                    android:background="@color/gray79"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/courses_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_Courses_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/layout_bottom_sheet_assignment_filters_tv_Courses_count_text"
                        android:layout_weight="1"/>
                    <TextView
                        android:textColor="@color/colorPrimary"
                        android:gravity="right"
                        android:id="@+id/tv_courses_select_all"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/select_all"
                        android:layout_weight="1"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_courses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorPrimary"
                    android:id="@+id/tv_courses_view_more_less"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="true"/>
            </LinearLayout>
            <View
                android:background="@color/gray79"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/testTypeHolder"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/test_type"/>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/onlinetest"
                android:paddingTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_onlinetest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_online_test"
                    android:layout_centerVertical="true"/>
                <CheckBox
                    android:enabled="true"
                    android:id="@+id/chk_onlinetest"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    style="@style/Widget.AppCompat.CompoundButton.CheckBox"/>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_recipient_parent"
                android:paddingTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_offlinetest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/class_test"
                    android:layout_centerVertical="true"/>
                <CheckBox
                    android:enabled="true"
                    android:id="@+id/chk_offlinetest"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    style="@style/Widget.AppCompat.CompoundButton.CheckBox"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/practiceTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="5dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_practiceTest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/practice_test"
                    android:layout_centerVertical="true"/>
                <CheckBox
                    android:enabled="true"
                    android:id="@+id/chk_practiceTest"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    style="@style/Widget.AppCompat.CompoundButton.CheckBox"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/subjectiveTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="5dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_subjectiveTest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subjective_test"
                    android:layout_centerVertical="true"/>
                <CheckBox
                    android:enabled="true"
                    android:id="@+id/chk_subjectiveTest"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    style="@style/Widget.AppCompat.CompoundButton.CheckBox"/>
            </RelativeLayout>
            <View
                android:background="@color/gray79"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_date"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/date_range"/>
            <RadioGroup
                android:id="@+id/rg_time_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="25dp">
                <RadioButton
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/radio_btn_one"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layoutDirection="rtl"/>
                <RadioButton
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/radio_btn_two"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layoutDirection="rtl"/>
                <RadioButton
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/radio_btn_1_month"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layoutDirection="rtl"/>
                <RadioButton
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/radio_btn_3_months"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layoutDirection="rtl"/>
                <RadioButton
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/radio_btn_three"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layoutDirection="rtl"/>
            </RadioGroup>
            <View
                android:background="@color/gray79"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
        </LinearLayout>
        <Button
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="start|bottom"
            android:id="@+id/btn_apply_payment_filter"
            android:background="@drawable/bg_button_click_color_primary"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="24dp"
            android:text="@string/apply"
            android:layout_alignParentBottom="true"
            android:textAllCaps="false"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
