<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/assignment_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@drawable/bg_primary_color_gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_above="@+id/ll_save_status"
        android:layout_below="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_details_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rl_student_card"
                android:background="@color/white"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_dp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@mipmap/ic_launcher"
                    android:layout_marginEnd="16dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:id="@+id/tv_student_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="20dp"
                    android:layout_toStartOf="@+id/tv_hw_status"
                    android:layout_toEndOf="@+id/iv_dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_hw_status"
                    android:background="@drawable/shape_rectangle_filled_white_outline_gray_r17"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:visibility="visible"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:text="@string/not_submitted"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_submitted_on"
                android:background="@color/white"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorText_Black_Alpha_99"
                    android:background="@color/white"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/submitted_on"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_submitted_on"
                    android:background="@color/white"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorText_Black_Alpha_99"
                android:id="@+id/tv_answer_heading"
                android:paddingTop="16dp"
                android:paddingBottom="11dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_student_hw_tv_answer_heading_text"
                android:textAllCaps="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorText_Black_Alpha_99"
                android:gravity="center"
                android:id="@+id/tv_no_attachments"
                android:background="@color/white"
                android:padding="15dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/not_submitted"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_answers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_answers"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/link"
                    android:id="@+id/tv_answers_view_more"
                    android:background="@color/white"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/view_more_non_caps"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/link"
                    android:id="@+id/tv_answers_view_less"
                    android:background="@color/white"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/view_less_non_caps"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_remind_submit"
                android:background="@color/white"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_reminder"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/button_color"
                    android:gravity="center"
                    android:background="@color/white"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remind_student"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llShowPending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="9dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorText_Black_Alpha_99"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_status"
                        android:textAllCaps="true"
                        android:paddingStart="16dp"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/iv_info"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        app:srcCompat="@drawable/information_circular_button_symbol__1_"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="3"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/tv_submitted"
                        android:background="@drawable/shape_rectangle_filled_white_outline_gray_r6"
                        android:paddingTop="12dp"
                        android:paddingBottom="@dimen/ayp_12dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:text="@string/submitted"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/tv_approved"
                        android:background="@drawable/shape_rectangle_filled_white_outline_gray_r6"
                        android:paddingTop="12dp"
                        android:paddingBottom="@dimen/ayp_12dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:text="@string/approved"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/tv_rejected"
                        android:background="@drawable/shape_rectangle_filled_white_outline_gray_r6"
                        android:paddingTop="12dp"
                        android:paddingBottom="@dimen/ayp_12dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:text="@string/rejected"
                        android:layout_weight="1"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/colorText_Black_Alpha_99"
                    android:paddingTop="16dp"
                    android:paddingBottom="9dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remarks"
                    android:textAllCaps="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <EditText
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:textColorHint="#66000000"
                        android:gravity="start|top"
                        android:id="@+id/et_remarks"
                        android:background="@null"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:scrollbars="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:hint="@string/activity_student_hw_et_remarks_hint"
                        android:maxLines="4"
                        android:imeOptions="actionGo"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_attach"
                    android:background="@color/white"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp">
                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ic_attachment_tilted"
                        android:tint="#777777"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/add_attachment_s"
                        android:layout_weight="1"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_attachments_docs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_attachments_photos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_attachments_audio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/colorText_Black_Alpha_99"
                    android:paddingTop="16dp"
                    android:paddingBottom="9dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sms_notif_caps"
                    android:textAllCaps="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
                <RelativeLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <CheckBox
                        android:enabled="false"
                        android:id="@+id/cb_notify"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:checked="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_notify_students"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_student_hw_tv_notify_students_text"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="8dp"
                        android:layout_toEndOf="@+id/cb_notify"/>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_save_status"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_save_status"
            android:background="@drawable/bg_rounded_grey"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/save_status"
            android:textAllCaps="false"/>
    </LinearLayout>
</RelativeLayout>
