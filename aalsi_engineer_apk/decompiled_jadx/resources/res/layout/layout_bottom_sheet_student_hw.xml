<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="#de000000"
            android:id="@+id/tv_option_header"
            android:paddingLeft="24dp"
            android:paddingTop="24dp"
            android:paddingRight="24dp"
            android:paddingBottom="24dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/assignment_status"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingEnd="28dp"
            app:srcCompat="@drawable/ic_close_cross_black"/>
    </LinearLayout>
    <View
        android:background="#e7e7e7"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">
        <TextView
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/tv_submitted"
            android:background="@drawable/shape_rectangle_filled_white_outline_gray_r17"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:visibility="visible"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:text="@string/submitted"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/DE000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_submitted"/>
        <View
            android:background="#e7e7e7"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/tv_approved"
            android:background="@drawable/shape_rectangle_filled_white_outline_gray_r17"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:visibility="visible"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/approved"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/DE000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_approved"/>
        <View
            android:background="#e7e7e7"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/tv_rejected"
            android:background="@drawable/shape_rectangle_filled_white_outline_gray_r17"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:visibility="visible"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/rejected"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/DE000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_rejected"/>
        <View
            android:background="#e7e7e7"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_info"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginTop="3dp"
                android:tint="@color/gray_dark"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:srcCompat="@drawable/information_circular_button_symbol__1_"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/gray_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_best_practice"
                android:layout_toEndOf="@+id/iv_info"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:background="#e7e7e7"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"/>
    <Button
        android:textSize="14sp"
        android:textColor="@color/button_color"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:background="@color/white"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/done_caps"
        android:textAllCaps="true"
        style="@style/Widget.MaterialComponents.Button.TextButton"/>
</LinearLayout>
