<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gray91"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/layout_search_container"
        android:background="@color/gray91"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentTop="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/layout_search"
            android:background="@drawable/shape_rectangle_filled_white_r7"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp">
            <androidx.appcompat.widget.SearchView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/search_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/colorSecondaryText"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_search"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/label_search"/>
        </LinearLayout>
    </LinearLayout>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout_video_store"
        android:background="@color/white"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/layout_search_container"
        app:tabIndicatorColor="@color/colorPrimary"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="@color/colorPrimaryText"
        app:tabTextColor="@color/colorSecondaryText"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/view_pager_video_store"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tab_layout_video_store"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_no_content"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/store_no_course"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/colorPrimaryText"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="@string/no_courses_added"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/colorSecondaryText"
            android:gravity="center"
            android:id="@+id/tv_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:text="@string/fragment_video_store_tv_sub_title_text"/>
        <include
            android:id="@+id/ll_help_videos_center"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            layout="@layout/layout_help_button"/>
    </LinearLayout>
    <include
        android:id="@+id/ll_no_int_connection"
        android:visibility="gone"
        layout="@layout/layout_no_connection"/>
    <include
        android:id="@+id/ll_help_videos"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_help_bottom"
        android:layout_alignParentBottom="true"
        layout="@layout/layout_help_button"/>
</RelativeLayout>
