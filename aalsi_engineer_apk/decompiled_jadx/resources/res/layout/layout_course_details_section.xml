<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="#de000000"
        android:id="@+id/tv_title_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_name"
        android:maxEms="200"
        android:minEms="3"/>
    <EditText
        android:textSize="14sp"
        android:id="@+id/et_course_name"
        android:background="@drawable/shape_rectangle_gray_outline_white_filled_r4"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLength="100"
        android:inputType="text"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#de000000"
        android:id="@+id/tv_title_photo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_photo"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_course_cover"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:minHeight="200dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="H,4:3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:id="@+id/iv_edit_course_cover"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            app:srcCompat="@drawable/ic_edit_pencil_round"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">
        <ImageView
            android:id="@+id/iv_course_info"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:tint="@color/color_666666"
            app:srcCompat="@drawable/ic_info"/>
        <TextView
            android:textSize="12sp"
            android:id="@+id/tv_course_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recommended_image_edit_course_msg"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <View
        android:background="@color/grayE5"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/black"
        android:id="@+id/tv_title_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_description"/>
    <EditText
        android:textSize="14sp"
        android:id="@+id/et_course_description"
        android:background="@drawable/shape_rectangle_gray_outline_white_filled_r4"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:inputType="text"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_cat_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:background="#e5e5e5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#de000000"
        android:id="@+id/tv_title_course_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_course_validity"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#99000000"
        android:id="@+id/tv_course_duration_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_course_duration_info"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:background="@drawable/shape_rectangle_gray_outline_white_filled_r4"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:layout_weight="1">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black"
            android:id="@+id/tv_course_validity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:drawableEndCompat="@drawable/coupon_arrow_bottom"/>
        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/spinner_validity"
            android:background="@color/white"
            android:paddingTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:spinnerMode="dropdown"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="#99000000"
        android:id="@+id/tv_validity_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_single_validity_description"/>
    <LinearLayout
        android:id="@+id/ll_validity"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <EditText
            android:textSize="14sp"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:id="@+id/et_value"
            android:background="@drawable/shape_rectangle_gray_outline_white_filled_r4"
            android:padding="16dp"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:maxLines="1"
            android:maxLength="5"
            android:digits="1234567890"
            android:layout_weight="1"
            android:inputType="number"
            android:layout_marginEnd="8dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:background="@drawable/shape_rectangle_gray_outline_white_filled_r4"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:id="@+id/tv_select_date_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/layout_course_details_section_tv_select_date_type_text"/>
            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinner_type_date"
                android:background="@color/white"
                android:paddingLeft="15dp"
                android:paddingTop="5dp"
                android:paddingRight="15dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:spinnerMode="dropdown"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_expiry"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textColorHint="@color/black"
            android:id="@+id/tv_date_expiry"
            android:background="@drawable/shape_rectangle_gray_outline_white_filled_r4"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/select_date"
            android:layout_weight="1"
            app:drawableEndCompat="@drawable/ic_calendar_outline"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_price_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:textSize="14sp"
                android:textColor="#de000000"
                android:id="@+id/tv_label_price"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginRight="8dp"
                android:text="@string/label_price_in_inr"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:id="@+id/tv_label_discount"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:text="@string/label_discount_in_inr"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <EditText
                android:textSize="14sp"
                android:ellipsize="end"
                android:id="@+id/et_price"
                android:background="@drawable/shape_rectangle_gray_outline_white_filled_r4"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:hint="@string/label_hint_enter_price"
                android:maxLines="1"
                android:maxLength="7"
                android:digits="1234567890"
                android:layout_weight="1"
                android:inputType="number"
                android:layout_marginEnd="8dp"/>
            <EditText
                android:textSize="14sp"
                android:ellipsize="end"
                android:id="@+id/et_discount"
                android:background="@drawable/shape_rectangle_gray_outline_white_filled_r4"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:hint="@string/label_hint_enter_dicount"
                android:maxLines="1"
                android:maxLength="7"
                android:digits="1234567890"
                android:layout_weight="1"
                android:inputType="number"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black"
            android:id="@+id/tv_title_selling_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_selling_price"/>
        <TextView
            android:enabled="false"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:id="@+id/tv_effective_selling_price"
            android:background="@drawable/shape_rectangle_disabled"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_multiple_validities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_tax_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/gray79"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="16dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/red_e5"
            android:id="@+id/installment_error_msg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/instalments_will_be_removed_from_course"
            android:layout_marginStart="16dp"/>
        <androidx.appcompat.widget.SwitchCompat
            android:textSize="14sp"
            android:textColor="@color/black"
            android:id="@+id/sw_tax_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_tax_details"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#99000000"
            android:id="@+id/tv_title_tax_details_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/label_tax_info"/>
        <LinearLayout
            android:id="@+id/ll_gst_tax_percent"
            android:background="@drawable/shape_rectangle_gray_outline_white_filled_r4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <Spinner
                android:gravity="center_vertical"
                android:id="@+id/spinner_taxPercent"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:spinnerMode="dropdown"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#000000"
            android:id="@+id/tv_GST_Slab_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/gst_slab_info"
            android:lineSpacingExtra="2sp"
            android:alpha="0.6"/>
        <View
            android:background="@color/gray79"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat
        android:textSize="14sp"
        android:textColor="@color/black"
        android:id="@+id/sw_internet_charges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_internet_charges"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#99000000"
        android:id="@+id/tv_title_internet_charges_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/label_internet_charges_info"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_pricing_breakup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/gray79"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="16dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#de000000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pricing_breakup"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_your_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">
            <TextView
                android:textSize="14sp"
                android:textColor="#de000000"
                android:gravity="start|center_vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/your_share"
                android:layout_weight="1"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorPrimaryText"
                android:gravity="end|center_vertical"
                android:id="@+id/tv_your_share"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_content_creator_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">
            <TextView
                android:textSize="14sp"
                android:textColor="#de000000"
                android:gravity="start|center_vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/content_creator_s_share"
                android:layout_weight="1"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorPrimaryText"
                android:gravity="end|center_vertical"
                android:id="@+id/tv_content_creator_share"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#99000000"
            android:id="@+id/tv_title_reselling_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/label_inclusive_of_all_platform"/>
        <View
            android:background="@color/gray79"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
    <RadioButton
        android:textSize="14sp"
        android:id="@+id/rb_validity"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_set_validity"/>
    <RadioButton
        android:textSize="14sp"
        android:id="@+id/rb_expiry"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_set_expiry"/>
    <RadioButton
        android:textSize="14sp"
        android:id="@+id/rb_lifetime"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_lifetime"/>
</LinearLayout>
