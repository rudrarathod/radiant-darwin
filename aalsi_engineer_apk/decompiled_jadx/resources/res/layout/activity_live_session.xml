<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clLiveSessionParent"
    android:tag="layout/activity_live_session_0"
    android:background="@color/color_F4F9FD"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/ll_timer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/flSnackbarParent"
        app:layout_constraintStart_toStartOf="@+id/flSnackbarParent"
        app:layout_constraintTop_toTopOf="@+id/clLiveSessionParent"
        layout="@layout/layout_live_class_timer"/>
    <FrameLayout
        android:id="@+id/flSnackbarParent"
        android:tag="binding_1"
        android:background="@drawable/shape_rectangle_filled_color_blueish_r16"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:clipToOutline="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/barrier_livesession_video_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.media3.ui.PlayerView
            android:id="@+id/exo_player_am"
            android:background="@color/black"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Live video"
            app:auto_show="true"
            app:controller_layout_id="@layout/custom_exo_controls"
            app:repeat_toggle_modes="one"
            app:resize_mode="zoom"
            app:show_buffering="when_playing"
            app:surface_type="surface_view"
            app:use_controller="false"/>
        <hms.webrtc.SurfaceViewRenderer
            android:layout_gravity="center"
            android:id="@+id/svrScreenShare"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <hms.webrtc.SurfaceViewRenderer
            android:layout_gravity="center"
            android:id="@+id/localGLSurfaceView"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <live.videosdk.rtc.android.VideoView
            android:layout_gravity="center"
            android:id="@+id/videoSdkVideoView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include
            android:id="@+id/include_tutor_video_disabled_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/include_tutor_video_disabled_layout"/>
        <TextView
            android:textSize="@dimen/medium_text"
            android:textColor="@android:color/white"
            android:layout_gravity="center"
            android:id="@+id/tvVideoMessage"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tutor_muted_video"/>
        <ImageView
            android:id="@+id/ivLogo"
            android:visibility="visible"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_margin="@dimen/_17sdp"
            android:scaleType="fitCenter"
            android:alpha="0.5"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="end|top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ivTutorMuteStatus"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_margin="@dimen/_14sdp"
                android:contentDescription="@string/app_name"
                android:layout_marginEnd="@dimen/_48sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.498"
                app:srcCompat="@drawable/ic_new_mic_off"/>
            <ImageView
                android:id="@+id/ivTutorVideoStatus"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_margin="@dimen/_14sdp"
                android:contentDescription="@string/app_name"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivTutorMuteStatus"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_new_video_of"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            android:id="@+id/include_tapping_video_section"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/include_tapping_video_section_layout"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="end"
            android:id="@+id/clChatPollNotificationContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_60sdp"
            android:layout_marginEnd="@dimen/_14sdp"
            android:elevation="@dimen/_8sdp">
            <ImageView
                android:id="@+id/ivChatNotifier"
                android:background="@drawable/bg_rounded_white"
                android:padding="@dimen/_8sdp"
                android:visibility="gone"
                android:layout_width="44dp"
                android:layout_height="45dp"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:contentDescription="@string/app_name"
                android:layout_marginEnd="@dimen/_8sdp"
                app:layout_constraintBottom_toTopOf="@+id/ivPollNotifier"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_new_chat"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvMessageCountNotifier"
                android:background="@drawable/prime_color_less_rounded_corners"
                android:visibility="gone"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/nunito_sans_semi_bold_8_white"/>
            <ImageView
                android:id="@+id/ivPollNotifier"
                android:background="@drawable/bg_rounded_white"
                android:padding="@dimen/_2sdp"
                android:visibility="gone"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:contentDescription="@string/app_name"
                android:layout_marginEnd="@dimen/_8sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivChatNotifier"
                app:srcCompat="@drawable/ic_new_polls"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvPollNotifier"
                android:background="@drawable/prime_color_less_rounded_corners"
                android:visibility="gone"
                android:layout_width="@dimen/_8sdp"
                android:layout_height="@dimen/_8sdp"
                android:layout_marginTop="-4dp"
                android:layout_marginEnd="@dimen/_6sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ivPollNotifier"
                style="@style/nunito_sans_semi_bold_10_white"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            android:layout_gravity="end|bottom"
            android:id="@+id/include_volume_seekbar_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_20sdp"
            android:layout_marginEnd="@dimen/_60sdp"
            layout="@layout/include_volume_seekbar_top_layout"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/llFloatingView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/llText"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp">
                <TextView
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/colorGray"
                    android:layout_gravity="center"
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="@color/DE000000"
                    android:shadowDx="3"
                    android:shadowDy="3"
                    android:shadowRadius="4"/>
                <TextView
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/colorGray"
                    android:layout_gravity="center"
                    android:id="@+id/tvUserID"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="@color/DE000000"
                    android:shadowDx="3"
                    android:shadowDy="3"
                    android:shadowRadius="4"/>
            </LinearLayout>
        </LinearLayout>
        <include
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/include_network_toast"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_48sdp"
            layout="@layout/include_network_failed"/>
        <include
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/include_connected_toast"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_48sdp"
            layout="@layout/include_user_connected_live_class"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_livesession_side_menu"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="0dp"
        android:maxWidth="@dimen/_80sdp"
        app:layout_constraintBottom_toTopOf="@+id/ivHandRaise"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/flSnackbarParent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.48">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/shape_rectangle_filled_color_white_r16"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:gravity="center"
                android:id="@+id/tvLiveSessionChat"
                android:padding="@dimen/_10sdp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat"
                app:drawableTopCompat="@drawable/ic_new_chat"
                app:layout_constraintBottom_toTopOf="@+id/tvPeople"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.3"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/nunito_sans_regular_12"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvNewMessageCount"
                android:background="@drawable/prime_color_less_rounded_corners"
                android:visibility="gone"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_marginTop="-5dp"
                app:layout_constraintEnd_toEndOf="@+id/tvLiveSessionChat"
                app:layout_constraintTop_toTopOf="@+id/tvLiveSessionChat"
                style="@style/nunito_sans_semi_bold_8_white"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvPeople"
                android:padding="@dimen/_10sdp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/people"
                app:drawableTopCompat="@drawable/ic_new_people"
                app:layout_constraintBottom_toTopOf="@+id/tvSettings"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.3"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvLiveSessionChat"
                style="@style/nunito_sans_regular_12"/>
            <ImageView
                android:id="@+id/ivPeople"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                android:layout_width="@dimen/_42sdp"
                android:layout_height="@dimen/_42sdp"
                android:contentDescription="@string/app_name"
                android:elevation="@dimen/_16sdp"
                app:layout_constraintBottom_toTopOf="@+id/tvSettings"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.3"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvLiveSessionChat"
                app:srcCompat="@drawable/ic_new_hand_raise_yellow"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvSettings"
                android:padding="@dimen/_10sdp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                app:drawableTopCompat="@drawable/ic_new_settings"
                app:layout_constraintBottom_toTopOf="@+id/tvPolls"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.3"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvPeople"
                style="@style/nunito_sans_regular_12"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvPolls"
                android:paddingBottom="@dimen/_10sdp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/poll"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                app:drawableTopCompat="@drawable/ic_new_polls"
                app:layout_constraintBottom_toTopOf="@+id/tvBuyCourse"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.3"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvSettings"
                style="@style/nunito_sans_regular_12"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvPollCount"
                android:background="@drawable/prime_color_less_rounded_corners"
                android:visibility="gone"
                android:layout_width="@dimen/_8sdp"
                android:layout_height="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                app:layout_constraintBottom_toTopOf="@+id/tvPolls"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/nunito_sans_semi_bold_10_white"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvBuyCourse"
                android:paddingBottom="@dimen/_10sdp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/course"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                app:drawableTopCompat="@drawable/ic_new_buy_course"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.3"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvPolls"
                style="@style/nunito_sans_regular_12"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/ivHandRaise"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/_8sdp"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10sdp"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/cl_livesession_side_menu"
        app:layout_constraintHeight_percent="0.2"
        app:layout_constraintStart_toStartOf="@+id/cl_livesession_side_menu"
        app:srcCompat="@drawable/ic_new_hand_raise"/>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.48"/>
    <include
        android:id="@+id/include_portrait_header"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flSnackbarParent"
        layout="@layout/include_livesession_portrait_header"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llProgressBar"
        android:background="@color/colorTransparentWhite50"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:id="@+id/progressBar"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/tvConnecting"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connecting"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:id="@+id/llLiveMessages"
        android:background="@color/color_CC0A1629"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="@+id/flSnackbarParent"
        app:layout_constraintEnd_toEndOf="@+id/flSnackbarParent"
        app:layout_constraintStart_toStartOf="@+id/flSnackbarParent">
        <ProgressBar
            android:id="@+id/progressBar2"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tvLiveMessages"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/nunito_sans_semi_bold_16_white"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:id="@+id/llToastMessages"
        android:background="@drawable/shape_rectangle_grey_outline_backdrop_filled_r16"
        android:padding="@dimen/_10sdp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/flSnackbarParent"
        app:layout_constraintStart_toStartOf="@+id/flSnackbarParent">
        <ImageView
            android:id="@+id/ivToastMessages"
            android:visibility="visible"
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:contentDescription="@string/app_name"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="@+id/tvToastMessages"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvToastMessages"/>
        <TextView
            android:id="@+id/tvToastMessages"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivToastMessages"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/nunito_sans_regular_16_white"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/_16sdp"
        android:textColor="@color/white"
        android:id="@+id/tv_live_notifications"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_minus58sdp"
        android:layout_marginTop="@dimen/_38sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_livesession_video_size"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:barrierDirection="left"
        app:constraint_referenced_ids="cl_livesession_side_menu,fragmentContainer"/>
    <include
        android:id="@+id/include_live_class_student_loader"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/include_live_class_student_loader"/>
    <include
        android:id="@+id/include_live_class_student_failed"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/include_live_class_student_failed"/>
    <include
        android:id="@+id/include_tutor_not_joined"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/include_live_class_student_tutor_not_joined"/>
</androidx.constraintlayout.widget.ConstraintLayout>
