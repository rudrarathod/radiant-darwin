<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/gray91"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/colorSecondaryText"
        android:gravity="start|center_vertical"
        android:paddingLeft="20dp"
        android:paddingTop="15dp"
        android:paddingRight="20dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_mobile_number_hint"
        android:textAllCaps="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_contact_layout"
        android:background="@color/white"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/colorPrimaryText"
            android:gravity="center_vertical"
            android:id="@+id/tv_student_phone_number"
            android:paddingLeft="20dp"
            android:paddingRight="0dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textIsSelectable="true"
            android:paddingStart="20dp"
            android:paddingEnd="0dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_call_student"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tint="@color/colorPrimary"
            app:srcCompat="@drawable/ic_call_outline"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_msg_student"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tint="@color/colorPrimary"
            app:srcCompat="@drawable/ic_chat"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/colorSecondaryText"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_email_profile_label"
        android:paddingLeft="20dp"
        android:paddingTop="15dp"
        android:paddingRight="20dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/contact_details_student_details_layout_tv_email_profile_label_text"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_email_layout"
        android:background="@color/white"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/colorPrimaryText"
            android:gravity="center_vertical"
            android:id="@+id/tv_student_email"
            android:paddingLeft="20dp"
            android:paddingRight="0dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textIsSelectable="true"
            android:paddingStart="20dp"
            android:paddingEnd="0dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_email_student"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tint="@color/colorPrimary"
            app:srcCompat="@drawable/ic_mail"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/colorSecondaryText"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_parents"
        android:paddingLeft="20dp"
        android:paddingTop="15dp"
        android:paddingRight="20dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/parents_caps"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_add_parent"
        android:background="@color/white"
        android:paddingLeft="15dp"
        android:paddingTop="5dp"
        android:paddingRight="15dp"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:tint="@color/gray79"
            app:srcCompat="@drawable/ic_add_circle_outline"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/add_parent"
            android:layout_weight="1"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_parents_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
