<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gray91"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@drawable/bg_primary_color_gradient"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/ll_purchase"
        android:layout_below="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/layout_iv_cover"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="@color/shadow_black">
                    <ImageView
                        android:id="@+id/iv_course_cover"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"/>
                </FrameLayout>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_cover_course_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_course_overview"
                android:background="@color/white"
                android:paddingLeft="15dp"
                android:paddingTop="15dp"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_course_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:id="@+id/ll_share_course"
                        android:padding="5dp"
                        android:layout_width="30dp"
                        android:layout_height="30dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:srcCompat="@drawable/ic_share_new"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp">
                    <ImageView
                        android:id="@+id/iv_clock"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:maxWidth="18dp"
                        android:maxHeight="18dp"
                        android:tint="@color/colorSecondaryText"
                        app:srcCompat="@drawable/ic_clock_time"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorSecondaryText"
                        android:gravity="center"
                        android:id="@+id/tv_timings_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="@string/activity_course_detail_tv_timings_label_text"
                        android:layout_marginStart="10dp"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/tv_timings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <co.classplus.app.ui.custom.ExpandableTextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:id="@+id/tv_course_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorPrimary"
                    android:id="@+id/tv_read_more"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <View
                    android:background="@color/gray91"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false">
                    <RelativeLayout
                        android:gravity="start|top"
                        android:layout_gravity="start|top"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5">
                        <ImageView
                            android:id="@+id/iv_book"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:maxWidth="18dp"
                            android:maxHeight="18dp"
                            android:tint="@color/colorSecondaryText"
                            android:layout_alignTop="@+id/tv_subject_label"
                            android:layout_alignBottom="@+id/tv_subject_label"
                            app:srcCompat="@drawable/ic_book"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorSecondaryText"
                            android:id="@+id/tv_subject_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:text="@string/subject"
                            android:layout_toRightOf="@+id/iv_book"
                            android:layout_marginStart="10dp"
                            android:layout_toEndOf="@+id/iv_book"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/black"
                            android:id="@+id/tv_subject"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_below="@+id/tv_subject_label"
                            android:layout_alignLeft="@+id/tv_subject_label"
                            android:layout_alignStart="@+id/tv_subject_label"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:gravity="start|top"
                        android:layout_gravity="start|top"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5">
                        <ImageView
                            android:id="@+id/iv_class"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:maxWidth="18dp"
                            android:maxHeight="18dp"
                            android:tint="@color/colorSecondaryText"
                            android:layout_alignTop="@+id/tv_class_label"
                            android:layout_alignBottom="@+id/tv_class_label"
                            app:srcCompat="@drawable/ic_group_white"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorSecondaryText"
                            android:id="@+id/tv_class_label"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="10dp"
                            android:text="@string/course"
                            android:layout_toRightOf="@+id/iv_class"
                            android:layout_marginStart="10dp"
                            android:layout_toEndOf="@+id/iv_class"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/black"
                            android:id="@+id/tv_class"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_below="@+id/tv_class_label"
                            android:layout_alignLeft="@+id/tv_class_label"
                            android:layout_alignStart="@+id/tv_class_label"/>
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorSecondaryText"
                android:id="@+id/tv_sub_courses_label"
                android:paddingLeft="15dp"
                android:paddingTop="20dp"
                android:paddingRight="15dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_batches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_un_purchased"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:paddingLeft="15dp"
                    android:paddingTop="20dp"
                    android:paddingRight="15dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/price_details"
                    android:textAllCaps="true"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_price_details"
                    android:background="@color/white"
                    android:paddingLeft="15dp"
                    android:paddingTop="15dp"
                    android:paddingRight="15dp"
                    android:paddingBottom="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorPrimaryText"
                            android:gravity="start|center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/course_price"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorPrimaryText"
                            android:gravity="end|center_vertical"
                            android:id="@+id/tv_price"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorPrimaryText"
                            android:gravity="start|center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/discount"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorPrimaryText"
                            android:gravity="end|center_vertical"
                            android:id="@+id/tv_discount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <View
                        android:background="@color/gray91"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorPrimaryText"
                            android:gravity="start|center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/amount_payable"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorPrimaryText"
                            android:gravity="end|center_vertical"
                            android:id="@+id/tv_final_price"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:id="@+id/tv_t_c"
                    android:paddingLeft="15dp"
                    android:paddingTop="20dp"
                    android:paddingRight="15dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAllCaps="true"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_payment_summary"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:paddingLeft="15dp"
                    android:paddingTop="20dp"
                    android:paddingRight="15dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_summary"
                    android:textAllCaps="true"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"/>
                <RelativeLayout
                    android:background="@color/white"
                    android:paddingLeft="15dp"
                    android:paddingTop="15dp"
                    android:paddingRight="15dp"
                    android:paddingBottom="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_amount_paid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorPrimaryText"
                            android:gravity="start|center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/amount_paid"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorPrimaryText"
                            android:gravity="end|center_vertical"
                            android:id="@+id/tv_amount_paid"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_date_purchased"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:layout_below="@+id/ll_amount_paid">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorPrimaryText"
                            android:gravity="start|center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/date"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorPrimaryText"
                            android:gravity="end|center_vertical"
                            android:id="@+id/tv_date_purchased"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/ll_download_receipt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/ll_date_purchased"
                        android:layout_centerHorizontal="true">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:tint="@color/colorPrimary"
                            app:srcCompat="@drawable/ic_download"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:text="@string/download_receipt"
                            android:layout_marginStart="5dp"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginLeft="50dp"
                        android:src="@drawable/ic_purchased_stamp"
                        android:layout_marginStart="50dp"/>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_purchase"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_purchase"
            android:background="@drawable/bg_button_click_color_primary"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:textAllCaps="false"/>
    </LinearLayout>
    <include
        android:id="@+id/layout_no_int_connection"
        android:visibility="gone"
        layout="@layout/layout_no_connection"/>
</RelativeLayout>
