<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/list_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:scaleType="centerCrop"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ayp_8dp"
                style="@style/BaseTextAppearance.BoldTitle"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/red3"
                android:id="@+id/mandatoryTitle"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ayp_8dp"
                android:text="@string/item_info_field_edit_mandatoryTitle_text"/>
            <ImageView
                android:id="@+id/iv_title_tool_tip"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginTop="3dp"
                android:src="@drawable/ic_info_blue"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:id="@+id/inputLayout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/countryCodeLayout"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/shape_rectangle_disabled"
                        android:paddingLeft="@dimen/ayp_16dp"
                        android:paddingTop="@dimen/ayp_12dp"
                        android:paddingRight="@dimen/ayp_16dp"
                        android:paddingBottom="@dimen/ayp_12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:imeOptions="actionDone"
                        style="@style/BaseTextAppearance.Title"/>
                    <View
                        android:background="#de000000"
                        android:layout_width="6dp"
                        android:layout_height="1dp"
                        android:layout_margin="4dp"
                        style="@style/BaseTextAppearance.Title"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.AppCompatEditText
                    android:layout_gravity="center_vertical"
                    android:id="@+id/value"
                    android:background="@drawable/shape_rectangle_gray_outline_r2"
                    android:paddingLeft="@dimen/ayp_16dp"
                    android:paddingTop="@dimen/ayp_12dp"
                    android:paddingRight="@dimen/ayp_16dp"
                    android:paddingBottom="@dimen/ayp_12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="100"
                    android:layout_weight="1"
                    android:imeOptions="actionDone"
                    android:layout_marginEnd="@dimen/ayp_16dp"
                    style="@style/BaseTextAppearance.Title"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </LinearLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:id="@+id/documentUploadLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="12sp"
                android:id="@+id/documentUploadButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-3dp"
                android:maxWidth="100dp"
                android:text="@string/view_file"
                android:layout_weight="1"
                android:layout_marginStart="-3dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/colorControl"
                android:gravity="center"
                android:id="@+id/reupload"
                android:background="@android:color/transparent"
                android:focusable="false"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="12dp"
                android:text="@string/reupload"
                android:drawableLeft="@drawable/ic_upload"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_upload"
                android:layout_marginStart="12dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/update_status_delete"
                android:gravity="center"
                android:id="@+id/delete"
                android:background="@android:color/transparent"
                android:focusable="false"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/delete"
                android:drawableLeft="@drawable/ic_chat_delete_new_red"
                android:layout_weight="1"
                android:textAllCaps="true"
                android:drawableStart="@drawable/ic_chat_delete_new_red"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <HorizontalScrollView
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/radioLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>
        <androidx.appcompat.widget.AppCompatTextView
            android:textStyle="normal"
            android:gravity="center_vertical"
            android:id="@+id/datePicker"
            android:background="@drawable/shape_rectangle_gray_outline_r2"
            android:paddingLeft="@dimen/ayp_16dp"
            android:paddingTop="@dimen/ayp_12dp"
            android:paddingRight="@dimen/ayp_16dp"
            android:paddingBottom="@dimen/ayp_12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/ayp_16dp"
            style="@style/BaseTextAppearance.Title"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/shape_rectangle_gray_outline_r2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/ayp_16dp">
            <Spinner
                android:id="@+id/spinner"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:spinnerMode="dropdown"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatEditText
            android:gravity="top"
            android:id="@+id/et_spinner"
            android:background="@drawable/shape_rectangle_gray_outline_r2"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="8dp"
            android:hint="@string/enter_a_valid_reason_of_change"
            android:maxLength="1000"
            android:layout_marginEnd="@dimen/ayp_16dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</LinearLayout>
