<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/black"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_share_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_16sdp"
        android:text="@string/share_test_link"
        android:layout_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_close_share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_16sdp"
        android:contentDescription="@string/dismiss_preview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_close"/>
    <View
        android:id="@+id/seperator1"
        android:background="@color/grayE5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_share_text"/>
    <ImageView
        android:id="@+id/iv_test_icon"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_margin="@dimen/_20sdp"
        android:src="@drawable/ic_test_new"
        android:contentDescription="@string/test_icon_preview"
        app:layout_constraintBottom_toTopOf="@+id/seperator2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seperator1"/>
    <TextView
        android:textSize="@dimen/ts_16sp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:id="@+id/tv_test_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_20sdp"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/seperator2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_test_icon"
        app:layout_constraintTop_toBottomOf="@+id/seperator1"/>
    <View
        android:id="@+id/seperator2"
        android:background="@color/grayE5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_test_name"/>
    <ImageView
        android:id="@+id/iv_test_time_icon"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_margin="@dimen/_20sdp"
        android:src="@drawable/ic_clock"
        android:contentDescription="@string/test_time_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seperator2"/>
    <TextView
        android:textSize="@dimen/ts_14sp"
        android:textColor="@color/color_99000000"
        android:id="@+id/tv_test_time_que"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:text="@string/when_can_students_attempt"
        android:lineSpacingExtra="@dimen/aya_4sp"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/_6sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_test_time_icon"
        app:layout_constraintTop_toBottomOf="@+id/seperator2"/>
    <TextView
        android:textSize="@dimen/ts_16sp"
        android:textColor="@color/black"
        android:id="@+id/tv_test_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:lineSpacingExtra="@dimen/aya_4sp"
        android:layout_marginEnd="@dimen/_6sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_test_time_que"
        app:layout_constraintTop_toBottomOf="@+id/tv_test_time_que"/>
    <ImageView
        android:id="@+id/iv_attempts_icon"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:src="@drawable/ic_loop"
        android:contentDescription="@string/attempt_icon_preview"
        android:layout_marginStart="@dimen/_20sdp"
        app:layout_constraintBottom_toTopOf="@+id/seperator3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_no_of_attempts_que"/>
    <TextView
        android:textSize="@dimen/ts_14sp"
        android:textColor="@color/color_99000000"
        android:id="@+id/tv_no_of_attempts_que"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_28sdp"
        android:text="@string/how_many_times_can_students_attempt"
        android:lineSpacingExtra="@dimen/aya_4sp"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginEnd="@dimen/_6sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_attempts_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_test_time"/>
    <TextView
        android:textSize="@dimen/ts_16sp"
        android:textColor="@color/black"
        android:id="@+id/tv_attempts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:lineSpacingExtra="@dimen/aya_4sp"
        android:layout_marginEnd="@dimen/_6sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_no_of_attempts_que"
        app:layout_constraintTop_toBottomOf="@+id/tv_no_of_attempts_que"/>
    <View
        android:id="@+id/seperator3"
        android:background="@color/grayE5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_attempts_icon"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/ll_copy_link"
        android:background="@drawable/shape_rectangle_gray_outline_r6"
        android:paddingLeft="16dp"
        android:paddingTop="13dp"
        android:paddingRight="16dp"
        android:paddingBottom="13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_24sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seperator3">
        <TextView
            android:textSize="14sp"
            android:id="@+id/tv_share_url_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:id="@+id/tv_copy_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/copy"
            android:drawablePadding="8dp"
            android:textAllCaps="true"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:id="@+id/tv_or"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:text="@string/or"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_copy_link"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_whatsapp_share"
        android:background="@drawable/bg_btn_share_whatsapp"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_16sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_or">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_whatsapp_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/iv_whatsapp_icon"
                android:layout_width="@dimen/aya_24dp"
                android:layout_height="@dimen/aya_24dp"
                app:srcCompat="@drawable/ic_whatsapp_bold"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_whatsapp_share"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_test_link"
                android:layout_marginStart="@dimen/_14sdp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
