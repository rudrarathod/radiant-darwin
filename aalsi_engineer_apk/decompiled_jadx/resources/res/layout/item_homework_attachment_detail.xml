<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_attachment_item"
    android:background="@color/white"
    android:paddingTop="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_attach"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_attachment_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/pdf"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:id="@+id/tv_attachment_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/failed_upload"
            android:id="@+id/tv_attachment_failed"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:text="@string/failed_to_upload"
            android:layout_marginEnd="10dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_download_attachment"
            android:padding="7dp"
            android:visibility="gone"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:tint="@color/black"
            app:srcCompat="@drawable/ic_download"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress_bar"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="5dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_remove"
            android:padding="7dp"
            android:visibility="visible"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:tint="@color/black"
            app:srcCompat="@drawable/ic_close_cross"/>
    </LinearLayout>
    <View
        android:background="@color/grayE5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_below="@+id/ll_attach"/>
</RelativeLayout>
