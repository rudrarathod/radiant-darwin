<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/coupons_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@drawable/bg_primary_color_gradient"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ayp_8dp"
        android:layout_below="@+id/toolbar">
        <LinearLayout
            android:gravity="start"
            android:orientation="horizontal"
            android:id="@+id/search_layout"
            android:background="@drawable/shape_rectangle_filled_white_radius_2"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_margin="8dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/iv_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_search"
                app:tint="@color/colorSecondaryTextAlpha"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="14sp"
                android:textColorHint="@color/colorSecondaryText"
                android:gravity="start|center_vertical"
                android:layout_gravity="center"
                android:id="@+id/et_search"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/search_students"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/studentSelectDescription"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ayp_16dp"
            android:layout_marginTop="@dimen/ayp_8dp"
            android:layout_marginRight="@dimen/ayp_16dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/black"
                android:background="@drawable/coupon_coursedetailsbluebackground"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/in_case_of_private_coupons_selected_students_will_be_added_to_eligible_students_list"
                android:textAlignment="center"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_not_found"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="80dp">
            <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/store_no_course"/>
            <TextView
                android:textSize="20sp"
                android:textColor="@color/colorPrimaryText"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:text="@string/no_students_found"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_students_found_to_display"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/notEmptyContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/gray66"
                android:id="@+id/title_eligible"
                android:paddingTop="@dimen/ayp_8dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/eligible_students"
                android:textAllCaps="true"
                android:layout_marginStart="16dp"/>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/selectStudentsTag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ayp_16dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/gray66"
                    android:paddingTop="@dimen/ayp_8dp"
                    android:paddingBottom="@dimen/ayp_8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_select_student"
                    android:textAllCaps="true"/>
                <LinearLayout
                    android:paddingTop="@dimen/ayp_8dp"
                    android:paddingBottom="@dimen/ayp_8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/imview1"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:srcCompat="@drawable/ic_filter_outline"/>
                    <TextView
                        android:textSize="14sp"
                        android:id="@+id/tvFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter"
                        android:textAllCaps="true"
                        android:paddingStart="8dp"
                        android:paddingEnd="@dimen/ayp_16dp"/>
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/countSelectedLayout"
                android:background="@color/white"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="1dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/gray66"
                    android:id="@+id/selectedStudents"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/link"
                    android:id="@+id/selectdeselectStudent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_all"
                    android:paddingStart="@dimen/ayp_16dp"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardElevation="10dp">
        <Button
            android:textSize="18sp"
            android:textColor="@color/white"
            android:id="@+id/button"
            android:background="@drawable/bg_button_click_color_primary"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/finish"
            android:textAllCaps="false"/>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
