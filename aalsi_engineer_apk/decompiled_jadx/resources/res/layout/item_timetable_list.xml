<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardUseCompatPadding="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_282828"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_batch_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_event_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/color_666666"
                        android:id="@+id/tv_event_type"
                        android:background="@drawable/shape_offline_test"
                        android:paddingLeft="10dp"
                        android:paddingTop="5dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/offline"
                        android:textAllCaps="true"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/iv_options"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_dots_black"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="top"
                android:layout_gravity="top"
                android:orientation="horizontal"
                android:id="@+id/ll_course_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_282828"
                    android:id="@+id/tv_detail1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_99000000"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_faculty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp">
                <RelativeLayout
                    android:id="@+id/rl_event_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/iv_schedule"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="4dp"
                        android:tint="@color/colorSecondaryText"
                        android:layout_centerVertical="true"
                        app:srcCompat="@drawable/ic_clock_time"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_282828"
                        android:gravity="center"
                        android:id="@+id/tv_event_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv_schedule"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="5dp"
                        android:layout_toEndOf="@+id/iv_schedule"/>
                </RelativeLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_99000000"
                    android:id="@+id/tv_time_left_event"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_delete"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:tint="@color/red3"
                    app:srcCompat="@drawable/ic_delete"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/red3"
                    android:id="@+id/tv_delete"
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/delete"
                    android:textAllCaps="true"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <include layout="@layout/common_footer_layout_grayf1"/>
</LinearLayout>
