<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@drawable/bg_primary_color_gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:background="@color/gray91"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_below="@+id/toolbar">
        <RelativeLayout
            android:id="@+id/rl_recycler_parent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/colorSecondaryText"
                android:id="@+id/selected_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:textAllCaps="true"
                android:layout_marginStart="16dp"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/card_recipients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/selected_text">
                <RelativeLayout
                    android:gravity="left"
                    android:id="@+id/rl_recipients"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/tv_to"
                        android:padding="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/to"
                        android:layout_centerVertical="true"
                        android:textAllCaps="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:id="@+id/tv_recipient_label"
                        android:background="@drawable/shape_rectangle_filled_primary_r20"
                        android:padding="5dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_toRightOf="@+id/tv_to"
                        android:layout_centerVertical="true"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="8dp"
                        android:layout_toStartOf="@+id/iv_add_recipient"
                        android:layout_toEndOf="@+id/tv_to">
                        <TextView
                            android:enabled="true"
                            android:textSize="13sp"
                            android:textColor="@color/white"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/tv_recipients"
                            android:background="@drawable/shape_rectangle_filled_light_blue_r2_borderless_new"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:focusable="true"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textAllCaps="true"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/iv_add_recipient"
                        android:padding="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tint="@color/colorPrimary"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        app:srcCompat="@drawable/ic_add_circle_outline"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <View
                android:id="@+id/divider_1"
                android:background="@color/gray89"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/card_recipients"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_attachments"
                android:background="@color/white"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/divider_1"/>
            <include
                android:id="@+id/layoutMessageEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                layout="@layout/send_chat_message_layout"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
