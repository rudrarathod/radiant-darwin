<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_item_announcements_header"
    android:background="@color/gray91"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.4">
            <RelativeLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:background="@drawable/make_announcement_circle_shape"
                android:layout_width="120dp"
                android:layout_height="120dp">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_margin="5dp"
                    android:tint="#637888"
                    app:srcCompat="@drawable/ic_announcement"/>
            </RelativeLayout>
        </LinearLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.6">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorSecondaryText"
                android:ellipsize="end"
                android:gravity="start|top"
                android:layout_gravity="start|top"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginRight="5dp"
                android:text="@string/these_messages_will_be_sent_to_all_the_students_subscribed_to_this_course"
                android:layout_above="@+id/dummy_view"
                android:layout_marginEnd="5dp"/>
            <View
                android:id="@+id/dummy_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_centerInParent="true"/>
            <RelativeLayout
                android:gravity="start|center_vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/dummy_view">
                <Button
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="start|bottom"
                    android:id="@+id/button_add_notice"
                    android:background="@drawable/bg_button_click_color_primary"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/make_announcement"
                    android:textAllCaps="false"/>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
