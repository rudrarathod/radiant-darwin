<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/gray91"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:gravity="start|center_vertical"
        android:paddingLeft="20dp"
        android:paddingTop="15dp"
        android:paddingRight="20dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/attendance"
        android:textAllCaps="true"/>
    <RelativeLayout
        android:background="@color/white"
        android:paddingTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="120dp">
        <View
            android:id="@+id/view_center_line"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="1"
            android:layout_toLeftOf="@+id/view_center_line"
            android:layout_toStartOf="@+id/view_center_line">
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.25"/>
            <RelativeLayout
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.75">
                <ProgressBar
                    android:id="@+id/pb_classes_attended"
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:max="100"
                    android:progress="70"
                    android:progressDrawable="@drawable/progress_bar_blue_gray"
                    style="@android:style/Widget.Holo.Light.ProgressBar.Horizontal"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:paddingLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/attended"
                    android:layout_alignLeft="@+id/pb_classes_attended"
                    android:layout_alignTop="@+id/pb_classes_attended"
                    android:layout_alignBottom="@+id/pb_classes_attended"
                    android:layout_alignStart="@+id/pb_classes_attended"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorPrimaryText"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_num_classes_attended"
                    android:paddingRight="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/pb_classes_attended"
                    android:layout_alignRight="@+id/pb_classes_attended"
                    android:layout_alignBottom="@+id/pb_classes_attended"
                    android:layout_alignEnd="@+id/pb_classes_attended"/>
                <ProgressBar
                    android:id="@+id/pb_total_classes"
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="70"
                    android:progressDrawable="@drawable/progress_bar_blue_gray"
                    android:layout_below="@+id/pb_classes_attended"
                    style="@android:style/Widget.Holo.Light.ProgressBar.Horizontal"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:paddingLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_classes"
                    android:layout_alignLeft="@+id/pb_total_classes"
                    android:layout_alignTop="@+id/pb_total_classes"
                    android:layout_alignBottom="@+id/pb_total_classes"
                    android:layout_alignStart="@+id/pb_total_classes"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorPrimaryText"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_num_total_classes"
                    android:paddingRight="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/pb_total_classes"
                    android:layout_alignRight="@+id/pb_total_classes"
                    android:layout_alignBottom="@+id/pb_total_classes"
                    android:layout_alignEnd="@+id/pb_total_classes"/>
            </RelativeLayout>
        </LinearLayout>
        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pc_attendance"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:layout_toRightOf="@+id/view_center_line"/>
    </RelativeLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/colorPrimary"
        android:gravity="center"
        android:id="@+id/tv_attendance_history"
        android:background="@color/white"
        android:paddingTop="5dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/history"/>
</LinearLayout>
