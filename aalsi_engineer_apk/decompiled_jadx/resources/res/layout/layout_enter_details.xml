<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/gray91"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/colorSecondaryText"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:text="@string/name"
        android:textAllCaps="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/red3"
        android:id="@+id/mandatory_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ayp_16dp"
        android:layout_marginBottom="@dimen/ayp_8dp"
        android:text="@string/item_info_field_edit_mandatoryTitle_text"
        app:layout_constraintLeft_toRightOf="@+id/tv_name"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_name"
        android:background="@color/white"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_name">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/black"
            android:gravity="start|center_vertical"
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/layout_enter_details_et_name_hint"
            android:maxLength="100"
            android:inputType="textCapSentences"
            android:backgroundTint="@android:color/transparent"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/colorSecondaryText"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_mobile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/label_mobile_number_hint"
        android:textAllCaps="true"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_mobile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/red3"
        android:id="@+id/mandatory_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ayp_16dp"
        android:layout_marginBottom="@dimen/ayp_8dp"
        android:text="@string/item_info_field_edit_mandatoryTitle_text"
        app:layout_constraintBottom_toTopOf="@+id/ll_mobile"
        app:layout_constraintLeft_toRightOf="@+id/tv_mobile"
        app:layout_constraintTop_toBottomOf="@+id/ll_name"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_mobile"
        android:background="@color/white"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_email"
        app:layout_constraintTop_toBottomOf="@+id/tv_mobile">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/black"
            android:gravity="start|center_vertical"
            android:id="@+id/et_mobile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/layout_enter_details_et_mobile_hint"
            android:digits="1234567890"
            android:inputType="phone"
            android:backgroundTint="@android:color/transparent"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/colorSecondaryText"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/label_email_id_hint"
        android:textAllCaps="true"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_email"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_mobile"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/red3"
        android:id="@+id/mandatory_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ayp_16dp"
        android:layout_marginBottom="@dimen/ayp_8dp"
        android:text="@string/item_info_field_edit_mandatoryTitle_text"
        app:layout_constraintBottom_toTopOf="@+id/ll_email"
        app:layout_constraintLeft_toRightOf="@+id/tv_email"
        app:layout_constraintTop_toBottomOf="@+id/ll_mobile"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_email"
        android:background="@color/white"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_remove"
        app:layout_constraintTop_toBottomOf="@+id/tv_email">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/black"
            android:gravity="start|center_vertical"
            android:id="@+id/et_email"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/layout_enter_details_et_email_hint"
            android:inputType="textEmailAddress"
            android:backgroundTint="@android:color/transparent"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_remove"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:foreground="?android:attr/selectableItemBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_email">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/red3"
            android:gravity="center"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remove"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
