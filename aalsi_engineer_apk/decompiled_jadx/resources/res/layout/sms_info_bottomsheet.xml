<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_sheet_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="android.support.design.widget.BottomSheetBehavior">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/black_opaque"
        android:id="@+id/tv_heading"
        android:padding="@dimen/aya_24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sms_units_used"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_close"
        android:padding="22dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_heading"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_heading"
        app:srcCompat="@drawable/ic_close_cross_black"/>
    <View
        android:id="@+id/v_sheet_divider"
        android:background="@color/gray79"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_heading"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/black_opaque"
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aya_24dp"
        android:layout_marginBottom="@dimen/aya_24dp"
        android:layout_marginStart="@dimen/aya_24dp"
        android:layout_marginEnd="@dimen/aya_24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_sheet_divider"/>
    <View
        android:id="@+id/tv2"
        android:background="@color/gray79"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="@dimen/aya_24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_content"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/bottomsheet_done_red"
        android:gravity="center"
        android:id="@+id/tv_apply"
        android:background="@color/white"
        android:padding="@dimen/ayp_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/done"
        android:textAllCaps="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv2"
        style="@style/Widget.MaterialComponents.Button.TextButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
