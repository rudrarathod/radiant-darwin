<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/aya_24dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/frame1"
        android:paddingTop="52dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="22dp">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tv_login_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_enter_number_email"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:id="@+id/tv_enter_number_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/enter_your_mobile_number"
            android:lineSpacingExtra="4sp"
            app:layout_constraintBottom_toTopOf="@+id/ll_enter_no"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_enter_no"
            android:background="@drawable/shape_rectangle_filled_white_outline_gray_r6"
            android:paddingLeft="10dp"
            android:paddingTop="3dp"
            android:paddingRight="10dp"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/ll_proceed">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/colorText"
                android:gravity="center"
                android:id="@+id/tv_cc_initial"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/india_code"/>
            <View
                android:id="@+id/divider"
                android:background="@color/divider"
                android:layout_width="1dp"
                android:layout_height="38dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:layout_marginStart="10dp"/>
            <EditText
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="start|center_vertical"
                android:layout_gravity="center"
                android:id="@+id/et_mobile"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/label_mobile_number_hint"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/faculty_text"
            android:id="@+id/tv_error_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wrong_otp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_enter_no"/>
        <co.classplus.app.ui.common.view.LoadingButton
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_proceed"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aya_52dp"
            android:layout_marginTop="32dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_enter_no"/>
        <View
            android:id="@+id/line_3"
            android:background="@color/grayE5"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_proceed"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/colorText_Black_Alpha_99"
            android:id="@+id/tv_terms_conditions"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="@dimen/ayp_16dp"
            android:text="@string/str_terms_and_conditions_new"
            android:textAlignment="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/line_3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
