<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp">
    <RelativeLayout
        android:id="@+id/rv_main"
        android:background="@color/white"
        android:paddingLeft="14dp"
        android:paddingTop="10dp"
        android:paddingRight="15dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/img_Thumbnail"
            android:layout_width="120dp"
            android:layout_height="90dp"
            android:scaleType="fitXY"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/img_Thumbnail"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/img_Thumbnail">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/course_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/colorPrimaryText"
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:id="@+id/heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_like_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/img_Like"
                        android:layout_width="@dimen/ayp_16dp"
                        android:layout_height="@dimen/ayp_16dp"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_like"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_marginStart="5dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_subheading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp">
                <ImageView
                    android:id="@+id/img_subheading_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="@dimen/ayp_8dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"/>
                <TextView
                    android:textSize="14sp"
                    android:ellipsize="end"
                    android:id="@+id/tv_subheading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_emblem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/img_emblem_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColorHighlight="@color/gray74"
                    android:id="@+id/tv_emblem_text"
                    android:paddingLeft="@dimen/ayp_8dp"
                    android:paddingTop="@dimen/ayp_2dp"
                    android:paddingRight="@dimen/ayp_8dp"
                    android:paddingBottom="@dimen/ayp_2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="right"
                android:orientation="horizontal"
                android:id="@+id/ll_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/img_status_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="@dimen/ayp_8dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:layout_marginEnd="@dimen/ayp_8dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#009ae0"
                    android:textColorHighlight="@color/gray74"
                    android:id="@+id/tv_status_text"
                    android:paddingTop="@dimen/ayp_8dp"
                    android:paddingRight="@dimen/ayp_8dp"
                    android:paddingBottom="@dimen/ayp_8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/price_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_price_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/tv_striked_price_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginStart="16dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ff4058"
                    android:ellipsize="end"
                    android:id="@+id/tv_off_percent_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:ems="5"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_left_label"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="@dimen/ayp_16dp"
        android:layout_marginStart="6dp">
        <TextView
            android:textSize="12sp"
            android:ellipsize="end"
            android:id="@+id/tv_left_label_text"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="center"/>
        <TextView
            android:id="@+id/iv_left_label_triangle"
            android:layout_width="8dp"
            android:layout_height="8dp"
            app:srcCompat="@drawable/bg_left_label_triangle"/>
    </LinearLayout>
</RelativeLayout>
