<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp">
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_close"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/filter"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/iv_close"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/grayE5"
            android:id="@+id/tv_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/clear"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="24dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/view"
        android:background="@color/grayE5"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/colorText_Black_Alpha_99"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/status_caps"
        android:layout_marginStart="24dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="100dp"/>
    <RadioGroup
        android:id="@+id/rg_filters"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        android:layout_marginStart="24dp">
        <RadioButton
            android:textSize="16sp"
            android:id="@+id/rb_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/layout_status_filter_bottom_sheet_rb_all_text"
            android:layoutDirection="rtl"
            android:layout_marginStart="20dp"/>
        <RadioButton
            android:textSize="16sp"
            android:id="@+id/rb_submitted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layout_status_filter_bottom_sheet_rb_submitted_text"
            android:layoutDirection="rtl"
            android:layout_marginStart="20dp"/>
        <RadioButton
            android:textSize="16sp"
            android:id="@+id/rb_pending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layout_status_filter_bottom_sheet_rb_pending_text"
            android:layoutDirection="rtl"
            android:layout_marginStart="20dp"/>
        <RadioButton
            android:textSize="16sp"
            android:id="@+id/rb_notSubmitted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layout_status_filter_bottom_sheet_rb_notSubmitted_text"
            android:layoutDirection="rtl"
            android:layout_marginStart="20dp"/>
        <RadioButton
            android:textSize="16sp"
            android:id="@+id/rb_rejected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layout_status_filter_bottom_sheet_rb_rejected_text"
            android:layoutDirection="rtl"
            android:layout_marginStart="20dp"/>
        <RadioButton
            android:textSize="16sp"
            android:id="@+id/rb_approved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layout_status_filter_bottom_sheet_rb_approved_text"
            android:layoutDirection="rtl"
            android:layout_marginStart="20dp"/>
    </RadioGroup>
    <View
        android:background="@color/grayE5"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_apply"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_apply"
            android:background="@drawable/bg_button_click_color_primary"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/apply"
            android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
