<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#efefef"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@drawable/bg_primary_color_gradient"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <ScrollView
        android:id="@+id/layout_structure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/ll_create_installments"
        android:layout_below="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/llEzCreditLearnMore"
                android:visibility="gone"
                layout="@layout/layout_ezcredit_learn_more"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/structure_name"
                android:textAllCaps="true"/>
            <LinearLayout
                android:background="@color/white"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:gravity="start|center_vertical"
                    android:id="@+id/et_template_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="30"
                    android:inputType="textCapSentences"
                    android:imeOptions="actionNext"
                    android:backgroundTint="@android:color/transparent"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/fee_amount"
                android:textAllCaps="true"/>
            <LinearLayout
                android:background="@color/white"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:gravity="start|center_vertical"
                    android:id="@+id/et_fee_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="7"
                    android:inputType="number"
                    android:imeOptions="actionNext"
                    android:backgroundTint="@android:color/transparent"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/tax"
                android:textAllCaps="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_tax_option"
                android:background="@color/white"
                android:paddingLeft="20dp"
                android:paddingTop="10dp"
                android:paddingRight="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_tax_option"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="8"
                    android:textAllCaps="true"/>
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:tint="@color/colorPrimary"
                    android:layout_weight="1"
                    app:srcCompat="@drawable/ic_chevron_down"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/total_amount"
                android:textAllCaps="true"/>
            <LinearLayout
                android:background="@color/white"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_total_amount"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@android:color/transparent"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/no_of_instalments"
                android:textAllCaps="true"/>
            <LinearLayout
                android:background="@color/white"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:gravity="start|center_vertical"
                    android:id="@+id/et_num_installments"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="2"
                    android:digits="1234567890"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    android:backgroundTint="@android:color/transparent"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llEzCreditContainer"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorSecondaryText"
                        android:paddingTop="20dp"
                        android:paddingBottom="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:text="@string/easy_emi_option"
                        android:layout_weight="1"
                        android:textAllCaps="true"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorPrimary"
                        android:gravity="end"
                        android:id="@+id/tvEmiSchemes"
                        android:paddingTop="20dp"
                        android:paddingBottom="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20dp"
                        android:text="@string/view_emi_schemes"
                        android:layout_weight="1"
                        android:textAllCaps="true"/>
                </LinearLayout>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="0dp"
                    app:cardElevation="1dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ll_checkbox_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <CheckBox
                            android:id="@+id/cbAllowEzCred"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:text="@string/allow_students_to_pay_via"
                            android:layout_marginStart="16dp"/>
                        <ImageView
                            android:id="@+id/ivEzcredit"
                            android:background="@drawable/bg_ezcred"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:textSize="12sp"
                    android:id="@+id/tvEzCredStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/not_applicable_on_fee_less_than_15000"
                    android:layout_marginStart="16dp"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/auto_fee_generation_for_online_courses"
                android:textAllCaps="true"/>
            <androidx.appcompat.widget.SwitchCompat
                android:textSize="18sp"
                android:textColor="@color/colorPrimaryText"
                android:id="@+id/sw_auto_fee_structure"
                android:background="@color/white"
                android:paddingLeft="15dp"
                android:paddingTop="10dp"
                android:paddingRight="15dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/activity_fee_structure_sw_auto_fee_structure_text"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/batches_associated"
                android:textAllCaps="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_batches"
                android:background="@color/white"
                android:paddingLeft="20dp"
                android:paddingTop="10dp"
                android:paddingRight="20dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_batches"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="8"
                    android:textAllCaps="true"/>
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:tint="@color/colorPrimary"
                    android:layout_weight="1"
                    app:srcCompat="@drawable/ic_chevron_right"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:id="@+id/tv_installment_number_label"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/activity_fee_structure_tv_installment_number_label_text"
                android:textAllCaps="true"/>
            <Spinner
                android:id="@+id/spinner_installment_number"
                android:background="@color/white"
                android:paddingLeft="15dp"
                android:paddingTop="5dp"
                android:paddingRight="15dp"
                android:paddingBottom="5dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:spinnerMode="dropdown"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="30dp"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_create_installments"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_create_installments"
            android:background="@drawable/bg_button_click_color_primary"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/activity_fee_structure_btn_create_installments_text"
            android:textAllCaps="false"/>
    </LinearLayout>
</RelativeLayout>
