<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_view_container"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp"
    app:shimmer_duration="800">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/cardView3"
                android:background="#52000000"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_74sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginStart="@dimen/_16sdp"
                android:elevation="0dp"
                app:cardCornerRadius="@dimen/_6sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <View
                    android:id="@+id/ivContentPreview"
                    android:background="#52000000"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_74sdp"
                    android:scaleType="centerInside"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/ivPlayIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_play_video_free_content"/>
                <View
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/tvDuration"
                    android:visibility="visible"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_margin="@dimen/_2sdp"/>
            </androidx.cardview.widget.CardView>
            <View
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tvContTitle"
                android:background="#52000000"
                android:layout_width="212dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginEnd="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/cardView3"
                app:layout_constraintTop_toTopOf="@+id/cardView3"/>
            <View
                android:id="@+id/tvContSubHeading"
                android:background="#52000000"
                android:layout_width="212dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                app:autoSizeTextType="uniform"
                app:layout_constraintStart_toStartOf="@+id/tvContTitle"
                app:layout_constraintTop_toBottomOf="@+id/tvContTitle"/>
            <View
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:id="@+id/tvViewCourse"
                android:background="#52000000"
                android:layout_width="74dp"
                android:layout_height="18dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/cardView3"
                app:layout_constraintStart_toStartOf="@+id/tvContTitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/cardView31"
                android:background="#52000000"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_74sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginStart="@dimen/_16sdp"
                android:elevation="0dp"
                app:cardCornerRadius="@dimen/_6sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <View
                    android:id="@+id/ivContentPreview1"
                    android:background="#52000000"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_74sdp"
                    android:scaleType="centerInside"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/ivPlayIcon1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_play_video_free_content"/>
                <View
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/tvDuration1"
                    android:visibility="visible"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_margin="@dimen/_2sdp"/>
            </androidx.cardview.widget.CardView>
            <View
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tvContTitle1"
                android:background="#52000000"
                android:layout_width="212dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginEnd="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/cardView31"
                app:layout_constraintTop_toTopOf="@+id/cardView31"/>
            <View
                android:id="@+id/tvContSubHeading1"
                android:background="#52000000"
                android:layout_width="212dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                app:autoSizeTextType="uniform"
                app:layout_constraintStart_toStartOf="@+id/tvContTitle1"
                app:layout_constraintTop_toBottomOf="@+id/tvContTitle1"/>
            <View
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:id="@+id/tvViewCourse1"
                android:background="#52000000"
                android:layout_width="74dp"
                android:layout_height="18dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/cardView31"
                app:layout_constraintStart_toStartOf="@+id/tvContTitle1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
