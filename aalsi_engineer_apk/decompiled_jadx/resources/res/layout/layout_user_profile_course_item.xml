<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="0dp"
    app:cardElevation="1dp">
    <RelativeLayout
        android:id="@+id/rv_main"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_thumbnail"
            android:background="@drawable/shape_rectangle_rounded_corners"
            android:layout_width="120dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_toLeftOf="@+id/ivOptions"
            android:layout_toRightOf="@+id/iv_thumbnail"
            android:layout_marginStart="16dp"
            android:layout_toStartOf="@+id/ivOptions"
            android:layout_toEndOf="@+id/iv_thumbnail">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorPrimaryText"
                android:ellipsize="end"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_toRightOf="@+id/iv_thumbnail"
            android:layout_below="@+id/ll_title"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@+id/iv_thumbnail">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llEnrollDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#99000000"
                    android:id="@+id/tvEnrollDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/layout_user_profile_course_item_tvEnrollDate_text"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#99000000"
                    android:id="@+id/tvEnrollDateValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llExpiryDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#99000000"
                    android:id="@+id/tvExpiryDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/layout_user_profile_course_item_tvExpiryDate_text"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#99000000"
                    android:id="@+id/tvExpiryDateValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/ivOptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tint="#666666"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_dots"/>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
