<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light"
        app:theme="@style/ThemeOverlay.AppCompat.Dark"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/black"
        android:id="@+id/tvBanner"
        android:background="@drawable/bg_blue_corner_radius_2"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/activity_add_edit_parent_tvBanner_text"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="2dp">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#000000"
                        android:id="@+id/tv_label_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/parent_name"
                        android:layout_marginStart="56dp"/>
                    <TextView
                        android:textColor="@color/red3"
                        android:id="@+id/mandatory_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/item_info_field_edit_mandatoryTitle_text"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="16dp">
                    <ImageView
                        android:id="@+id/iv_icon_name"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:tint="#99000000"
                        android:layout_marginEnd="16dp"
                        app:srcCompat="@drawable/ic_user_vector"/>
                    <androidx.appcompat.widget.AppCompatEditText
                        android:layout_gravity="center_vertical"
                        android:id="@+id/etName"
                        android:background="@drawable/shape_rectangle_gray_outline_r2"
                        android:paddingLeft="@dimen/ayp_16dp"
                        android:paddingTop="@dimen/ayp_12dp"
                        android:paddingRight="@dimen/ayp_16dp"
                        android:paddingBottom="@dimen/ayp_12dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:imeOptions="actionDone"
                        style="@style/BaseTextAppearance.Title"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#000000"
                        android:id="@+id/tv_label_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/parent_mobile_number"
                        android:layout_marginStart="56dp"/>
                    <TextView
                        android:textColor="@color/red3"
                        android:id="@+id/mandatory_number"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/item_info_field_edit_mandatoryTitle_text"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="16dp">
                    <ImageView
                        android:id="@+id/iv_icon_number"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginRight="16dp"
                        android:tint="#99000000"
                        android:layout_marginEnd="16dp"
                        app:srcCompat="@drawable/ic_phone"/>
                    <androidx.appcompat.widget.AppCompatEditText
                        android:layout_gravity="center_vertical"
                        android:id="@+id/etNumber"
                        android:background="@drawable/shape_rectangle_gray_outline_r2"
                        android:paddingLeft="@dimen/ayp_16dp"
                        android:paddingTop="@dimen/ayp_12dp"
                        android:paddingRight="@dimen/ayp_16dp"
                        android:paddingBottom="@dimen/ayp_12dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:imeOptions="actionDone"
                        style="@style/BaseTextAppearance.Title"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#000000"
                        android:id="@+id/tv_label_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="56dp"
                        android:text="@string/parent_email_id"
                        android:layout_marginStart="56dp"/>
                    <TextView
                        android:textColor="@color/red3"
                        android:id="@+id/mandatory_email"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/item_info_field_edit_mandatoryTitle_text"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="16dp">
                    <ImageView
                        android:id="@+id/iv_icon_emal"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginEnd="16dp"
                        app:srcCompat="@drawable/ic_mail_new"
                        app:tint="#99000000"/>
                    <androidx.appcompat.widget.AppCompatEditText
                        android:layout_gravity="center_vertical"
                        android:id="@+id/etEmail"
                        android:background="@drawable/shape_rectangle_gray_outline_r2"
                        android:paddingLeft="@dimen/ayp_16dp"
                        android:paddingTop="@dimen/ayp_12dp"
                        android:paddingRight="@dimen/ayp_16dp"
                        android:paddingBottom="@dimen/ayp_12dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:inputType="textEmailAddress"
                        android:imeOptions="actionDone"
                        style="@style/BaseTextAppearance.Title"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/llAddFromContacts"
                android:background="@drawable/bg_parent_dash"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="16dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:tint="@color/colorPrimary"
                    app:srcCompat="@drawable/ic_add_circle_outline"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/colorPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/add_from_contacts"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginRight="16dp"
                android:layout_marginEnd="16dp">
                <Button
                    android:textColor="@color/white"
                    android:id="@+id/btnSave"
                    android:background="@drawable/bg_button_click_color_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/save"
                    android:layout_marginEnd="16dp"
                    style="?android:attr/borderlessButtonStyle"/>
                <Button
                    android:id="@+id/btnCancel"
                    android:background="@drawable/bg_button_click_color_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="@string/cancel"
                    android:backgroundTint="#f7f7f7"
                    style="?android:attr/borderlessButtonStyle"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
