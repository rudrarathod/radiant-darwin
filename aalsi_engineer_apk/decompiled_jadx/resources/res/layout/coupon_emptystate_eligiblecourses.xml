<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/coupons_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/courses_empty_imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/coupon_no_course_assigned"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_black_87_opacity"
        android:id="@+id/courses_empty_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ayp_16dp"
        android:text="@string/coupon_emptystate_eligiblecourses_courses_empty_title_text_text"
        android:singleLine="true"
        android:lineSpacingExtra="3sp"
        android:textAlignment="center"/>
    <TextView
        android:textAppearance="@style/empty_subhead"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/courses__empty_subtitle_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/coupon_emptystate_eligiblecourses_courses__empty_subtitle_text_text"
        android:lineSpacingExtra="4sp"
        android:alpha="0.6"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
    <Button
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/empty_button"
        android:background="@color/intercom_composer_blue"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/coupon_emptystate_eligiblecourses_empty_button_text"
        android:lineSpacingExtra="5sp"
        android:textAllCaps="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"/>
</LinearLayout>
