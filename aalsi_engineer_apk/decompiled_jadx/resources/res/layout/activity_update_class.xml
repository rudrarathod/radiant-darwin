<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/grayF1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@drawable/bg_primary_color_gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:title="Edit Class"
        app:titleTextColor="@color/white"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ll_btn_done"
        android:layout_below="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/subject_label"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/select_subject"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_select_subject"
                android:background="@color/white"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="46dp">
                <TextView
                    android:textColor="@color/color_666666"
                    android:ellipsize="end"
                    android:id="@+id/tv_select_subject"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_subject"
                    android:maxLines="1"
                    android:layout_weight="1"
                    style="@style/BaseTextAppearance.Title"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tint="@color/black"
                    app:srcCompat="@drawable/ic_chevron_right"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tv_class_name_label"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/class_name"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginEnd="16dp"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_class_name"
                android:background="@color/white"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="46dp">
                <EditText
                    android:textColor="@color/color_DE000000"
                    android:ellipsize="end"
                    android:id="@+id/tv_class_name"
                    android:background="@color/white"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/enter_class_name"
                    android:maxLines="1"
                    android:layout_weight="1"
                    style="@style/BaseTextAppearance.Title"/>
            </LinearLayout>
            <TextView
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/select_faculty"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_select_faculty"
                android:background="@color/white"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="46dp">
                <TextView
                    android:textColor="@color/color_666666"
                    android:ellipsize="end"
                    android:id="@+id/tv_select_faculty"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_faculty"
                    android:maxLines="1"
                    android:layout_weight="1"
                    style="@style/BaseTextAppearance.Title"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_chevron_right"
                    app:tint="@color/black"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tv_date_label"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/date"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginEnd="16dp"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_select_date"
                android:background="@color/white"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="46dp">
                <TextView
                    android:textColor="@color/color_DE000000"
                    android:ellipsize="end"
                    android:id="@+id/tv_select_date"
                    android:background="@color/white"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/select_date"
                    android:maxLines="1"
                    android:layout_weight="1"
                    style="@style/BaseTextAppearance.Title"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_one_time_class_calendar"/>
            </LinearLayout>
            <TextView
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/class_start_time"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_start_date"
                android:background="@color/white"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_start_date"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:hint="@string/click_to_select_select"
                    android:maxLines="1"
                    android:layout_weight="1"
                    style="@style/BaseTextAppearance.Title"/>
                <ImageView
                    android:layout_width="@dimen/ayp_16dp"
                    android:layout_height="@dimen/ayp_16dp"
                    android:tint="@color/color_666666"
                    app:srcCompat="@drawable/clock_white"/>
            </LinearLayout>
            <TextView
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/class_end_time"
                style="@style/BaseTextAppearance.UpperCaseTitle"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_end_date"
                android:background="@color/white"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_end_date"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:hint="@string/click_to_select_select"
                    android:maxLines="1"
                    android:layout_weight="1"
                    style="@style/BaseTextAppearance.Title"/>
                <ImageView
                    android:layout_width="@dimen/ayp_16dp"
                    android:layout_height="@dimen/ayp_16dp"
                    android:tint="@color/color_666666"
                    app:srcCompat="@drawable/clock_white"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.card.MaterialCardView
        android:orientation="vertical"
        android:id="@+id/ll_btn_done"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/b_done"
            android:background="@drawable/bg_button_click_color_primary"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/done"
            android:textAllCaps="false"/>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>
