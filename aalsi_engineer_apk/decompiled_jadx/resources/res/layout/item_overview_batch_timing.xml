<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_rectangle_gray_outline_r8"
    android:layout_width="224dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="2dp"
    app:cardElevation="0dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/ayp_16dp"
        android:layout_marginRight="4dp"
        android:layout_marginEnd="4dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_282828"
            android:ellipsize="end"
            android:id="@+id/tvHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:maxEms="8"
            android:scrollHorizontally="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_timimgs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ayp_8dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="fitXY"
                android:tint="@color/color_777777"
                app:srcCompat="@drawable/ic_clock_time"/>
            <TextView
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/tv_timings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="9dp"
                android:text="@string/_11_09_2019"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                style="@style/BaseTextAppearance.ShadowTitle"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_Date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_tutor_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#777777"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/tv_tutor_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="9dp"
                android:text="@string/_11_09_2019"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="9dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
