<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/assignment_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:layout_above="@+id/ll_btn_done"
        android:layout_alignParentTop="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorText_Black_Alpha_99"
                android:paddingTop="16dp"
                android:paddingBottom="11dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/assign_to"
                android:textAllCaps="true"
                android:layout_marginStart="16dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="10dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#66000000"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/to"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_students"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:enabled="true"
                        android:textSize="13sp"
                        android:textColor="@color/white"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_selected"
                        android:background="@drawable/shape_rectangle_filled_light_blue_r2_borderless_new"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:focusable="true"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/all_students"
                        android:maxLines="1"
                        android:textAllCaps="true"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/iv_add_recipient"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:tint="@color/colorPrimary"
                    app:srcCompat="@drawable/ic_add_circle_outline"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorText_Black_Alpha_99"
                android:paddingTop="16dp"
                android:paddingBottom="11dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/topic"
                android:textAllCaps="true"
                android:layout_marginStart="16dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <EditText
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:textColorHint="#66000000"
                    android:gravity="start|center_vertical"
                    android:id="@+id/et_topic"
                    android:background="@null"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/fragment_homework_create_et_topic_hint"
                    android:maxLines="1"
                    android:inputType="textCapSentences"
                    android:imeOptions="actionNext"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorText_Black_Alpha_99"
                android:id="@+id/tv_start_date_label"
                android:paddingTop="16dp"
                android:paddingBottom="11dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/submission_start_date"
                android:textAllCaps="true"
                android:layout_marginStart="16dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_start_date_time"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:textColorHint="#66000000"
                    android:ellipsize="end"
                    android:id="@+id/tv_start_date_time"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_start_date_here"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="@color/button_color"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_change_start_date"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/change"
                    android:paddingStart="14dp"
                    android:paddingEnd="0dp"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorText_Black_Alpha_99"
                android:paddingTop="16dp"
                android:paddingBottom="11dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/submission_deadline"
                android:textAllCaps="true"
                android:layout_marginStart="16dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_date_time"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:textColorHint="#66000000"
                    android:ellipsize="end"
                    android:id="@+id/tv_submission_date_time"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/fragment_homework_create_tv_submission_date_time_hint"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="@color/button_color"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_change_deadline"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/change"
                    android:paddingStart="14dp"
                    android:paddingEnd="0dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/white"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp">
                <CheckBox
                    android:id="@+id/cb_late_submission"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:checked="false"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_late_submission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fragment_homework_create_tv_late_submission_text"
                    android:layout_marginStart="8dp"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_info_late"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="8dp"
                    app:srcCompat="@drawable/information_circular_button_symbol__1_"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorText_Black_Alpha_99"
                android:paddingTop="16dp"
                android:paddingBottom="11dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notes"
                android:textAllCaps="true"
                android:layout_marginStart="16dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <EditText
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:textColorHint="#66000000"
                    android:gravity="start|top"
                    android:id="@+id/et_notes"
                    android:background="@null"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:hint="@string/fragment_homework_create_et_notes_hint"
                    android:maxLines="4"
                    android:imeOptions="actionGo"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_attach"
                android:background="@color/white"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.5dp">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_attachment_tilted"
                    android:tint="#777777"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/add_attachment_s"
                    android:layout_weight="1"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_attachments_docs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_attachments_photos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_attachments_audio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorText_Black_Alpha_99"
                android:paddingTop="16dp"
                android:paddingBottom="11dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sms_notif_caps"
                android:textAllCaps="true"
                android:layout_marginStart="16dp"/>
            <RelativeLayout
                android:background="@color/white"
                android:paddingTop="16dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="16dp">
                <CheckBox
                    android:id="@+id/cb_send_sms_homework"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:checked="true"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_send_sms_homework"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fragment_homework_create_tv_send_sms_homework_text"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@+id/cb_send_sms_homework"/>
            </RelativeLayout>
            <RelativeLayout
                android:background="@color/white"
                android:paddingTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp">
                <CheckBox
                    android:id="@+id/cb_send_sms_deadline"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginBottom="16dp"
                    android:checked="false"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_send_sms_deadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/fragment_homework_create_tv_send_sms_deadline_text"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@+id/cb_send_sms_deadline"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_btn_done"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/b_done"
            android:background="@drawable/bg_button_click_color_primary"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/done_caps"
            android:textAllCaps="false"/>
    </LinearLayout>
    <include
        android:visibility="gone"
        layout="@layout/common_progressbar"/>
</RelativeLayout>
