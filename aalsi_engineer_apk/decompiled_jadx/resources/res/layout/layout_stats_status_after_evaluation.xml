<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_subjective_test_post_eval"
    android:background="@color/white"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="6dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="12sp"
            android:id="@+id/tvYourScoreLabel"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:text="@string/your_score"
            app:layout_constraintStart_toStartOf="@+id/left_guide"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/left_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="16dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/right_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="16dp"/>
        <TextView
            android:textSize="12sp"
            android:id="@+id/tvHighestScoreLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/highest_score"
            android:layout_marginStart="128dp"
            app:layout_constraintStart_toEndOf="@+id/tvYourScoreLabel"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="24sp"
            android:textStyle="normal"
            android:textColor="@color/black"
            android:id="@+id/tvScoreValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60.0"
            app:layout_constraintBaseline_toBaselineOf="@+id/tvScoreMaxValue"
            app:layout_constraintStart_toStartOf="@+id/left_guide"/>
        <TextView
            android:textSize="12sp"
            android:id="@+id/tvYourGradeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="65dp"
            android:text="@string/your_grade"
            app:layout_constraintStart_toStartOf="@+id/left_guide"
            app:layout_constraintTop_toBottomOf="@+id/tvYourScoreLabel"/>
        <TextView
            android:textSize="24sp"
            android:textStyle="normal"
            android:textColor="@color/black"
            android:id="@+id/tvYourGradeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="B"
            app:layout_constraintStart_toStartOf="@+id/left_guide"
            app:layout_constraintTop_toBottomOf="@+id/tvYourGradeLabel"/>
        <TextView
            android:textSize="13sp"
            android:id="@+id/tvHighestScoreMaxValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/100"
            android:layout_marginStart="8dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/tvHighestScoreValue"
            app:layout_constraintStart_toEndOf="@+id/tvHighestScoreValue"/>
        <TextView
            android:textSize="12sp"
            android:id="@+id/tvYourRankLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="65dp"
            android:text="@string/your_rank"
            app:layout_constraintStart_toStartOf="@+id/tvHighestScoreLabel"
            app:layout_constraintTop_toBottomOf="@+id/tvHighestScoreLabel"/>
        <TextView
            android:textSize="24sp"
            android:textStyle="normal"
            android:textColor="@color/black"
            android:id="@+id/tvYourRankValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="3"
            app:layout_constraintStart_toStartOf="@+id/tvYourRankLabel"
            app:layout_constraintTop_toBottomOf="@+id/tvYourRankLabel"/>
        <TextView
            android:textSize="13sp"
            android:id="@+id/tvScoreMaxValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="/100"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/tvScoreValue"
            app:layout_constraintTop_toBottomOf="@+id/tvYourScoreLabel"/>
        <TextView
            android:textSize="24sp"
            android:textStyle="normal"
            android:textColor="@color/black"
            android:id="@+id/tvHighestScoreValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="82.0"
            app:layout_constraintStart_toStartOf="@+id/tvHighestScoreLabel"
            app:layout_constraintTop_toBottomOf="@+id/tvHighestScoreLabel"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="12sp"
            android:textColor="@color/colorPrimary"
            android:layout_gravity="center"
            android:id="@+id/btnViewLeaderBoard"
            android:layout_width="155dp"
            android:layout_height="0dp"
            android:text="@string/label_view_leaderboard"
            android:textAllCaps="false"
            app:chainUseRtl="true"
            app:cornerRadius="6dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/btnViewAnswerSheet"
            app:layout_constraintEnd_toStartOf="@+id/btnViewAnswerSheet"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:strokeColor="@color/colorPrimary"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        <Button
            android:textSize="12sp"
            android:gravity="center"
            android:id="@+id/btnViewAnswerSheet"
            android:background="@drawable/bg_button_click_color_primary"
            android:layout_width="155dp"
            android:layout_height="38dp"
            android:layout_marginTop="70dp"
            android:text="@string/view_answer_sheet"
            android:textAllCaps="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toEndOf="@+id/btnViewLeaderBoard"
            app:layout_constraintTop_toBottomOf="@+id/tvYourGradeLabel"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/rankViewsGroup"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="btnViewLeaderBoard,tvYourRankLabel,tvYourRankValue"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
