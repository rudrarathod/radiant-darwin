<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/ayp_4dp"
    android:layout_marginBottom="@dimen/ayp_4dp"
    app:cardCornerRadius="2dp"
    app:cardElevation="2dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ayp_16dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="@dimen/ayp_16dp"
        android:layout_marginStart="@dimen/ayp_16dp"
        android:layout_marginEnd="4dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_282828"
                android:ellipsize="end"
                android:id="@+id/tvHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:maxEms="8"
                android:scrollHorizontally="true"
                android:layout_weight="1"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_more"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="center"
                android:tint="@color/color_777777"
                android:layout_marginEnd="2dp"
                app:srcCompat="@drawable/ic_dots"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_Date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_tutor_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#777777"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/tv_tutor_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="9dp"
                android:text="@string/_11_09_2019"
                android:maxLines="1"
                android:layout_marginStart="9dp"/>
            <LinearLayout
                android:gravity="end|center_vertical"
                android:id="@+id/ll_timimgs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:scaleType="fitXY"
                    android:tint="@color/color_777777"
                    app:srcCompat="@drawable/ic_clock_time"/>
                <TextView
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/tv_timings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="9dp"
                    android:text="@string/_11_09_2019"
                    android:maxLines="1"
                    android:layout_marginStart="9dp"
                    style="@style/BaseTextAppearance.ShadowTitle"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
