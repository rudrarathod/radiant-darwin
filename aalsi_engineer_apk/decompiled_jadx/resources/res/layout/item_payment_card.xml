<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/shape_rectangle_gray_outline_white_filled_r4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="#000000"
                        android:ellipsize="end"
                        android:id="@+id/heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/ayp_16dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/item_payment_card_heading_text"
                        android:maxLines="1"
                        android:maxEms="8"
                        android:layout_alignParentLeft="@+id/labels"/>
                    <RelativeLayout
                        android:gravity="center_vertical"
                        android:id="@+id/labels"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/ayp_16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="@dimen/ayp_16dp"
                        android:layout_alignParentRight="true"
                        android:layout_marginEnd="@dimen/ayp_16dp"
                        android:layout_alignParentEnd="true">
                        <TextView
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/emblem1"
                            android:paddingLeft="8dp"
                            android:paddingTop="5dp"
                            android:paddingRight="8dp"
                            android:paddingBottom="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:textAllCaps="true"
                            android:textAlignment="center"
                            android:layout_marginStart="8dp"/>
                        <LinearLayout
                            android:id="@+id/ll_threedots"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_toRightOf="@+id/emblem1"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@+id/emblem1">
                            <ImageView
                                android:visibility="visible"
                                android:layout_width="14dp"
                                android:layout_height="8dp"
                                app:srcCompat="@drawable/three_dots"/>
                        </LinearLayout>
                    </RelativeLayout>
                </RelativeLayout>
                <TextView
                    android:id="@+id/subHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/item_payment_card_subHeading_text"
                    android:drawableBottom="#777777"/>
            </LinearLayout>
            <View
                android:id="@+id/divider2"
                android:background="#e5e5e5"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="25">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ayp_16dp"
                    android:layout_marginBottom="@dimen/ayp_16dp"
                    android:layout_weight="12.5">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="12.5">
                        <TextView
                            android:textSize="12sp"
                            android:id="@+id/heading1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/ayp_16dp"
                            android:text="@string/total_amount"
                            android:maxLines="1"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#de000000"
                        android:id="@+id/subHeading1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/ayp_16dp"
                        android:layout_marginTop="@dimen/ayp_8dp"
                        android:drawableRight="#777777"/>
                </LinearLayout>
                <View
                    android:id="@+id/divider3"
                    android:background="#e5e5e5"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="12.5">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="16dp"
                        android:layout_weight="12.5">
                        <TextView
                            android:textSize="12sp"
                            android:id="@+id/heading2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/ayp_16dp"
                            android:layout_marginStart="@dimen/ayp_16dp"/>
                        <TextView
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:layout_gravity="center"
                            android:id="@+id/emblem2"
                            android:padding="2dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="14dp"
                            android:layout_marginRight="12dp"
                            android:textAlignment="center"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="12dp"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#de000000"
                        android:id="@+id/subHeading2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/ayp_16dp"
                        android:layout_marginTop="@dimen/ayp_8dp"
                        android:layout_marginBottom="18dp"
                        android:layout_marginStart="@dimen/ayp_16dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
