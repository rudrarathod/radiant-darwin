<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_rectangle_filled_color_white_r16"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_14sdp"
    android:layout_marginStart="@dimen/_14sdp"
    android:clipToOutline="true">
    <ScrollView
        android:background="@drawable/shape_rectangle_filled_light_black_r16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ivOptionClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_14sdp"
                android:src="@drawable/ic_cross_close_new_white"
                android:contentDescription="@string/app_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvWidthValue"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tvWidth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_14sdp"
                android:text="@string/width"
                android:lines="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvHeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_14sdp"
                android:text="@string/height"
                android:lines="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvWidth"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvFps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_14sdp"
                android:text="@string/fps"
                android:lines="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvHeight"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvBitrateV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_14sdp"
                android:text="@string/bitrate_v"
                android:lines="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvFps"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvBitrateA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_14sdp"
                android:text="@string/bitrate_a"
                android:lines="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvBitrateV"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvDownLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_14sdp"
                android:text="@string/downlink"
                android:lines="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvBitrateA"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvJitterV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_14sdp"
                android:text="@string/jitter_v"
                android:lines="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDownLink"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvJitterA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_14sdp"
                android:text="@string/jitter_a"
                android:lines="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvJitterV"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvPacketsLostV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_14sdp"
                android:text="@string/packets_lost_a"
                android:lines="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvJitterA"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvPacketsLostA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_14sdp"
                android:text="@string/packets_lost_v"
                android:lines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvPacketsLostV"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvWidthValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:lines="1"
                android:layout_marginStart="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvWidth"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvHeightValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:lines="1"
                app:layout_constraintStart_toStartOf="@+id/tvWidthValue"
                app:layout_constraintTop_toBottomOf="@+id/tvWidthValue"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvFPSValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:lines="1"
                app:layout_constraintStart_toStartOf="@+id/tvHeightValue"
                app:layout_constraintTop_toBottomOf="@+id/tvHeightValue"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvBitrateVValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:lines="1"
                app:layout_constraintStart_toStartOf="@+id/tvFPSValue"
                app:layout_constraintTop_toBottomOf="@+id/tvFPSValue"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvBitrateAValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:lines="1"
                app:layout_constraintStart_toStartOf="@+id/tvBitrateVValue"
                app:layout_constraintTop_toBottomOf="@+id/tvBitrateVValue"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvDownLinkValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:lines="1"
                app:layout_constraintStart_toStartOf="@+id/tvBitrateAValue"
                app:layout_constraintTop_toBottomOf="@+id/tvBitrateAValue"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvJitterVValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:lines="1"
                app:layout_constraintStart_toStartOf="@+id/tvDownLinkValue"
                app:layout_constraintTop_toBottomOf="@+id/tvDownLinkValue"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvJitterAValue"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:lines="1"
                app:layout_constraintStart_toStartOf="@+id/tvJitterVValue"
                app:layout_constraintTop_toBottomOf="@+id/tvJitterVValue"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvPacketsLostAValue"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:lines="1"
                app:layout_constraintStart_toStartOf="@+id/tvJitterAValue"
                app:layout_constraintTop_toBottomOf="@+id/tvJitterAValue"
                style="@style/nunito_sans_regular_14_white_regular"/>
            <TextView
                android:id="@+id/tvPacketsLostVValue"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:lines="1"
                app:layout_constraintStart_toStartOf="@+id/tvPacketsLostAValue"
                app:layout_constraintTop_toBottomOf="@+id/tvPacketsLostAValue"
                style="@style/nunito_sans_regular_14_white_regular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
