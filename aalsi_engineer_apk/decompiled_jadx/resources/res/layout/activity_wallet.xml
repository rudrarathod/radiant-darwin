<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llMain"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@color/colorPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="4dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="16dp">
                <TextView
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_available_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"/>
                <TextView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/available_wallet_balance"/>
                <View
                    android:id="@+id/divider"
                    android:background="@color/grayE5"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/tv_add"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/add_wallet"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/tv_select"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/select_amount"/>
                <FrameLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:id="@+id/et_amount"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:inputType="numberDecimal"
                        android:backgroundTint="@color/grayE5">
                        <requestFocus/>
                    </EditText>
                    <TextView
                        android:textSize="16sp"
                        android:gravity="end"
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/tv_clear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/clear_non_caps"
                        android:paddingEnd="6dp"/>
                </FrameLayout>
                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/fl_add_default"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:justifyContent="space_between">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/btn_add_1"
                        android:background="@drawable/shape_rectangle_filled_white_outline_blue_r5"
                        android:padding="8dp"
                        android:layout_width="105dp"
                        android:layout_height="36dp"
                        android:foreground="?attr/selectableItemBackground"
                        android:text="@string/plus_thousand"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/btn_add_2"
                        android:background="@drawable/shape_rectangle_filled_white_outline_blue_r5"
                        android:padding="8dp"
                        android:layout_width="105dp"
                        android:layout_height="36dp"
                        android:layout_marginLeft="12dp"
                        android:layout_marginRight="12dp"
                        android:foreground="?attr/selectableItemBackground"
                        android:text="@string/plus_five_thousand"
                        android:layout_marginHorizontal="12dp"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/btn_add_3"
                        android:background="@drawable/shape_rectangle_filled_white_outline_blue_r5"
                        android:padding="8dp"
                        android:layout_width="105dp"
                        android:layout_height="36dp"
                        android:foreground="?attr/selectableItemBackground"
                        android:text="@string/plus_ten_thousand"/>
                </com.google.android.flexbox.FlexboxLayout>
                <View
                    android:id="@+id/divider2"
                    android:background="@color/gray74"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"/>
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:id="@+id/btn_add"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_money"
                    android:textAllCaps="false"
                    android:paddingVertical="10dp"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/ll_transaction_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorPrimary"
                        android:layout_gravity="center"
                        android:id="@+id/tv_transaction_history"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/view_transaction_history"/>
                    <View
                        android:background="@color/colorPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/llWarning"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="#eab14d"
            app:cardCornerRadius="4dp">
            <LinearLayout
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:srcCompat="@drawable/ic_payment_processing"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/payment_processing"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/grayF2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_processing_warning"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <include
        android:id="@+id/llProgress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/payment_progress_layout"/>
</LinearLayout>
