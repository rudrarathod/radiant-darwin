<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:tag="layout/item_header_bundle_layout_0"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_777777"
        android:id="@+id/textView"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:layout_marginStart="@dimen/ayp_16dp"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#ffffff"
        android:gravity="center_vertical"
        android:id="@+id/tvEmblem"
        android:tag="binding_2"
        android:background="#ff5454"
        android:paddingLeft="@dimen/ayp_8dp"
        android:paddingTop="@dimen/ayp_2dp"
        android:paddingRight="@dimen/ayp_8dp"
        android:paddingBottom="@dimen/ayp_2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ayp_8dp"
        android:textAllCaps="true"/>
</LinearLayout>
