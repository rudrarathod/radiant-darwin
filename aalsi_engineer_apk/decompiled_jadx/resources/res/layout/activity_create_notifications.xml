<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gray91"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@drawable/bg_primary_color_gradient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
        <ScrollView
            android:id="@+id/scroll_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/gray91"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/text_recipients"
                    android:textAllCaps="true"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_select_recipients"
                    android:background="@color/white"
                    android:paddingLeft="20dp"
                    android:paddingRight="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="10dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_to"
                        android:textAllCaps="true"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:orientation="horizontal"
                        android:id="@+id/rv_recipients"
                        android:paddingLeft="5dp"
                        android:paddingTop="10dp"
                        android:paddingRight="5dp"
                        android:paddingBottom="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                    <ImageView
                        android:id="@+id/iv_add_recipient"
                        android:paddingLeft="5dp"
                        android:paddingRight="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:tint="@color/colorPrimary"
                        app:srcCompat="@drawable/ic_add_circle_outline"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/title"
                    android:textAllCaps="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:paddingLeft="20dp"
                    android:paddingTop="5dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:gravity="start|center_vertical"
                        android:id="@+id/et_notification_title"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/activity_create_notifications_et_notification_title_hint"
                        android:maxLines="1"
                        android:maxLength="50"
                        android:inputType="textCapSentences"
                        android:imeOptions="actionNext"
                        android:backgroundTint="@android:color/transparent"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorSecondaryText"
                        android:paddingTop="20dp"
                        android:paddingBottom="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:text="@string/text"
                        android:layout_weight="1"
                        android:textAllCaps="true"
                        android:layout_marginStart="20dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/color_99000000"
                        android:id="@+id/sms_unit_info_tv"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:text="@string/activity_create_notifications_sms_unit_info_tv_text"
                        android:drawablePadding="@dimen/ayp_4dp"
                        android:drawableStart="@drawable/information_circular_button_symbol__1_"
                        android:layout_marginEnd="10dp"/>
                    <com.github.lzyzsd.circleprogress.DonutProgress
                        android:id="@+id/donut_progress"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginBottom="10dp"
                        android:layout_marginEnd="16dp"
                        app:donut_background_color="@color/gray91"
                        app:donut_circle_starting_degree="-90"
                        app:donut_finished_color="@color/colorPrimary"
                        app:donut_finished_stroke_width="2dp"
                        app:donut_max="100"
                        app:donut_progress="0"
                        app:donut_text="0"
                        app:donut_text_color="@color/colorPrimary"
                        app:donut_text_size="10sp"
                        app:donut_unfinished_color="@color/gray89"
                        app:donut_unfinished_stroke_width="2dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:paddingLeft="20dp"
                    android:paddingTop="5dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:gravity="start|top"
                        android:id="@+id/et_notification_text"
                        android:scrollbars="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:hint="@string/activity_create_notifications_et_notification_text_hint"
                        android:maxLines="4"
                        android:maxLength="200"
                        android:imeOptions="actionGo"
                        android:backgroundTint="@android:color/transparent"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="bottom"
                    android:orientation="horizontal"
                    android:id="@+id/ll_attach"
                    android:background="@color/white"
                    android:paddingLeft="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:layout_marginBottom="5dp">
                    <ImageView
                        android:id="@+id/iv_add_attachment"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginRight="10dp"
                        android:src="@drawable/ic_attachment_tilted"
                        android:tint="@color/colorSecondaryText"/>
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_add_attachment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_create_notifications_tv_add_attachment_text"
                        android:layout_weight="1"/>
                    <CheckBox
                        android:id="@+id/cb_send_sms_homework_old"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20dp"
                        android:checked="false"
                        android:text="@string/send_sms"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/text_landing_screen"
                    android:textAllCaps="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/llLandingContainer"
                    android:background="@color/white"
                    android:paddingLeft="20dp"
                    android:paddingTop="10dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="5">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:id="@+id/tvLanding"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:hint="@string/text_select_screen_you_want_to_open"
                        android:singleLine="true"
                        android:layout_weight="4"/>
                    <TextView
                        android:textColor="@color/colorPrimary"
                        android:gravity="end"
                        android:id="@+id/tvChangeLanding"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/change"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:background="@color/white"
                        android:paddingLeft="20dp"
                        android:paddingTop="10dp"
                        android:paddingRight="20dp"
                        android:paddingBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="4">
                        <TextView
                            android:textColor="@color/black"
                            android:gravity="start|center_vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/schedule_for_later"
                            android:layout_weight="1"/>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/sw_later_schedule"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="3"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_schedule_later"
                        android:background="@color/white"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/colorSecondaryText"
                            android:paddingTop="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="20dp"
                            android:layout_marginRight="20dp"
                            android:text="@string/date_amp_time"
                            android:textAllCaps="true"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/ll_btn_schedule_later"
                            android:background="@drawable/shape_rectangle_gray_outline_r6"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginRight="20dp"
                            android:layout_marginBottom="10dp"
                            android:weightSum="5">
                            <TextView
                                android:id="@+id/tv_data_time_schedule"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="10dp"
                                android:hint="@string/activity_create_notifications_tv_data_time_schedule_hint"
                                android:layout_weight="4"/>
                            <ImageView
                                android:gravity="center"
                                android:padding="10dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:srcCompat="@drawable/ic_clock_time_colorsecondarytext"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <include
                    android:id="@+id/layout_image_atttach"
                    android:visibility="gone"
                    layout="@layout/row_attachments"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_image_resolution_correct"
                    android:background="@drawable/shape_rectangle_filled_light_blue_border_light_green"
                    android:padding="@dimen/ayp_16dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ayp_8dp"
                    android:layout_marginBottom="@dimen/ayp_16dp"
                    android:layout_marginStart="@dimen/ayp_16dp"
                    android:layout_marginEnd="@dimen/ayp_16dp">
                    <ImageView
                        android:id="@+id/iv_verified_tick"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        app:srcCompat="@drawable/ic_verified"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_verified_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/image_resolution_correct"
                        android:layout_marginStart="@dimen/ayp_8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_image_resolution_incorrect"
                    android:background="@drawable/shape_rectangle_filled_light_orange_border_orange"
                    android:padding="@dimen/ayp_16dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ayp_8dp"
                    android:layout_marginBottom="@dimen/ayp_16dp"
                    android:layout_marginStart="@dimen/ayp_16dp"
                    android:layout_marginEnd="@dimen/ayp_16dp">
                    <ImageView
                        android:id="@+id/iv_error"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        app:srcCompat="@drawable/ic_error_new"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_error_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/incorrect_resolution"
                        android:layout_marginStart="@dimen/ayp_8dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <Button
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/b_done"
            android:background="@drawable/bg_button_click_color_primary"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/send"
            android:textAllCaps="false"/>
    </LinearLayout>
</RelativeLayout>
