<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/ll_store_faculty"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_store_faculty"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="@dimen/ayp_16dp"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/tv_store_faculty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/iv_faculty_delete"
        android:background="?attr/selectableItemBackground"
        android:padding="@dimen/ayp_16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/ic_chat_delete_new"/>
</LinearLayout>
