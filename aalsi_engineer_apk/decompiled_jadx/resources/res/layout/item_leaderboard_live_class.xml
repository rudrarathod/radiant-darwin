<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ll_leaderboard"
    android:padding="@dimen/_10sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_4sdp"
    android:layout_marginLeft="@dimen/_8sdp"
    android:layout_marginRight="@dimen/_8sdp"
    android:layout_marginHorizontal="@dimen/_8sdp">
    <TextView
        android:textSize="@dimen/_12ssp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_leaderboard_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/long_test_text"
        android:maxLines="1"
        android:layout_weight="1"
        style="@style/nunito_sans_semi_bold_sub_medium_text_16"/>
    <TextView
        android:textSize="@dimen/_12ssp"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_leaderboard_correct_ans"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="wrap_content"
        android:text="@string/number_1"
        android:maxLines="1"
        android:layout_marginStart="@dimen/_12sdp"
        style="@style/nunito_sans_semi_bold_sub_medium_text_14"/>
    <TextView
        android:textSize="@dimen/_12ssp"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_leaderboard_wrong_ans"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="wrap_content"
        android:text="@string/number_1"
        android:maxLines="1"
        android:layout_marginStart="@dimen/_12sdp"
        style="@style/nunito_sans_semi_bold_sub_medium_text_14"/>
    <TextView
        android:textSize="@dimen/_14ssp"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_leaderboard_rank"
        android:visibility="gone"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="wrap_content"
        android:text="@string/number_1"
        android:maxLines="1"
        android:layout_marginStart="@dimen/_12sdp"
        style="@style/nunito_sans_semi_bold_sub_medium_text_14"/>
    <ImageView
        android:gravity="center"
        android:id="@+id/iv_leaderboard_rank"
        android:visibility="gone"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/_12sdp"
        app:srcCompat="@drawable/ic_leaderboard_first"/>
</LinearLayout>
