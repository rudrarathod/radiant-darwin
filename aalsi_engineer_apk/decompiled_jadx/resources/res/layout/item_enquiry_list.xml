<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_enquiryItem_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/ll_item"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="40dp"
            android:foreground="?android:attr/selectableItemBackground">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_weight="1"/>
            </LinearLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/colorSecondaryText"
                android:id="@+id/tv_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/royalblue"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_followup_status_update"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:text="@string/item_enquiry_list_tv_followup_status_update_text"
                    android:maxLines="2"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_date_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:maxLines="2"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorSecondaryText"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/tv_enquiry_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:layout_marginEnd="5dp"/>
                    <ImageView
                        android:id="@+id/civ_enquiry_status"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/shape_circle_color_primary"/>
                    <View
                        android:id="@+id/v_enquiry_divider"
                        android:background="@color/gray91"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="10dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorSecondaryText"
                        android:id="@+id/tv_followup_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/royalblue"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_view_batches"
            android:padding="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/item_enquiry_list_tv_view_batches_text"/>
        <RelativeLayout
            android:id="@+id/rl_selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/ll_item"
            android:layout_alignBottom="@+id/ll_item"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/iv_selected"
                android:background="@drawable/shape_circle_filled_white_gray_outline"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="16dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"/>
            <ImageView
                android:padding="2dp"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="16dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                app:srcCompat="@drawable/ic_done_tick"/>
        </RelativeLayout>
    </RelativeLayout>
    <View
        android:id="@+id/view_divider"
        android:background="@color/colorSecondaryText"
        android:layout_width="match_parent"
        android:layout_height="0.25dp"
        android:layout_below="@+id/ll_enquiryItem_parent"/>
    <include
        android:id="@+id/common_footer_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_below="@+id/view_divider"
        layout="@layout/common_footer_layout_gray91"/>
</RelativeLayout>
