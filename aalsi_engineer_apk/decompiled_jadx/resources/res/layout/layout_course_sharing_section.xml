<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:textSize="14sp"
        android:id="@+id/cb_global"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_global_info"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/colorSecondaryText"
        android:id="@+id/tv_global_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/label_global_course_info"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_course_global_value"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/black"
                android:id="@+id/tv_min_resale_price"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginRight="8dp"
                android:text="@string/label_min_course_value"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/black"
                android:id="@+id/tv_share_resale_price"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:text="@string/label_share_on_resale"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <EditText
                android:textSize="14sp"
                android:ellipsize="end"
                android:id="@+id/et_min_course_price"
                android:background="@drawable/shape_rectangle_gray_outline_white_filled_r4"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:hint="@string/label_hint_enter_min_course_value"
                android:maxLines="1"
                android:digits="1234567890"
                android:layout_weight="1"
                android:inputType="number"
                android:layout_marginEnd="8dp"/>
            <EditText
                android:textSize="14sp"
                android:ellipsize="end"
                android:id="@+id/et_share_percent"
                android:background="@drawable/shape_rectangle_gray_outline_white_filled_r4"
                android:paddingLeft="16dp"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:hint="@string/label_hint_enter_percent_share"
                android:maxLines="1"
                android:maxLength="3"
                android:digits="1234567890"
                android:layout_weight="1"
                android:inputType="number"
                android:paddingStart="16dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_info_secondary"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorSecondaryText"
                android:id="@+id/tv_course_share_info"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                android:text="@string/label_course_share_info"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
