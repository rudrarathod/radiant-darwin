<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/aya_24dp"
        android:layout_marginRight="@dimen/aya_24dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ayp_16dp"
            android:layout_marginBottom="@dimen/ayp_16dp">
            <TextView
                android:id="@+id/tv_overview_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/class_details"
                style="@style/BaseTextAppearance.HeavyWeightTitle"/>
            <ImageView
                android:id="@+id/iv_close"
                android:padding="@dimen/ayp_8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="@color/color_DE000000"
                app:srcCompat="@drawable/ic_close_cross"/>
        </LinearLayout>
        <View
            android:background="@color/grayE5"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="@dimen/aya_24dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="top"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="2dp"
                app:srcCompat="@drawable/ic_topic"/>
            <TextView
                android:id="@+id/tv_topic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ayp_16dp"
                android:maxLines="2"
                android:layout_marginStart="@dimen/ayp_16dp"
                android:lineHeight="20dp"
                style="@style/BaseTextAppearance.ShadowTitle"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_remarks"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aya_24dp">
            <ImageView
                android:layout_gravity="top"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="2dp"
                android:tint="@color/color_666666"
                app:srcCompat="@drawable/ic_chat"/>
            <TextView
                android:id="@+id/tv_remarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ayp_16dp"
                android:maxLines="2"
                android:layout_marginStart="@dimen/ayp_16dp"
                android:lineHeight="20dp"
                style="@style/BaseTextAppearance.ShadowTitle"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aya_24dp">
            <ImageView
                android:layout_gravity="top"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:tint="@color/color_666666"
                app:srcCompat="@drawable/like"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ayp_16dp"
                android:text="@string/feedback_submitted"
                android:maxLines="2"
                android:layout_marginStart="@dimen/ayp_16dp"
                style="@style/BaseTextAppearance.ShadowTitle"/>
        </LinearLayout>
        <RatingBar
            android:layout_gravity="start"
            android:id="@+id/rb_feedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="@dimen/ayp_8dp"
            android:layout_marginBottom="@dimen/ayp_8dp"
            android:numStars="5"
            android:stepSize="1"
            android:layout_marginStart="32dp"
            style="@style/Widget.AppCompat.RatingBar.Small"/>
        <TextView
            android:id="@+id/tv_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:maxLines="2"
            android:layout_marginStart="22dp"
            android:lineHeight="20dp"
            style="@style/BaseTextAppearance.ShadowTitle"/>
    </LinearLayout>
    <View
        android:background="@color/grayE5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/aya_24dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/absent_red"
        android:gravity="center"
        android:id="@+id/b_done"
        android:paddingLeft="20dp"
        android:paddingTop="15dp"
        android:paddingRight="20dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ayp_16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="@dimen/ayp_16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/done_caps"
        android:textAllCaps="false"/>
</LinearLayout>
