<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/card_upcoming"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="4dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_upcoming_overview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_back_image"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="172dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/splash_background"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_labels"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_live_now_label"
                android:background="@drawable/shape_rectangle_pink_filled_r12"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_live_now_play"
                    android:padding="2dp"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="3dp"
                    app:srcCompat="@drawable/ic_store_play"/>
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/tv_live_now_label"
                    android:text="@string/live_now"
                    android:paddingStart="2dp"
                    android:paddingEnd="8dp"
                    style="@style/RoundedEmblemTextViewStyle"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/gray_deep_dark"
                android:id="@+id/tv_schedule_label"
                android:background="@drawable/shape_rectangle_gray_filled_r12"
                android:visibility="gone"
                android:text="@string/scheduled"
                style="@style/RoundedEmblemTextViewStyle"/>
            <TextView
                android:textColor="@color/white"
                android:id="@+id/tv_trial_label"
                android:background="@drawable/shape_rectangle_yellow_filled_r12"
                android:visibility="gone"
                android:text="@string/trial"
                android:layout_marginStart="4dp"
                style="@style/RoundedEmblemTextViewStyle"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ImageView
                android:layout_gravity="end"
                android:id="@+id/iv_upcoming_menu"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_dots_black"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_DE000000"
            android:id="@+id/tv_upcoming_live_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_labels"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_faculty_course"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_upcoming_live_title">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_99000000"
                android:id="@+id/tv_faculty_name"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_dot"
                android:visibility="gone"
                app:tint="@color/color_99000000"
                style="@style/DotImageViewStyle"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_99000000"
                android:ellipsize="end"
                android:id="@+id/tv_in_course_label"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_date_join_upcoming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_faculty_course">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_DE000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_upcoming_assignee"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:drawablePadding="8dp"
                android:layout_weight="2"
                app:drawableStartCompat="@drawable/ic_user_vector_16dp"
                app:drawableTint="@color/black"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_DE000000"
                android:gravity="center_vertical"
                android:id="@+id/tv_upcoming_live_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:drawablePadding="8dp"
                android:layout_marginStart="4dp"
                app:drawableStartCompat="@drawable/ic_clock"
                app:drawableTint="@color/black"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:gravity="end|center_vertical"
                android:id="@+id/tv_upcoming_go_live"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_date_join_trial"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintLeft_toLeftOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_trial_time"
                android:layout_width="14dp"
                android:layout_height="14dp"
                app:srcCompat="@drawable/ic_clock"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_DE000000"
                android:id="@+id/tv_trial_live_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/tint_black"
                android:gravity="end|center_vertical"
                android:id="@+id/tv_trial_go_live"
                android:background="@drawable/shape_rectangle_filled_white_radius_2"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
