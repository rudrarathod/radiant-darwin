<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/grayF1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@drawable/bg_primary_color_gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <include
        android:id="@+id/commonSearch"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@+id/toolbar"
        layout="@layout/common_search"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ll_btn_done_atendance"
        android:layout_below="@+id/commonSearch">
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp">
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/grayF1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="exitUntilCollapsed|scroll">
                <RelativeLayout
                    android:background="@color/white"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_top_name"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true">
                        <TextView
                            android:textStyle="bold"
                            android:id="@+id/tv_batch_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            style="@style/BaseTextAppearance.HeavyWeightTitle"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/iv_down_icon"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@drawable/ic_chevron_down_black"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_data"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/ll_top_name">
                        <View
                            android:background="@color/gray89"
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <RelativeLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.6">
                                <ImageView
                                    android:id="@+id/id_iv_book"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:maxWidth="18dp"
                                    android:maxHeight="18dp"
                                    android:tint="@color/colorSecondaryText"
                                    android:layout_alignTop="@+id/id_tv_subject"
                                    android:layout_alignBottom="@+id/id_tv_subject"
                                    app:srcCompat="@drawable/ic_book"/>
                                <TextView
                                    android:id="@+id/id_tv_subject"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="10dp"
                                    android:text="@string/subject"
                                    android:layout_toRightOf="@+id/id_iv_book"
                                    android:layout_marginStart="10dp"
                                    android:layout_toEndOf="@+id/id_iv_book"
                                    style="@style/BaseTextAppearance.MediumWeightTitle"/>
                                <TextView
                                    android:textColor="#de000000"
                                    android:id="@+id/tv_subject"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:layout_below="@+id/id_tv_subject"
                                    android:layout_alignLeft="@+id/id_tv_subject"
                                    android:layout_alignStart="@+id/id_tv_subject"
                                    style="@style/BaseTextAppearance.SubTitle"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:gravity="start|top"
                                android:layout_gravity="start|top"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.6">
                                <ImageView
                                    android:id="@+id/id_iv_faculty"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_margin="@dimen/ayp_2dp"
                                    android:tint="@color/colorSecondaryText"
                                    app:srcCompat="@drawable/ic_person"/>
                                <TextView
                                    android:id="@+id/id_tv_faculty"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="10dp"
                                    android:text="@string/activity_attendance_id_tv_faculty_text"
                                    android:layout_toRightOf="@+id/id_iv_faculty"
                                    android:layout_marginStart="10dp"
                                    android:layout_toEndOf="@+id/id_iv_faculty"
                                    style="@style/BaseTextAppearance.MediumWeightTitle"/>
                                <TextView
                                    android:textColor="#de000000"
                                    android:id="@+id/tv_faculty"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:layout_below="@+id/id_tv_faculty"
                                    android:layout_alignLeft="@+id/id_tv_faculty"
                                    android:layout_alignStart="@+id/id_tv_faculty"
                                    style="@style/BaseTextAppearance.SubTitle"/>
                            </RelativeLayout>
                        </LinearLayout>
                        <View
                            android:background="@color/gray89"
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:id="@+id/id_iv_class"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:tint="@color/colorSecondaryText"
                                    app:srcCompat="@drawable/ic_time"/>
                                <TextView
                                    android:id="@+id/id_tv_timimgs"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_marginLeft="10dp"
                                    android:layout_toRightOf="@+id/id_iv_class"
                                    android:layout_alignTop="@+id/id_iv_class"
                                    android:layout_alignBottom="@+id/id_iv_class"
                                    android:layout_marginStart="10dp"
                                    android:layout_toEndOf="@+id/id_iv_class"
                                    style="@style/BaseTextAppearance.ShadowTitle"/>
                            </RelativeLayout>
                        </LinearLayout>
                        <View
                            android:background="@color/gray89"
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <RelativeLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.6">
                                <ImageView
                                    android:id="@+id/id_iv_student_total"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:maxWidth="18dp"
                                    android:maxHeight="18dp"
                                    android:tint="@color/colorSecondaryText"
                                    android:layout_alignTop="@+id/id_tv_students_total"
                                    android:layout_alignBottom="@+id/id_tv_students_total"
                                    app:srcCompat="@drawable/ic_students"/>
                                <TextView
                                    android:id="@+id/id_tv_students_total"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="10dp"
                                    android:text="@string/text_students"
                                    android:layout_toRightOf="@+id/id_iv_student_total"
                                    android:layout_marginStart="10dp"
                                    android:layout_toEndOf="@+id/id_iv_student_total"
                                    style="@style/BaseTextAppearance.MediumWeightTitle"/>
                                <TextView
                                    android:textColor="#de000000"
                                    android:id="@+id/tv_students_total"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:layout_below="@+id/id_tv_students_total"
                                    android:layout_alignLeft="@+id/id_tv_students_total"
                                    android:layout_alignStart="@+id/id_tv_students_total"
                                    style="@style/BaseTextAppearance.SubTitle"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.6">
                                <ImageView
                                    android:id="@+id/id_iv_student"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:maxWidth="18dp"
                                    android:maxHeight="18dp"
                                    android:tint="@color/colorSecondaryText"
                                    android:layout_alignTop="@+id/id_tv_students"
                                    android:layout_alignBottom="@+id/id_tv_students"
                                    app:srcCompat="@drawable/ic_students"/>
                                <TextView
                                    android:id="@+id/id_tv_students"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="10dp"
                                    android:text="@string/students_present"
                                    android:layout_toRightOf="@+id/id_iv_student"
                                    android:layout_marginStart="10dp"
                                    android:layout_toEndOf="@+id/id_iv_student"
                                    style="@style/BaseTextAppearance.MediumWeightTitle"/>
                                <TextView
                                    android:textColor="#de000000"
                                    android:id="@+id/tv_students"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:layout_below="@+id/id_tv_students"
                                    android:layout_alignLeft="@+id/id_tv_students"
                                    android:layout_alignStart="@+id/id_tv_students"
                                    style="@style/BaseTextAppearance.SubTitle"/>
                            </RelativeLayout>
                        </LinearLayout>
                        <View
                            android:background="@color/gray89"
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"/>
                    </LinearLayout>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorPrimary"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/tv_add_topic"
                        android:background="@drawable/shape_oval_outline_blue_primary"
                        android:paddingLeft="25dp"
                        android:paddingRight="25dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="8dp"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:text="@string/activity_attendance_tv_add_topic_text"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/ll_topic"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="5dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorSecondaryText"
                            android:gravity="center"
                            android:id="@+id/tv_topic_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/activity_attendance_tv_topic_label_text"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:id="@+id/tv_topic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="210dp"
                            android:maxLines="1"/>
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginLeft="10dp"
                            android:tint="@color/colorPrimary"
                            android:layout_marginStart="10dp"
                            app:srcCompat="@drawable/ic_pencil"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/ll_rating"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorSecondaryText"
                            android:gravity="center"
                            android:id="@+id/tv_rating_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/activity_attendance_tv_rating_label_text"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:id="@+id/tv_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <ImageView
                            android:id="@+id/iv_rating"
                            android:visibility="visible"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginLeft="10dp"
                            android:tint="@color/tutor_pro"
                            android:layout_marginStart="10dp"
                            app:srcCompat="@drawable/ic_star_filled"/>
                    </LinearLayout>
                    <View
                        android:background="@color/gray89"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_margin="@dimen/ayp_16dp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
            <FrameLayout
                android:id="@+id/frame_layout"
                android:background="@color/white"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_btn_done_atendance"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/button_attendance"
            android:background="@drawable/bg_button_click_color_primary"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/mark_attendance"
            android:textAllCaps="false"/>
    </LinearLayout>
    <include
        android:id="@+id/ll_help_videos"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_help_bottom"
        android:layout_above="@+id/ll_btn_done_atendance"
        layout="@layout/layout_help_button"/>
</RelativeLayout>
