<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh_layout"
    android:background="@color/gray91"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/layout_search"
            layout="@layout/common_search"/>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:background="@color/gray91"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/ll_purchase"
            android:layout_below="@+id/layout_search">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/appBarLayout"
                android:background="@color/gray91"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:elevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_top_video_view"
                    android:background="@color/white"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:layout_scrollFlags="enterAlways|scroll">
                    <RelativeLayout
                        android:id="@+id/rl_thumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/iv_thumbnail"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:src="@drawable/course_placeholder"
                            android:scaleType="centerCrop"/>
                        <ProgressBar
                            android:id="@+id/pb_view_progress"
                            android:background="@drawable/drawable_view_progress"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:max="100"
                            android:progressDrawable="@drawable/drawable_view_progress"
                            android:layout_below="@+id/iv_thumbnail"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@+id/ll_play_buy"
                            android:background="@drawable/bg_button_click_color_primary"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">
                            <ImageView
                                android:id="@+id/iv_play"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:tint="@color/white"
                                app:srcCompat="@drawable/ic_store_play"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:id="@+id/tv_play_buy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"/>
                        </LinearLayout>
                    </RelativeLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_header_tags"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/colorSecondaryText"
                            android:id="@+id/tv_tag1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:id="@+id/tv_tag2"
                            android:background="@color/royalblue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/colorPrimaryText"
                            android:id="@+id/tv_title"
                            android:paddingTop="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="8dp"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/ll_views_remaining"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp">
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:tint="@color/colorSecondaryText"
                                app:srcCompat="@drawable/ic_remove_red_eye"/>
                            <TextView
                                android:textSize="14sp"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/tv_views_remaining"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/ll_duration_remaining"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp">
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:tint="@color/colorSecondaryText"
                                app:srcCompat="@drawable/ic_clock_time"/>
                            <TextView
                                android:textSize="14sp"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/tv_duration_remaining"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#5aa367"
                            android:id="@+id/tv_threshold"
                            android:background="#8ef6a0"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:textAllCaps="true"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorSecondaryText"
                        android:autoLink="all"
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"/>
                </LinearLayout>
            </com.google.android.material.appbar.AppBarLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_purchase"
            android:background="@color/white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <Button
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/btn_purchase"
                android:background="@drawable/bg_button_click_color_primary"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:text="@string/buy_now"
                android:textAllCaps="false"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_no_content"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/store_content_empty"/>
            <TextView
                android:textSize="20sp"
                android:textColor="@color/colorPrimaryText"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:text="@string/no_content_available"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/we_doubt_this_has_been_created_nin_a_hurry"/>
        </LinearLayout>
        <include
            android:id="@+id/ll_no_internet_connection"
            android:visibility="gone"
            layout="@layout/layout_no_connection"/>
    </RelativeLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
