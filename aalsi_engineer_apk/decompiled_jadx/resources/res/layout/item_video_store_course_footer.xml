<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="8dp"
    android:paddingTop="16dp"
    android:paddingRight="8dp"
    android:paddingBottom="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_course_cover"
        android:clipChildren="true"
        android:layout_width="240dp"
        android:layout_height="180dp"
        android:layout_marginStart="10dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">
        <ImageView
            android:id="@+id/iv_course_cover"
            android:layout_width="240dp"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:cropToPadding="true"
            app:srcCompat="@drawable/ic_default_placeholder_course"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:layout_gravity="bottom"
            android:id="@+id/tv_title"
            android:background="@drawable/trans_grad"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_alignParentBottom="true"/>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_left_label"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:id="@+id/tv_left_label"
            android:background="#ff5454"
            android:paddingLeft="10dp"
            android:paddingTop="2dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:textAlignment="center"/>
        <ImageView
            android:id="@+id/iv_left_label_triangle"
            android:layout_width="10dp"
            android:layout_height="10dp"
            app:srcCompat="@drawable/bg_left_label_triangle"/>
    </LinearLayout>
</RelativeLayout>
