<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/white"
    android:paddingLeft="16dp"
    android:paddingTop="12dp"
    android:paddingRight="16dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="50dp"
        android:layout_height="50dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_student_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/ic_launcher"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_student_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <ImageView
                android:visibility="visible"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginLeft="3dp"
                android:tint="@color/colorSecondaryText"
                android:layout_marginStart="3dp"
                app:srcCompat="@drawable/ic_chevron_right"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/colorSecondaryText"
                android:gravity="center"
                android:id="@+id/tv_rating_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/item_attendance_tv_rating_label_text"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_feedback"
                android:visibility="visible"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginLeft="5dp"
                android:tint="@color/black"
                android:layout_marginStart="5dp"
                app:srcCompat="@drawable/ic_reciept_colorsecondarytext"/>
        </LinearLayout>
    </LinearLayout>
    <RadioGroup
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/radio_group_attendance"
        android:background="@drawable/shape_rectangle_filled_present_green_r17"
        android:padding="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp">
        <RadioButton
            android:textSize="16sp"
            android:textColor="@drawable/text_color_selector_attendance_absent"
            android:gravity="center"
            android:id="@+id/radio_button_absent"
            android:background="@drawable/shape_attendance_absent_selector"
            android:paddingLeft="6dp"
            android:paddingTop="5dp"
            android:paddingRight="6dp"
            android:paddingBottom="5dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:checked="false"
            android:button="@null"
            android:text="@string/item_attendance_radio_button_absent_text"/>
        <RadioButton
            android:textSize="16sp"
            android:textColor="@drawable/text_color_selector_attendance_present"
            android:gravity="center"
            android:id="@+id/radio_button_present"
            android:background="@drawable/shape_rectangle_filled_white_r17"
            android:paddingLeft="6dp"
            android:paddingTop="5dp"
            android:paddingRight="6dp"
            android:paddingBottom="5dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:checked="true"
            android:button="@null"
            android:text="@string/item_attendance_radio_button_present_text"/>
    </RadioGroup>
</LinearLayout>
