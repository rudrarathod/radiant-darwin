<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_thumbnail"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_width="90dp"
            android:layout_height="60dp">
            <ImageView
                android:id="@+id/iv_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:foregroundGravity="center"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_play"
                android:background="@drawable/bg_round_grey_stroke_white"
                android:visibility="visible"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ic_play_arrow"
                app:tint="@color/white"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/color_white"
                android:layout_gravity="end|bottom"
                android:id="@+id/tv_duration"
                android:background="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"/>
        </FrameLayout>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_DE000000"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="2"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_menu_option"
        app:layout_constraintStart_toEndOf="@+id/cv_thumbnail"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_menu_option"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/menu"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_title"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ayp_ic_menu_24dp"
        app:tint="@color/color_99000000"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_faculty_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_menu_option"
        app:layout_constraintStart_toEndOf="@+id/cv_thumbnail"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <TextView
            android:textColor="@color/white"
            android:id="@+id/tv_trial_label"
            android:background="@drawable/shape_rectangle_yellow_filled_r12"
            android:visibility="gone"
            android:text="@string/trial"
            android:layout_marginEnd="8dp"
            style="@style/RoundedEmblemTextViewStyle"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_99000000"
            android:ellipsize="end"
            android:id="@+id/tv_faculty_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_date_join"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_menu_option"
        app:layout_constraintStart_toEndOf="@+id/cv_thumbnail"
        app:layout_constraintTop_toBottomOf="@+id/ll_faculty_name">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_99000000"
            android:id="@+id/tv_date_live"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_dot"
            android:visibility="gone"
            app:tint="@color/color_99000000"
            style="@style/DotImageViewStyle"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_99000000"
            android:id="@+id/tv_joined_live"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_349242"
        android:id="@+id/tv_enrolled"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_menu_option"
        app:layout_constraintStart_toEndOf="@+id/cv_thumbnail"
        app:layout_constraintTop_toBottomOf="@+id/ll_date_join"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_downloading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:id="@+id/pb_downloading"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:indeterminate="true"
            android:layout_marginStart="5dp"/>
        <ImageView
            android:id="@+id/iv_download"
            android:visibility="gone"
            android:layout_width="25dp"
            android:layout_height="30dp"
            android:contentDescription="@string/download"
            android:layout_marginStart="5dp"
            app:tint="@color/colorPrimary"/>
    </LinearLayout>
    <View
        android:id="@+id/view_hl"
        android:background="@color/grayE5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_enrolled"/>
</androidx.constraintlayout.widget.ConstraintLayout>
