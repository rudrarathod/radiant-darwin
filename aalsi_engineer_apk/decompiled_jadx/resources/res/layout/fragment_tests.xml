<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh_layout"
    android:background="@color/grayF1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rl_tests_present"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/layout_search"
                layout="@layout/common_search"/>
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:id="@+id/cl_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/layout_search">
                <com.google.android.material.appbar.AppBarLayout
                    android:id="@+id/appBarLayout"
                    android:background="@color/grayF1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:elevation="0dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_upper_data"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/layout_search"
                        app:layout_scrollFlags="enterAlways|scroll">
                        <include
                            android:id="@+id/layoutBatchTestHeader"
                            android:visibility="gone"
                            layout="@layout/item_batch_test_header"/>
                        <include
                            android:id="@+id/ll_win_card"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            layout="@layout/layout_win_points_item"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorSecondaryText"
                            android:id="@+id/tv_challenges"
                            android:paddingTop="16dp"
                            android:paddingBottom="10dp"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/challenges_caps"
                            android:textAllCaps="true"
                            android:paddingStart="16dp"
                            android:paddingEnd="10dp"/>
                        <include
                            android:id="@+id/ll_challenges"
                            android:visibility="gone"
                            layout="@layout/layout_challenges_card"/>
                    </LinearLayout>
                </com.google.android.material.appbar.AppBarLayout>
                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/rv_swipe_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_tests"
                        android:background="@color/grayF1"
                        android:scrollbars="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp"/>
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_no_tests"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_tests_empty"/>
            <TextView
                android:textSize="20sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/no_tests"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:gravity="center"
                android:id="@+id/tv_empty_sub_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/common_empty_sub_msg_test"/>
            <Button
                android:textSize="18sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_add_test"
                android:background="@drawable/bg_button_click_color_primary"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="30dp"
                android:text="@string/assign_test"
                android:textAllCaps="false"/>
        </LinearLayout>
        <include
            android:visibility="gone"
            layout="@layout/common_progressbar"/>
        <include
            android:id="@+id/ll_help_videos"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_alignParentBottom="true"
            layout="@layout/layout_help_button"/>
    </RelativeLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
