<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@drawable/bg_primary_color_gradient"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <ScrollView
        android:background="@color/gray91"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_below="@+id/toolbar"
        android:layout_centerInParent="true">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/gray91"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/fee_amount"
                android:textAllCaps="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/white"
                android:paddingLeft="20dp"
                android:paddingTop="5dp"
                android:paddingRight="20dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:gravity="start|center_vertical"
                    android:id="@+id/et_fee_amount"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/activity_add_edit_installment_et_fee_amount_hint"
                    android:maxLines="1"
                    android:digits=".0123456789"
                    android:inputType="number"
                    android:imeOptions="actionNext"
                    android:backgroundTint="@android:color/transparent"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:id="@+id/tv_tax_amount_heading"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/tax_amount"
                android:textAllCaps="true"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/colorSecondaryText"
                android:id="@+id/tv_tax_amount"
                android:background="@color/white"
                android:paddingLeft="20dp"
                android:paddingTop="15dp"
                android:paddingRight="20dp"
                android:paddingBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/activity_add_edit_installment_tv_tax_amount_hint"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/due_date"
                android:textAllCaps="true"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/black"
                android:id="@+id/tv_select_date"
                android:background="@color/white"
                android:paddingLeft="20dp"
                android:paddingTop="15dp"
                android:paddingRight="20dp"
                android:paddingBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/select_date"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/total_amount"
                android:textAllCaps="true"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/colorSecondaryText"
                android:id="@+id/tv_total_amount"
                android:background="@color/white"
                android:paddingLeft="20dp"
                android:paddingTop="15dp"
                android:paddingRight="20dp"
                android:paddingBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/total_fee_amount"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/instalment_status"
                android:textAllCaps="true"/>
            <Spinner
                android:id="@+id/spinner_status"
                android:background="@color/white"
                android:paddingLeft="15dp"
                android:paddingTop="5dp"
                android:paddingRight="15dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:spinnerMode="dropdown"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/notes_optional"
                android:textAllCaps="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/white"
                android:paddingLeft="20dp"
                android:paddingTop="5dp"
                android:paddingRight="20dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:gravity="start|top"
                    android:id="@+id/et_notes"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:hint="@string/type_here"
                    android:maxLines="4"
                    android:imeOptions="actionGo"
                    android:backgroundTint="@android:color/transparent"/>
            </LinearLayout>
            <Button
                android:textSize="18sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/b_done"
                android:background="@drawable/bg_button_click_color_primary"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="10dp"
                android:text="@string/done"
                android:textAllCaps="false"/>
        </LinearLayout>
    </ScrollView>
    <include
        android:visibility="gone"
        layout="@layout/common_progressbar"/>
</RelativeLayout>
