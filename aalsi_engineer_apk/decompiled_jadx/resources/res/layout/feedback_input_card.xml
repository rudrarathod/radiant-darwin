<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="15dp">
            <View
                android:background="@color/grayE5"
                android:layout_width="match_parent"
                android:layout_height="20dp"/>
            <View
                android:background="@color/grayE5"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="@dimen/ayp_8dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ayp_12sp"
                android:layout_marginTop="@dimen/ayp_8dp"
                android:layout_marginRight="@dimen/ayp_12sp">
                <View
                    android:background="@color/grayE5"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginRight="@dimen/ayp_8dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/ayp_8dp"/>
                <View
                    android:background="@color/grayE5"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginRight="@dimen/ayp_8dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/ayp_8dp"/>
                <View
                    android:background="@color/grayE5"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/dynamic_card_heading"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ayp_8dp"
            android:layout_marginBottom="@dimen/ayp_8dp">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/ayp_16dp"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/ayp_16dp"
                    android:layout_marginRight="@dimen/ayp_16dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14sp"
                    android:textColor="@color/gray66"
                    android:id="@+id/tv_subheading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/ayp_16dp"
                    android:layout_marginTop="@dimen/ayp_8dp"
                    android:layout_marginRight="@dimen/ayp_16dp"/>
                <EditText
                    android:id="@+id/edit_feedback_input"
                    android:background="@drawable/shape_rectangle_gray_outline_r6"
                    android:padding="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:hint="@string/feedback_input_card_edit_feedback_input_hint"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#009ae0"
                    android:id="@+id/tv_submit_feedback"
                    android:paddingLeft="@dimen/ayp_8dp"
                    android:paddingTop="8dp"
                    android:paddingRight="@dimen/ayp_8dp"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ayp_8dp"
                    android:text="@string/submit"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</LinearLayout>
