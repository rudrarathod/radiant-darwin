<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp">
    <RelativeLayout
        android:id="@+id/rv_main"
        android:background="@color/white"
        android:paddingLeft="14dp"
        android:paddingTop="16dp"
        android:paddingRight="15dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/img_Thumbnail"
            android:background="@drawable/shape_rectangle_filled_white_outline_gray_r6"
            android:layout_width="136dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:maxWidth="120dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_toRightOf="@+id/img_Thumbnail"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@+id/img_Thumbnail">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/course_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorPrimaryText"
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:id="@+id/heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_like_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true">
                    <CheckBox
                        android:layout_gravity="center_vertical"
                        android:id="@+id/img_Like"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:button="@drawable/ic_checkbox_cp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_subheading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp">
                <ImageView
                    android:id="@+id/img_subheading_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="@dimen/ayp_8dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"/>
                <TextView
                    android:textSize="12sp"
                    android:ellipsize="end"
                    android:id="@+id/tv_subheading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_emblem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/img_emblem_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="@dimen/ayp_8dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:layout_marginEnd="@dimen/ayp_8dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColorHighlight="@color/gray74"
                    android:id="@+id/tv_emblem_text"
                    android:paddingLeft="@dimen/ayp_8dp"
                    android:paddingTop="@dimen/ayp_2dp"
                    android:paddingRight="@dimen/ayp_8dp"
                    android:paddingBottom="@dimen/ayp_2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/price_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_price_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/tv_striked_price_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginStart="16dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ff4058"
                    android:ellipsize="end"
                    android:id="@+id/tv_off_percent_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:ems="5"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
