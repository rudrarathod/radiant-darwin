<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_title_live"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="18dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black"
            android:id="@+id/tv_title_live"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/live_class_details"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_close_live_sheet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_close"/>
    </LinearLayout>
    <View
        android:id="@+id/view_hl"
        android:background="@color/gray90"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@+id/ll_title_live"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/black"
        android:id="@+id/tv_live_class_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_trial_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_hl"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/tv_trial_label"
        android:background="@drawable/shape_rectangle_yellow_filled_r12"
        android:layout_marginTop="16dp"
        android:text="@string/trial"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_hl"
        style="@style/RoundedEmblemTextViewStyle"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_live_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_live_class_name">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:contentDescription="@string/text_time"
            app:srcCompat="@drawable/ic_clock"
            app:tint="@color/color_99000000"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_99000000"
            android:id="@+id/tv_live_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_dot"
            app:tint="@color/color_99000000"
            style="@style/DotImageViewStyle"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_99000000"
            android:id="@+id/tv_live_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:id="@+id/view_hl_2"
        android:background="@color/gray90"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_live_time"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_DE000000"
        android:gravity="center"
        android:id="@+id/tv_student_info_text"
        android:background="@drawable/shape_rectangle_filled_green_no_border_r4"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_hl_2"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_live_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_student_info_text"
        app:spanCount="2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
