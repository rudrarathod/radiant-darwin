<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardElevation="2dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/container_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="10dp">
            <ImageView
                android:id="@+id/iv_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:src="@drawable/ic_logo_full"
                android:scaleType="centerCrop"/>
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_play"
                android:tint="@color/white"
                android:layout_centerInParent="true"
                android:alpha="0.9"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:id="@+id/tv_video_duration"
                android:background="@drawable/bg_video_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"/>
            <ImageView
                android:id="@+id/iv_share"
                android:visibility="gone"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:tint="@color/white"
                android:layout_alignParentRight="true"
                android:alpha="0.9"
                android:layout_alignParentEnd="true"
                app:srcCompat="@drawable/ic_share"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/container_thumbnail">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/colorPrimaryText"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="3"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
