<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/banner"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentTop="true">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_sort_type"
        android:padding="10dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorSecondaryText"
            android:gravity="center"
            android:id="@+id/tv_sort_type"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/sort_by"
            android:textAllCaps="true"/>
        <ImageView
            android:id="@+id/iv_sortType"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ic_chevron_down"
            android:tint="@color/colorSecondaryText"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <View
            android:background="@color/gray79"
            android:layout_width="1dp"
            android:layout_height="20dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_filter"
        android:padding="10dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorSecondaryText"
            android:gravity="center"
            android:layout_gravity="right"
            android:id="@+id/tv_filter"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="5dp"
            android:text="@string/filter"
            android:textAllCaps="true"
            android:layout_marginEnd="5dp"/>
        <ImageView
            android:id="@+id/iv_filter"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:tint="@color/colorSecondaryText"
            app:srcCompat="@drawable/ic_filter_color_primary_14dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <View
            android:background="@color/gray79"
            android:layout_width="1dp"
            android:layout_height="20dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_select"
        android:padding="10dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorSecondaryText"
            android:gravity="center"
            android:layout_gravity="right"
            android:id="@+id/tv_select"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="5dp"
            android:text="@string/select_all_caps"
            android:textAllCaps="true"
            android:layout_marginEnd="5dp"/>
        <RelativeLayout
            android:id="@+id/rl_selected"
            android:background="@drawable/shape_circle_filled_white_gray_outline"
            android:padding="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_marginEnd="10dp">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_centerInParent="true"
                app:srcCompat="@drawable/ic_done_tick"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
