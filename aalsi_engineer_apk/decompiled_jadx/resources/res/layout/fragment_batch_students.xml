<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ll_add_student">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_students_present"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/dividerView"
                android:background="@color/divider"
                android:layout_width="match_parent"
                android:layout_height="0.75dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:id="@+id/search_layout"
                    android:visibility="visible"
                    layout="@layout/common_search"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_students_type"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tab_layout"
                        android:background="@color/white"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        app:tabGravity="fill"
                        app:tabIndicatorColor="@color/colorPrimary"
                        app:tabMode="scrollable"
                        app:tabSelectedTextColor="@color/black"
                        app:tabTextColor="@color/colorSecondaryText"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorPrimary"
                        android:gravity="center"
                        android:id="@+id/tv_students_type"
                        android:padding="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/fragment_batch_students_tv_students_type_text"/>
                </LinearLayout>
                <co.classplus.app.ui.custom.NonHorizontalSwipableViewPager
                    android:id="@+id/viewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <include
        android:id="@+id/ll_help_videos"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="74dp"
        android:layout_alignParentBottom="true"
        layout="@layout/layout_help_button"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_add_student"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <View
            android:id="@+id/dividerView2"
            android:background="@color/divider"
            android:layout_width="match_parent"
            android:layout_height="0.75dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_btn_add"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/button_add_students"
                android:background="@drawable/bg_button_click_color_primary"
                android:padding="10dp"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="10dp"
                android:text="@string/add_student"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
