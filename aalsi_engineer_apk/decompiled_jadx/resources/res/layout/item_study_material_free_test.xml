<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_test_info"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_test"
        android:background="@drawable/bg_document_type_color"
        android:padding="@dimen/_6sdp"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_60sdp"
        android:layout_margin="@dimen/_24sdp"
        android:src="@drawable/ic_test_new"
        android:contentDescription="@string/test_icon_preview"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/ll_main_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_16sdp"
        app:layout_constraintBottom_toTopOf="@+id/view_divider_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_test"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_test_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_test"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/ts_14sp"
                android:textColor="@color/color_3C4852"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_test_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_weight="1"
                android:lineSpacingExtra="@dimen/_3sdp"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_share"
                android:layout_width="@dimen/aya_24dp"
                android:layout_height="@dimen/aya_24dp"
                android:src="@drawable/ic_share_gray"
                android:contentDescription="@string/share_icon_preview"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_more_options"
                android:layout_width="@dimen/aya_24dp"
                android:layout_height="@dimen/aya_24dp"
                android:src="@drawable/ic_dots"
                android:contentDescription="@string/more_options_preview"
                android:layout_marginStart="@dimen/_2sdp"
                app:tint="@color/gray7A7A7A"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/tv_attempt_cta"
                android:background="@drawable/bg_button_click_color_primary"
                android:paddingTop="@dimen/_7sdp"
                android:paddingBottom="@dimen/_7sdp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_attempt_test"
                android:paddingStart="@dimen/_14sdp"
                android:paddingEnd="@dimen/_14sdp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_attempts_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp">
            <TextView
                android:textSize="@dimen/ayp_12sp"
                android:id="@+id/tv_attempts_allowed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/attempt_allowed"/>
            <TextView
                android:textSize="@dimen/ayp_12sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_attempts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/_10ssp"
            android:textColor="@color/colorPrimary"
            android:gravity="center"
            android:id="@+id/tv_preview_test"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="@string/preview_test"
            android:textFontWeight="500"
            app:drawableEndCompat="@drawable/ic_chevron_right_blue"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_upcoming_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="@+id/view_divider_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_test"
            app:layout_constraintTop_toBottomOf="@+id/ll_attempts_view">
            <ImageView
                android:id="@+id/iv_clock"
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:src="@drawable/clock_white"
                app:tint="@color/gray66"/>
            <TextView
                android:textSize="@dimen/ayp_12sp"
                android:gravity="center_vertical"
                android:id="@+id/tv_test_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4sp"
                android:layout_marginStart="@dimen/_8sdp"/>
        </LinearLayout>
    </LinearLayout>
    <RadioButton
        android:id="@+id/rb_select_test"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_dots"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/gray66"/>
    <View
        android:id="@+id/view_divider_1"
        android:background="@color/grayE5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
