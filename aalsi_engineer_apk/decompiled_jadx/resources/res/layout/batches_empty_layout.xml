<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="#e5e5e5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="30dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/empty_batches_imageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/batches_empty_header"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_black_87_opacity"
            android:id="@+id/empty_batches_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="@dimen/ayp_16dp"
            android:layout_marginRight="40dp"
            android:singleLine="false"
            android:lineSpacingExtra="3sp"
            android:inputType="textMultiLine"
            android:textAlignment="center"/>
        <TextView
            android:textAppearance="@style/empty_subhead"
            android:gravity="top|center_horizontal"
            android:id="@+id/empty_batches_subtitle_text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:lineSpacingExtra="4sp"
            android:alpha="0.6"
            android:translationY="-2.15sp"/>
        <TextView
            android:textAppearance="@style/empty_button_text_style"
            android:gravity="center_vertical"
            android:id="@+id/empty_batches_button"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:drawableLeft="@drawable/ic_layer_addition"
            android:drawablePadding="@dimen/ayp_16dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:lineSpacingExtra="5sp"
            android:drawableStart="@drawable/ic_layer_addition"
            app:srcCompat="@drawable/empty_button_drawable"/>
    </LinearLayout>
</FrameLayout>
