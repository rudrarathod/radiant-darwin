<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/addAddressToolbar"
        android:background="@drawable/bg_primary_color_gradient"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/tint_black"
                android:gravity="center"
                android:background="@drawable/rounded_corner_light_blue_bg"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/study_material_shipped_address"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/ts_14sp"
                android:textColor="@color/black"
                android:id="@+id/tvFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/full_name"/>
            <LinearLayout
                android:id="@+id/llFullName"
                android:background="@drawable/shape_rectangle_gray_outline_r8"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_8dp">
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/name_hint"
                    android:inputType="text"
                    android:imeOptions="actionNext"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@android:color/transparent"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/ts_14sp"
                android:textColor="@color/black"
                android:id="@+id/tvAddressLine1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sixteen_dp"
                android:text="@string/address_line_1"/>
            <LinearLayout
                android:id="@+id/llAddressLine1"
                android:background="@drawable/shape_rectangle_gray_outline_r8"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_8dp">
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:id="@+id/etAddressLine1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/eg_hno_120"
                    android:inputType="text"
                    android:imeOptions="actionNext"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@android:color/transparent"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/ts_14sp"
                android:textColor="@color/black"
                android:id="@+id/tvAddressLine2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sixteen_dp"
                android:text="@string/address_line_2"/>
            <LinearLayout
                android:id="@+id/llAddressLine2"
                android:background="@drawable/shape_rectangle_gray_outline_r8"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_8dp">
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:id="@+id/etAddressLine2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/eg_civil_lines"
                    android:inputType="text"
                    android:imeOptions="actionNext"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@android:color/transparent"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/ts_14sp"
                android:textColor="@color/black"
                android:id="@+id/tvLandmark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sixteen_dp"
                android:text="@string/landmark"/>
            <LinearLayout
                android:id="@+id/llLandmark"
                android:background="@drawable/shape_rectangle_gray_outline_r8"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_8dp">
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:id="@+id/etLandmark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/eg_civil_lines"
                    android:inputType="text"
                    android:imeOptions="actionNext"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@android:color/transparent"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/ts_14sp"
                android:textColor="@color/black"
                android:id="@+id/tvCityDistrict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sixteen_dp"
                android:text="@string/city_district"/>
            <LinearLayout
                android:id="@+id/llCityDistrict"
                android:background="@drawable/shape_rectangle_gray_outline_r8"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_8dp">
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:id="@+id/etCityDistrict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/eg_delhi"
                    android:inputType="text"
                    android:imeOptions="actionNext"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@android:color/transparent"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/ts_14sp"
                android:textColor="@color/black"
                android:id="@+id/tvState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sixteen_dp"
                android:text="@string/state"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llState"
                android:background="@drawable/shape_rectangle_gray_outline_r8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_8dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tvStateSelection"
                    android:padding="12dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="@string/select_a_state"
                    android:layout_weight="1"
                    app:drawableEndCompat="@drawable/ic_arrow_drop_down_black"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/ts_14sp"
                android:textColor="@color/black"
                android:id="@+id/tvPinCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sixteen_dp"
                android:text="@string/pincode"/>
            <LinearLayout
                android:id="@+id/llPinCode"
                android:background="@drawable/shape_rectangle_gray_outline_r8"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_8dp">
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:id="@+id/etPinCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/eg_pincode"
                    android:lines="1"
                    android:maxLength="6"
                    android:inputType="number"
                    android:imeOptions="actionNext"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@android:color/transparent"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/ts_14sp"
                android:textColor="@color/black"
                android:id="@+id/tvMobileNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sixteen_dp"
                android:text="@string/mobile_number"/>
            <LinearLayout
                android:id="@+id/ll_enter_no"
                android:background="@drawable/shape_rectangle_gray_outline_r8"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_8dp">
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:id="@+id/et_mobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/eg_phone"
                    android:maxLength="10"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@android:color/transparent"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorText"
                android:gravity="center"
                android:id="@+id/yourAddressCantChange"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/ayp_8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/address_cant_be_changed"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:cardElevation="10dp"
        app:cardPreventCornerOverlap="false">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llBtnDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <CheckBox
                android:textSize="14sp"
                android:textColor="@color/black"
                android:id="@+id/setDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/set_as_default"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/save_button"
                android:background="@drawable/rounded_corner_blue_bg"
                android:clickable="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/save"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginStart="24dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
