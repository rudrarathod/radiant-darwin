<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_dialog_top"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/aya_40dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/tint_black"
            android:gravity="center_horizontal"
            android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="5sp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/gray66"
            android:gravity="center_horizontal"
            android:id="@+id/tv_dialog_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4sp"/>
        <Button
            android:textSize="16sp"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_done"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="@dimen/aya_24dp"
            android:text="@string/thanks_got_it"
            android:lineSpacingExtra="5sp"
            android:textAllCaps="false"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
