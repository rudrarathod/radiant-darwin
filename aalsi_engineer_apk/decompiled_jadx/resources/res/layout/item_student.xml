<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/white"
        android:padding="@dimen/ayp_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?android:attr/selectableItemBackground">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_student_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/ic_launcher"/>
        <TextView
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_student_name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="2dp"
            android:maxLines="2"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            style="@style/BaseTextAppearance.Title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/colorSecondaryText"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_waiting_to_join"
            android:background="@drawable/waiting_to_join_shape"
            android:paddingLeft="5dp"
            android:paddingTop="3dp"
            android:paddingRight="5dp"
            android:paddingBottom="3dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:text="@string/on_sms"
            android:layout_marginEnd="15dp"/>
        <ImageView
            android:id="@+id/iv_dots"
            android:padding="4dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/ic_dots_black"/>
    </LinearLayout>
</LinearLayout>
