<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_offline_download_files"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:id="@+id/app_bar_layout"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@drawable/bg_primary_color_gradient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="0dp"
            app:contentInsetStartWithNavigation="0dp"
            app:layout_scrollFlags="enterAlways|scroll"
            app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:titleMarginEnd="0dp">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/tv_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="16dp"
                style="@style/TextAppearance.AppCompat.Widget.ActionBar.Title"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/tv_sort"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:text="@string/sort"
                android:drawablePadding="5dp"
                android:layout_marginHorizontal="12dp"/>
        </androidx.appcompat.widget.Toolbar>
        <include
            android:id="@+id/common_search_ui"
            layout="@layout/common_search_new_ui"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/offline_download_files_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <include
        android:id="@+id/ll_empty_state"
        layout="@layout/layout_download_content_not_found"/>
</LinearLayout>
