<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/_16sdp"
    android:paddingRight="@dimen/_16sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/_16sdp">
    <ImageView
        android:id="@+id/iv_course_image"
        android:layout_width="@dimen/_90sdp"
        android:layout_height="@dimen/_65sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:src="@drawable/course_placeholder"
        android:scaleType="fitXY"
        android:layout_marginEnd="@dimen/_16sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_coupon_discount"
        android:background="@drawable/shape_rectangle_filled_orange_r2"
        android:paddingLeft="@dimen/_8sdp"
        android:paddingTop="@dimen/_4sdp"
        android:paddingRight="@dimen/_8sdp"
        android:paddingBottom="@dimen/_4sdp"
        android:layout_width="@dimen/_75sdp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_minus9sdp"
        android:layout_marginStart="@dimen/_8sdp"
        android:paddingHorizontal="@dimen/_8sdp"
        android:paddingVertical="@dimen/_4sdp"
        app:layout_constraintStart_toStartOf="@+id/iv_course_image"
        app:layout_constraintTop_toBottomOf="@+id/iv_course_image">
        <ImageView
            android:id="@+id/iv_icon_coupon"
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_10sdp"
            android:src="@drawable/ic_nav_active_icon"
            android:layout_marginEnd="@dimen/_4sdp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_coupon_discount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tags"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginStart="@dimen/_14sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_course_image"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/color_3C4852"
        android:ellipsize="end"
        android:id="@+id/tv_course_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:maxLines="2"
        android:lineSpacingExtra="@dimen/_2sdp"
        android:layout_marginStart="@dimen/_14sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_course_image"
        app:layout_constraintTop_toBottomOf="@+id/rv_tags"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/colorPrimary"
        android:gravity="center"
        android:id="@+id/tv_continue_learning"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:text="@string/continue_learning"
        android:maxLines="1"
        android:drawablePadding="@dimen/_4sdp"
        android:layout_marginStart="@dimen/_14sdp"
        app:drawableEndCompat="@drawable/arrow_right_blue"
        app:layout_constraintStart_toEndOf="@+id/iv_course_image"
        app:layout_constraintTop_toBottomOf="@+id/tv_course_title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_price_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginStart="@dimen/_14sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_course_image"
        app:layout_constraintTop_toBottomOf="@+id/tv_continue_learning">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_3C4852"
            android:id="@+id/tv_disc_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/_8sdp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_7A8B94"
            android:id="@+id/tv_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/_8sdp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_FFAD3B"
            android:id="@+id/tv_discount"
            android:padding="@dimen/_2sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <View
        android:id="@+id/view_bottom_divider"
        android:background="@color/grayF2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:layout_marginTop="@dimen/_22sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_course_image"/>
</androidx.constraintlayout.widget.ConstraintLayout>
