<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cl_custom_exo_controls"
    android:background="@drawable/bidirectional_gradient"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_back"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_video_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_video_title"
        app:srcCompat="@drawable/ic_back_long_white"/>
    <TextView
        android:textSize="18sp"
        android:textColor="#dddddd"
        android:ellipsize="middle"
        android:gravity="center"
        android:id="@+id/tv_video_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="52dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="52dp"
        android:maxLines="2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/exo_play_pause"
        android:padding="@dimen/ayp_16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tintMode="src_in"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white"
        style="@style/ExoMediaButton.Play"/>
    <ImageView
        android:id="@+id/exo_rewind"
        android:padding="4dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="84dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_rewind"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/tv_dcr_val"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/custom_exo_controls_b_tv_dcr_val_text"
        android:alpha="0"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/exo_rew"
        app:layout_constraintRight_toLeftOf="@+id/exo_rew"
        app:layout_constraintTop_toTopOf="@+id/exo_rew"/>
    <ImageView
        android:id="@+id/exo_forward"
        android:padding="4dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="84dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_fforward"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/tv_incr_val"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/custom_exo_controls_b_tv_incr_val_text"
        android:alpha="0"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/exo_ffwd"
        app:layout_constraintLeft_toRightOf="@+id/exo_ffwd"
        app:layout_constraintTop_toTopOf="@+id/exo_ffwd"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/tv_left_time"
        android:background="#80000000"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:paddingStart="40dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/exo_progress"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="start"
        android:id="@+id/exo_position"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/ll_fullscreen"
        app:layout_constraintRight_toLeftOf="@+id/tv_1"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/tv_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/custom_exo_controls_b_tv_1_text"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/exo_duration"
        app:layout_constraintRight_toLeftOf="@+id/exo_duration"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="end"
        android:id="@+id/exo_duration"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/exo_position"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/exo_position"/>
    <androidx.media3.ui.DefaultTimeBar
        android:id="@+id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="26dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_fullscreen"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/exo_position"
        app:played_color="@color/colorPrimary"
        app:scrubber_color="@color/colorPrimaryDark"
        app:unplayed_color="@color/colorSecondaryText"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_speed"
        android:padding="12sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/ll_quality">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_speed"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/tv_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speed_1x"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_quality"
        android:padding="12sp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/ll_speed"
        app:layout_constraintRight_toLeftOf="@+id/ll_fullscreen">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/ic_high_quality"/>
        <TextView
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quality"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_fullscreen"
        android:padding="12sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintLeft_toRightOf="@+id/ll_quality"
        app:layout_constraintRight_toRightOf="parent">
        <ImageView
            android:id="@+id/iv_fullscreen"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/exo_icon_fullscreen_enter"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/tv_fullscreen_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fullscreen"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
