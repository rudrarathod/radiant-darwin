<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gray91"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layout_centerInParent="true">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/gray91"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@drawable/bg_primary_color_gradient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/colorSecondaryText"
            android:paddingTop="20dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:text="@string/name"
            android:textAllCaps="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_name"
            android:background="@color/white"
            android:paddingLeft="20dp"
            android:paddingTop="5dp"
            android:paddingRight="20dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:textSize="18sp"
                android:textColor="@color/black"
                android:gravity="start|center_vertical"
                android:id="@+id/et_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/enter_name_here"
                android:maxLines="1"
                android:inputType="textCapSentences"
                android:imeOptions="actionNext"
                android:backgroundTint="@android:color/transparent"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/colorSecondaryText"
            android:paddingTop="20dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:text="@string/label_mobile_number_hint"
            android:textAllCaps="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_phone"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:textSize="18sp"
                android:textColor="@color/black"
                android:gravity="start|center_vertical"
                android:id="@+id/et_mobile_no"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:hint="@string/label_mobile_number_hint"
                android:maxLength="10"
                android:layout_weight="1"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:layout_marginStart="20dp"
                android:backgroundTint="@android:color/transparent"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_delete_parent"
            android:background="@color/white"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <ImageView
                android:id="@+id/iv_delete_parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="@color/absent_red"
                app:srcCompat="@drawable/ic_delete"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/absent_red"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_delete_parent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:text="@string/delete_parent_alert_msg"
                android:layout_weight="1"
                android:inputType="number"
                android:imeOptions="actionDone"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
