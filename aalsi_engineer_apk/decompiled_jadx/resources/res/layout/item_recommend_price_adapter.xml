<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/priceCardView"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:paddingLeft="@dimen/ayp_16dp"
            android:paddingTop="15dp"
            android:paddingRight="@dimen/ayp_16dp"
            android:paddingBottom="@dimen/ayp_16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="#000000"
                android:gravity="start|center_vertical"
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@{itemName}"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorPrimaryText"
                android:gravity="end|center_vertical"
                android:id="@+id/tvAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@{price}"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/dotted_division"
            android:background="@drawable/item_dotted"
            android:paddingTop="@dimen/ayp_2dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ayp_16dp"
            android:layout_marginRight="@dimen/ayp_16dp"
            android:layerType="software"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/division"
            android:background="#e5e5e5"
            android:paddingTop="@dimen/ayp_2dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="@dimen/ayp_16dp"
            android:layout_marginRight="@dimen/ayp_16dp"
            android:layerType="software"
            android:paddingEnd="@dimen/ayp_16dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
