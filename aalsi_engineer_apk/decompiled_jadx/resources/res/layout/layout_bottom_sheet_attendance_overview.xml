<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ayp_16dp">
            <TextView
                android:id="@+id/tv_overview_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/layout_bottom_sheet_attendance_overview_tv_overview_title_text"
                style="@style/BaseTextAppearance.HeavyWeightTitle"/>
            <ImageView
                android:id="@+id/iv_close"
                android:padding="@dimen/ayp_8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="@color/color_DE000000"
                app:srcCompat="@drawable/ic_close_cross"/>
        </LinearLayout>
        <View
            android:background="@color/gray79"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginBottom="24dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_99000000"
                android:gravity="center_vertical"
                android:id="@+id/tv_bottom_sheet_date"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <CheckBox
                android:textSize="14sp"
                android:textColor="@color/color_99000000"
                android:id="@+id/cb_send_sms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/send_sms"/>
        </LinearLayout>
        <View
            android:background="@color/gray79"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginBottom="16dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/ll_topic_covered_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ayp_16dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_99000000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/topic_covered"
                android:layout_weight="2"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/colorPrimaryText"
                android:gravity="center"
                android:id="@+id/tv_bottom_sheet_topic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_8dp"
                android:maxLines="2"
                android:layout_weight="1"
                style="@style/BaseTextAppearance.HeavyWeightTitle"/>
        </LinearLayout>
        <View
            android:background="@color/gray79"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginBottom="16dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="1">
            <TextView
                android:id="@+id/tv_subtitle_label1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/students_present"
                android:layout_weight="1"
                style="@style/BaseTextAppearance.HeavyWeightTitle"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_num_present"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/BaseTextAppearance.HeavyWeightTitle"/>
        </LinearLayout>
        <View
            android:background="@color/gray79"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="@dimen/ayp_16dp"
            android:layout_marginBottom="16dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="1">
            <TextView
                android:id="@+id/tv_subtitle_label2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/student_absent"
                android:layout_weight="1"
                style="@style/BaseTextAppearance.HeavyWeightTitle"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_num_absent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/BaseTextAppearance.HeavyWeightTitle"/>
        </LinearLayout>
        <View
            android:background="@color/gray79"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>
    </LinearLayout>
    <View
        android:background="@color/gray79"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/btn_bottom_sheet_save"
        android:background="@drawable/bg_button_click_color_primary"
        android:padding="10dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/layout_bottom_sheet_attendance_overview_btn_bottom_sheet_save_text"
        android:textAllCaps="false"/>
</LinearLayout>
