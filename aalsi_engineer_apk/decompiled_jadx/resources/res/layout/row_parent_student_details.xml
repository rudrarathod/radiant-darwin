<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="0dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="20dp"
            android:paddingEnd="0dp">
            <TextView
                android:textSize="17sp"
                android:textColor="@color/colorPrimaryText"
                android:ellipsize="end"
                android:gravity="top"
                android:id="@+id/tv_parent_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textIsSelectable="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_parent_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:textIsSelectable="true"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/colorSecondaryText"
                    android:layout_gravity="center"
                    android:id="@+id/tv_waiting_to_join"
                    android:background="@drawable/waiting_to_join_shape"
                    android:paddingLeft="5dp"
                    android:paddingTop="3dp"
                    android:paddingRight="5dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/on_sms"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_call_parent"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:tint="@color/colorPrimary"
            app:srcCompat="@drawable/ic_call_outline"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_chat"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:tint="@color/colorPrimary"
            app:srcCompat="@drawable/ic_chat"/>
        <ImageView
            android:id="@+id/iv_edit_parent"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:tint="@color/colorPrimary"
            app:srcCompat="@drawable/ic_edit_pencil"/>
    </LinearLayout>
    <View
        android:background="@color/divider"
        android:layout_width="match_parent"
        android:layout_height="0.2dp"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"/>
</LinearLayout>
