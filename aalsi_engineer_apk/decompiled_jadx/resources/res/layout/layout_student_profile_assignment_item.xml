<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="0dp"
    app:cardElevation="1dp">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:ellipsize="end"
                android:id="@+id/tvAssignmentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:maxLines="1"
                android:maxEms="10"
                android:scrollHorizontally="true"
                android:layout_toLeftOf="@+id/ll_status_container"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                style="@style/BaseTextAppearance.Title"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_status_container"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_hw_status"
                    android:background="@drawable/shape_rectangle_filled_white_outline_gray_r17"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:visibility="visible"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:text="@string/not_submitted"/>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorText_Black_Alpha_99"
            android:id="@+id/tvCreatorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollHorizontally="true"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/tvCalender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/mdi_calendar_today"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/colorText_Black_Alpha_99"
                    android:gravity="start"
                    android:id="@+id/tvDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="9dp"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    style="@style/BaseTextAppearance.SubTitle"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
