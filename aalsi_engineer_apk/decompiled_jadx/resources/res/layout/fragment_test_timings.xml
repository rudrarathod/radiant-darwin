<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gray91"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ll_btn_done">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_offline_proprofs_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:id="@+id/tv_date_label"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/date"
                    android:textAllCaps="true"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/royalblue"
                    android:id="@+id/tv_select_date"
                    android:background="@color/white"
                    android:paddingLeft="20dp"
                    android:paddingTop="15dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_date"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:id="@+id/tv_time_label"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/time_no_caps"
                    android:textAllCaps="true"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/royalblue"
                    android:id="@+id/tv_select_time"
                    android:background="@color/white"
                    android:paddingLeft="20dp"
                    android:paddingTop="15dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_time"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_cms_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ll_offline_proprofs_time">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:id="@+id/tv_start_time_label"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/fragment_test_timings_tv_start_time_label_text"
                    android:textAllCaps="true"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/royalblue"
                    android:id="@+id/tv_select_start_time"
                    android:background="@color/white"
                    android:paddingLeft="20dp"
                    android:paddingTop="15dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_start_date_time"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:id="@+id/tv_end_time_label"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/fragment_test_timings_tv_end_time_label_text"
                    android:textAllCaps="true"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/royalblue"
                    android:id="@+id/tv_select_end_time"
                    android:background="@color/white"
                    android:paddingLeft="20dp"
                    android:paddingTop="15dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_end_date_time"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_noa"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorSecondaryText"
                        android:id="@+id/tv_no_of_attempts_label"
                        android:paddingTop="20dp"
                        android:paddingBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:text="@string/string_noa"
                        android:textAllCaps="true"/>
                    <EditText
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:id="@+id/et_no_of_attempts"
                        android:background="@color/white"
                        android:paddingLeft="20dp"
                        android:paddingTop="15dp"
                        android:paddingRight="20dp"
                        android:paddingBottom="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/String_enter_number_of_attempts"
                        android:maxLength="10"
                        android:digits="0123456789"
                        android:inputType="number"/>
                    <CheckBox
                        android:textSize="12sp"
                        android:id="@+id/cb_noa"
                        android:paddingLeft="5dp"
                        android:paddingTop="15dp"
                        android:paddingRight="20dp"
                        android:paddingBottom="15dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:text="@string/string_check_if_yo"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/grey_opaque"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_testbook_info"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/real_test_experience_switched_on_on_this_test_so_no_re_attempts_allowed"
                        android:lineSpacingExtra="4sp"
                        android:paddingStart="5dp"
                        android:paddingEnd="20dp"
                        android:layout_marginStart="20dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_show_results"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorSecondaryText"
                        android:paddingTop="20dp"
                        android:paddingBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:text="@string/result"
                        android:layout_weight="1"
                        android:textAllCaps="true"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/royalblue"
                        android:id="@+id/tv_sample_result"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:text="@string/fragment_test_timings_tv_sample_result_text"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.SwitchCompat
                        android:textSize="16sp"
                        android:textColor="@color/colorPrimaryText"
                        android:id="@+id/sw_test_result"
                        android:background="@color/white"
                        android:paddingLeft="20dp"
                        android:paddingTop="15dp"
                        android:paddingRight="20dp"
                        android:paddingBottom="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fragment_test_timings_sw_test_result_text"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_test_result_settings"
                        android:background="@color/white"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#99000000"
                            android:id="@+id/tv_show_result_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/select_when_do_you_want_to_display_the_result_for_this_test"/>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@+id/ll_deadline"
                            android:paddingTop="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/black"
                                android:id="@+id/tv_deadline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/fragment_test_timings_tv_deadline_text"
                                android:layout_weight="1"/>
                            <androidx.appcompat.widget.AppCompatRadioButton
                                android:id="@+id/rb_deadline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@+id/ll_specific_date"
                            android:paddingBottom="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/black"
                                android:id="@+id/tv_on_specific_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/fragment_test_timings_tv_on_specific_date_text"
                                android:layout_weight="1"/>
                            <androidx.appcompat.widget.AppCompatRadioButton
                                android:id="@+id/rb_specific_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/ll_test_specific_time"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="14sp"
                                android:textColor="#99000000"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/date_amp_time"/>
                            <LinearLayout
                                android:layout_gravity="center"
                                android:orientation="horizontal"
                                android:id="@+id/ll_select_result_date"
                                android:background="@drawable/bg_rounded_corners_boundry"
                                android:padding="10dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="10dp">
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/black"
                                    android:id="@+id/tv_specific_date"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/fragment_test_timings_tv_specific_date_text"
                                    android:layout_weight="1"/>
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:tint="#99000000"
                                    app:srcCompat="@drawable/ic_time"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#99000000"
                        android:id="@+id/tv_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginRight="20dp"
                        android:text="@string/result_combination_msg"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorSecondaryText"
                android:id="@+id/tv_sms_label"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/sms_notif_caps"
                android:layout_below="@+id/ll_cms_time"
                android:textAllCaps="true"/>
            <LinearLayout
                android:gravity="start"
                android:orientation="horizontal"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_sms_label">
                <CheckBox
                    android:id="@+id/cb_send_sms_test"
                    android:paddingLeft="5dp"
                    android:paddingTop="15dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:checked="true"
                    android:text="@string/fragment_test_timings_cb_send_sms_test_text"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="start"
                android:orientation="horizontal"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_sms_label">
                <CheckBox
                    android:id="@+id/cb_remind_sms_test"
                    android:paddingLeft="5dp"
                    android:paddingTop="15dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:checked="true"
                    android:text="@string/fragment_test_timings_cb_remind_sms_test_text"/>
            </LinearLayout>
            <include
                android:visibility="gone"
                layout="@layout/common_progressbar"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_btn_done"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/b_done"
            android:background="@drawable/bg_button_click_color_primary"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/assign_test"
            android:textAllCaps="false"/>
    </LinearLayout>
</RelativeLayout>
