<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#50000000"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        app:cardUseCompatPadding="true">
        <RelativeLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/ll_sheet_top"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_sheet_cross"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tint="#000000"
                    app:srcCompat="@drawable/ic_close_cross"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/colorSecondaryText"
                    android:gravity="center"
                    android:id="@+id/tv_heading"
                    android:padding="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:text="@string/fileter_caps"
                    android:layout_weight="1"
                    android:textAllCaps="true"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/colorPrimaryDark"
                    android:gravity="center"
                    android:id="@+id/tv_select_all"
                    android:padding="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_all_caps"
                    android:layout_weight="1"
                    android:textAllCaps="true"/>
            </LinearLayout>
            <View
                android:id="@+id/v_sheet_divider"
                android:background="@color/gray79"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_below="@+id/ll_sheet_top"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_batches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@+id/tv_apply"
                android:layout_below="@+id/ll_sheet_top"/>
            <View
                android:background="@color/gray79"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_above="@+id/tv_apply"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorPrimaryDark"
                android:gravity="center"
                android:id="@+id/tv_apply"
                android:background="@color/white"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/apply"
                android:layout_alignParentBottom="true"
                android:textAllCaps="true"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
