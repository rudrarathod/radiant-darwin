<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/white"
        android:padding="@dimen/ayp_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_student_image"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@mipmap/ic_launcher"/>
        <TextView
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_student_name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:maxLines="2"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            style="@style/BaseTextAppearance.Title"/>
        <RelativeLayout
            android:background="@drawable/shape_rectangle_gray_outline_r6"
            android:layout_width="wrap_content"
            android:layout_height="30dp">
            <ImageView
                android:id="@+id/iv_accept"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:foreground="?android:attr/selectableItemBackground"
                android:maxWidth="24dp"
                android:tint="@color/ForestGreen"
                android:layout_alignTop="@+id/iv_reject"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                app:srcCompat="@drawable/ic_done_tick"/>
            <View
                android:id="@+id/view"
                android:background="@color/gray89"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_toRightOf="@+id/iv_accept"
                android:layout_centerInParent="true"
                android:layout_toEndOf="@+id/iv_accept"/>
            <ImageView
                android:id="@+id/iv_reject"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:foreground="?android:attr/selectableItemBackground"
                android:tint="@color/red3"
                android:layout_toRightOf="@+id/view"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/view"
                app:srcCompat="@drawable/ic_close_cross"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:id="@+id/dividerView"
        android:background="@color/grayE5"
        android:layout_width="match_parent"
        android:layout_height="0.75dp"/>
</LinearLayout>
