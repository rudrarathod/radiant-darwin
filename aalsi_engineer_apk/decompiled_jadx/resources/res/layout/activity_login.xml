<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_build_info"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="20dp"
            android:elevation="2dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_info_blue"/>
        <FrameLayout
            android:id="@+id/frameLayout"
            android:background="@drawable/bg_splash"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/shadow_gradient"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toTopOf="@+id/barrier"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/dotsLayout"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="@dimen/aya_24dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/shadow_gradient"
            app:layout_constraintEnd_toEndOf="@+id/viewPager2"
            app:layout_constraintStart_toStartOf="@+id/viewPager2"
            app:layout_constraintTop_toBottomOf="@+id/viewPager2"
            app:tabBackground="@drawable/tab_selector"
            app:tabGravity="center"
            app:tabIndicatorHeight="0dp"
            app:tabPaddingEnd="7dp"
            app:tabPaddingStart="7dp"/>
        <View
            android:id="@+id/shadow_gradient"
            android:background="@drawable/gradiencefill_light"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="5dp"
            app:layout_constraintBottom_toTopOf="@+id/barrier"
            app:layout_constraintTop_toBottomOf="@+id/dotsLayout"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/llSingleImageLogin"
            android:padding="@dimen/_48sdp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/shadow_gradient"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/ivSingleImage"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_margin="@dimen/_24sdp"
                android:src="@drawable/ic_login_single_image"/>
            <TextView
                android:textSize="24sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/tvSingleImageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_4sdp"
                android:lineSpacingExtra="3sp"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="layout_normal_login, layout_truecaller_whatsapp"
            app:layout_constraintTop_toBottomOf="@+id/shadow_gradient"/>
        <include
            android:id="@+id/layout_truecaller_whatsapp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier"
            layout="@layout/layout_truecaller_whatsapp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_normal_login"
            android:background="@drawable/shape_rectangle_filled_white_r10_tr_tl"
            android:paddingTop="24dp"
            android:paddingBottom="32dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tv_login_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/login_or_signup"
                android:layout_marginStart="24dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_enter_number_email"
                app:layout_constraintLeft_toLeftOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:id="@+id/tv_enter_number_email"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="@dimen/eight_dp"
                android:text="@string/enter_your_mobile_number"
                android:lineSpacingExtra="4sp"
                android:layout_marginStart="@dimen/aya_24dp"
                android:layout_marginEnd="@dimen/aya_24dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_login_heading"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_enter_no"
                android:background="@drawable/shape_rectangle_filled_white_outline_gray_r6"
                android:paddingLeft="10dp"
                android:paddingTop="3dp"
                android:paddingRight="10dp"
                android:paddingBottom="3dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_margin="@dimen/aya_24dp"
                app:layout_constraintBottom_toTopOf="@+id/cl_guest_login"
                app:layout_constraintTop_toBottomOf="@+id/tv_enter_number_email">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorText"
                    android:gravity="center"
                    android:id="@+id/tv_cc_initial"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/india_code"/>
                <View
                    android:id="@+id/divider"
                    android:background="@color/divider"
                    android:layout_width="1dp"
                    android:layout_height="38dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:layout_marginStart="10dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/et_mobile"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_mobile_number_hint"
                    android:maxLength="10"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <Button
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_continue"
                android:background="@drawable/bg_button_click_gradient"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:textAllCaps="false"
                app:layout_constraintBottom_toTopOf="@+id/cl_guest_login"
                app:layout_constraintTop_toBottomOf="@+id/tv_enter_number_email"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center_vertical"
                android:id="@+id/cl_guest_login"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="@dimen/aya_24dp"
                android:layout_marginEnd="@dimen/aya_24dp"
                app:layout_constraintTop_toBottomOf="@+id/ll_enter_no">
                <View
                    android:id="@+id/line_1"
                    android:background="@color/grayE5"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    app:layout_constraintBottom_toBottomOf="@+id/label_1"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/label_1"
                    app:layout_constraintTop_toTopOf="@+id/label_1"/>
                <TextView
                    android:id="@+id/label_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:text="@string/or"
                    app:layout_constraintLeft_toRightOf="@+id/line_1"
                    app:layout_constraintRight_toLeftOf="@+id/line_2"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/line_2"
                    android:background="@color/grayE5"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    app:layout_constraintBottom_toBottomOf="@+id/label_1"
                    app:layout_constraintLeft_toRightOf="@+id/label_1"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/label_1"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/progress_front"
                    android:gravity="center"
                    android:id="@+id/tv_guest_login"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/explore_as_a_guest"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/line_2"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/progress_front"
                    android:gravity="center"
                    android:id="@+id/tv_login_as_different_user"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/login_as_a_different_user"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/line_2"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
