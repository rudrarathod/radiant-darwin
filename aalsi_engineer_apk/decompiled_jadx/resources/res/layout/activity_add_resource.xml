<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/gray91"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@drawable/bg_primary_color_gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/colorSecondaryText"
                    android:textColorHint="@color/link"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/video_link"
                    android:textAllCaps="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:paddingLeft="20dp"
                    android:paddingTop="5dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:textSize="18sp"
                        android:textColor="@color/link"
                        android:textColorHint="@color/link"
                        android:id="@+id/et_enter_link"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/activity_add_resource_et_enter_link_hint"
                        android:maxLines="3"
                        android:imeOptions="actionDone"
                        android:backgroundTint="@android:color/transparent"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_video_metadata"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="5dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/iv_video_thumbnail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@color/black"
                            android:scaleType="centerCrop"
                            android:layout_centerInParent="true"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:id="@+id/tv_video_duration"
                            android:background="#66000000"
                            android:paddingLeft="3dp"
                            android:paddingRight="3dp"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:id="@+id/tv_video_live"
                            android:background="@color/absent_red"
                            android:paddingLeft="3dp"
                            android:paddingRight="3dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/live"
                            android:layout_alignParentRight="true"
                            android:layout_alignParentBottom="true"
                            android:textAllCaps="true"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorSecondaryText"
                        android:textColorHint="@color/link"
                        android:paddingTop="20dp"
                        android:paddingBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:text="@string/title"
                        android:textAllCaps="true"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:background="@color/white"
                        android:paddingLeft="20dp"
                        android:paddingTop="5dp"
                        android:paddingRight="20dp"
                        android:paddingBottom="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <EditText
                            android:textSize="18sp"
                            android:textColor="@color/black"
                            android:id="@+id/et_enter_title"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:maxLines="3"
                            android:imeOptions="actionDone"
                            android:backgroundTint="@android:color/transparent"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorSecondaryText"
                        android:textColorHint="@color/link"
                        android:id="@+id/tv_category_label"
                        android:paddingTop="20dp"
                        android:paddingBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:text="@string/category"
                        android:textAllCaps="true"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_select_category"
                        android:background="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="18sp"
                            android:textColor="@color/black"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:id="@+id/tv_categories"
                            android:paddingLeft="20dp"
                            android:paddingTop="15dp"
                            android:paddingRight="20dp"
                            android:paddingBottom="15dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:hint="@string/activity_add_resource_tv_categories_hint"
                            android:maxLines="4"
                            android:layout_weight="4"/>
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_weight="1"
                            app:srcCompat="@drawable/ic_chevron_right"
                            app:tint="@color/colorSecondaryText"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_btn_done"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp">
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/b_done"
                    android:background="@drawable/bg_button_click_color_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_16sdp"
                    android:text="@string/check_link"
                    android:textAllCaps="false"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
