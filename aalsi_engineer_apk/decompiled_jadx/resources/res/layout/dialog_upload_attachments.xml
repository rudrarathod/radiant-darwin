<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:layout_width="350dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="10dp">
    <RelativeLayout
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/iv_dialog_top"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_centerHorizontal="true"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/upload_animation"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/dialog_upload_attachments_tv_dialog_title_text"
            android:layout_below="@+id/iv_dialog_top"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#99000000"
            android:gravity="center_horizontal"
            android:id="@+id/tv_dialog_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/uploading_text"
            android:layout_below="@+id/tv_dialog_title"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorText_Black_Alpha_99"
            android:id="@+id/tv_dialog_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_below="@+id/tv_dialog_description"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorText_Black_Alpha_99"
            android:id="@+id/tv_dialog_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_below="@+id/tv_dialog_description"
            android:layout_alignParentEnd="true"/>
        <ProgressBar
            android:id="@+id/dialog_progressBar"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/drawable_view_progress_batch"
            android:layout_below="@+id/tv_dialog_count"
            app:srcCompat="@drawable/drawable_view_progress_batch"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:layout_below="@+id/dialog_progressBar">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/royalblue"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_done"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:textAllCaps="true"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
