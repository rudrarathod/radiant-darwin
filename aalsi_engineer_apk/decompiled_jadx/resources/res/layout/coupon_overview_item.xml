<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content_coupon"
    android:background="@drawable/shape_rectangle_filled_white_outline_gray_r6"
    android:paddingTop="15dp"
    android:paddingBottom="15dp"
    android:clipToPadding="false"
    android:layout_width="215dp"
    android:layout_height="wrap_content"
    android:paddingStart="15dp"
    android:paddingEnd="15dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_tutor_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/coupon_icon_overview"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/coupon_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="16dp"/>
            <TextView
                android:textSize="@dimen/ayp_12sp"
                android:textColor="@color/colorText_Black_Alpha_99"
                android:ellipsize="end"
                android:id="@+id/coupon_discount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="2"
                android:layout_marginStart="15dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
