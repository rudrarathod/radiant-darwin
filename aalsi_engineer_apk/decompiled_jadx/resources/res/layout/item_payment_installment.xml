<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="20dp"
    android:paddingTop="5dp"
    android:paddingRight="20dp"
    android:paddingBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="5dp"
        app:cardElevation="0dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_item_header"
                android:paddingLeft="20dp"
                android:paddingTop="10dp"
                android:paddingRight="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:gravity="start|center_vertical"
                        android:id="@+id/tv_instalment_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="2"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/tv_instalment_is_paid"
                        android:background="@color/present_green"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="15dp"
                        android:text="@string/paid_caps"
                        android:textAllCaps="true"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/link"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_instalment_view_notes"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/item_payment_installment_tv_instalment_view_notes_text"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llPayViaEzCredAvailable"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:textSize="@dimen/ayp_12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pay_via"/>
                    <ImageView
                        android:background="@drawable/bg_ezcred"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:textSize="@dimen/ayp_12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/available"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:id="@+id/view_divider_1"
                android:background="@color/gray79"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/ll_item_header"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_installment_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/view_divider_1">
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingLeft="20dp"
                    android:paddingTop="10dp"
                    android:paddingRight="5dp"
                    android:paddingBottom="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="20dp"
                    android:paddingEnd="5dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorSecondaryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="@string/fee_amount"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_instalment_fee_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorSecondaryText"
                        android:id="@+id/tv_instalment_due_date_heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="5dp"
                        android:text="@string/item_payment_installment_tv_instalment_due_date_heading_text"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_instalment_due_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <View
                    android:background="@color/gray91"
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingLeft="20dp"
                    android:paddingTop="10dp"
                    android:paddingRight="5dp"
                    android:paddingBottom="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="20dp"
                    android:paddingEnd="5dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorSecondaryText"
                        android:id="@+id/tv_instalment_tax_heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="@string/tax_amount_exclduing"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_instalment_tax_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorSecondaryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="5dp"
                        android:text="@string/total_amount"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_instalment_total_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:id="@+id/view_divider_2"
                android:background="@color/gray79"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_below="@+id/ll_installment_details"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/view_divider_2">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/link"
                    android:gravity="center"
                    android:id="@+id/tv_instalment_download"
                    android:padding="12dp"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/download_receipt"
                    android:maxLines="2"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/link"
                    android:gravity="center"
                    android:id="@+id/tv_instalment_edit"
                    android:padding="12dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:text="@string/edit_instalment"
                    android:maxLines="2"
                    android:layout_weight="1"/>
                <View
                    android:id="@+id/view_vertical_divider"
                    android:background="@color/gray91"
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/red3"
                    android:gravity="center"
                    android:id="@+id/tv_instalment_delete"
                    android:padding="12dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:text="@string/item_payment_installment_tv_instalment_delete_text"
                    android:layout_weight="1"/>
            </LinearLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
