<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="FILTER"
            android:layout_weight="1"/>
        <ImageView
            android:gravity="center_vertical"
            android:id="@+id/iv_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/ic_live_class_close"/>
    </LinearLayout>
    <View
        android:background="@color/grayE5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DATE"/>
    <RadioGroup
        android:id="@+id/rg_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioButton
            android:textSize="16sp"
            android:id="@+id/rb_today"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Today"
            android:layoutDirection="rtl"
            android:paddingVertical="12dp"/>
        <RadioButton
            android:textSize="16sp"
            android:id="@+id/rb_yesterday"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yesterday"
            android:layoutDirection="rtl"
            android:paddingVertical="12dp"/>
        <RadioButton
            android:textSize="16sp"
            android:id="@+id/rb_last_seven"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last 7 Days"
            android:layoutDirection="rtl"
            android:paddingVertical="12dp"/>
        <RadioButton
            android:textSize="16sp"
            android:id="@+id/rb_last_fifteen"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last 15 Days"
            android:layoutDirection="rtl"
            android:paddingVertical="12dp"/>
        <RadioButton
            android:textSize="16sp"
            android:id="@+id/rb_last_thirty"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last 30 Days"
            android:layoutDirection="rtl"
            android:paddingVertical="12dp"/>
        <RadioButton
            android:textSize="16sp"
            android:id="@+id/rb_last_quarter"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last 3 Months"
            android:layoutDirection="rtl"
            android:paddingVertical="12dp"/>
    </RadioGroup>
    <View
        android:background="@color/grayE5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/white"
        android:id="@+id/apply_button"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/apply"
        android:textAllCaps="false"
        android:paddingVertical="12dp"
        app:backgroundTint="@color/colorPrimary"/>
</LinearLayout>
