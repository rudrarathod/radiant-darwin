<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#e5e5e5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@drawable/bg_primary_color_gradient"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/black"
        android:id="@+id/usageExhaustedLayout"
        android:background="@color/expired_strip"
        android:paddingLeft="20dp"
        android:paddingTop="8dp"
        android:paddingRight="20dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbar"
        android:textAlignment="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
    <ScrollView
        android:background="@color/gray91"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_above="@+id/bottom_shareWhatsapp"
        android:layout_below="@+id/usageExhaustedLayout"
        android:layout_centerInParent="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ayp_16dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_99000000"
                    android:id="@+id/tv_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/couponDetails"
                    android:layout_weight="1"
                    android:textAllCaps="true"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/link"
                    android:id="@+id/tv_viewHistory"
                    android:paddingLeft="@dimen/ayp_16dp"
                    android:paddingTop="@dimen/ayp_16dp"
                    android:paddingRight="@dimen/ayp_16dp"
                    android:paddingBottom="@dimen/ayp_8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/viewCouponHistory"
                    android:textAllCaps="true"/>
            </LinearLayout>
            <LinearLayout
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/ayp_16dp"
                    android:layout_marginTop="@dimen/ayp_16dp"
                    android:layout_marginRight="@dimen/ayp_16dp"
                    android:layout_marginStart="@dimen/ayp_16dp"
                    android:layout_marginEnd="@dimen/ayp_16dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="16sp"
                                android:textColor="@color/color_282828"
                                android:ellipsize="end"
                                android:id="@+id/amountLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="200dp"
                                android:singleLine="true"
                                android:layout_centerVertical="true"/>
                            <ImageView
                                android:id="@+id/dot"
                                android:layout_width="4dp"
                                android:layout_height="4dp"
                                android:src="@drawable/unselected_dot"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="10dp"
                                android:layout_toEndOf="@+id/amountLabel"
                                app:tint="@color/coupon_dot_color"/>
                            <TextView
                                android:textSize="16sp"
                                android:textColor="@color/type_text"
                                android:id="@+id/studentType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="10dp"
                                android:layout_toEndOf="@+id/dot"/>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_alignParentEnd="true">
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:id="@+id/llLabel_couponStatus"
                                    android:background="@drawable/shape_rectangle_filled_white_radius_2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">
                                    <TextView
                                        android:textSize="12sp"
                                        android:textColor="@color/white"
                                        android:gravity="end"
                                        android:layout_gravity="center"
                                        android:id="@+id/couponStatus"
                                        android:padding="4dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/active_caps"/>
                                </LinearLayout>
                            </LinearLayout>
                        </RelativeLayout>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorText_Black_Alpha_99"
                            android:ellipsize="end"
                            android:id="@+id/couponName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:maxLines="1"
                            android:maxEms="15"
                            android:scrollHorizontally="true"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorText_Black_Alpha_99"
                            android:ellipsize="end"
                            android:id="@+id/couponCreatedBy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:maxLines="1"
                            android:maxEms="15"
                            android:scrollHorizontally="true"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:id="@+id/ll_Date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/imgFootericon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:scaleType="fitXY"
                                app:srcCompat="@drawable/icon_for_coupon"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/color_666666"
                                    android:gravity="start"
                                    android:id="@+id/titleCouponCode"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/coupon_code_x"
                                    android:maxLines="1"
                                    android:layout_marginStart="8dp"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/color_DE000000"
                                    android:ellipsize="end"
                                    android:gravity="start"
                                    android:id="@+id/couponCode"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:maxLength="20"
                                    android:layout_marginEnd="30dp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:background="#e5e5e5"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/ayp_16dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ayp_16dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:tint="#6e000000"
                            app:srcCompat="@drawable/ic_clock_time"/>
                        <TextView
                            android:textColor="@color/colorText_Black_Alpha_99"
                            android:id="@+id/startDateTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ayp_8dp"/>
                        <TextView
                            android:textColor="@color/colorText_Black_Alpha_99"
                            android:id="@+id/dashSeperator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:layout_marginStart="@dimen/ayp_8dp"/>
                        <TextView
                            android:textColor="@color/colorText_Black_Alpha_99"
                            android:id="@+id/endDateTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ayp_8dp"/>
                    </LinearLayout>
                    <View
                        android:background="#e5e5e5"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/ayp_16dp"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/tv_usageTillDate"
                        android:background="@drawable/shape_rectangle_gray_outline_r2"
                        android:padding="@dimen/ayp_16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ayp_16dp">
                        <ImageView
                            android:layout_width="@dimen/aya_24dp"
                            android:layout_height="@dimen/aya_24dp"
                            android:layout_marginEnd="@dimen/ayp_16dp"
                            app:srcCompat="@drawable/usagetilldate"/>
                        <TextView
                            android:textColor="@color/black_opaque"
                            android:id="@+id/usageTillDateText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#009ae0"
                            android:id="@+id/numberUsageTillDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/tv_total_students"
                        android:background="@drawable/shape_rectangle_gray_outline_r2"
                        android:padding="@dimen/ayp_16dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ayp_16dp">
                        <ImageView
                            android:layout_width="@dimen/aya_24dp"
                            android:layout_height="@dimen/aya_24dp"
                            android:layout_marginEnd="@dimen/ayp_16dp"
                            app:srcCompat="@drawable/totalstudents"/>
                        <TextView
                            android:textColor="#de000000"
                            android:id="@+id/totalStudentsText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#009ae0"
                            android:id="@+id/number_totalStudents"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_assignedcourses"
                        android:background="@drawable/shape_rectangle_gray_outline_r2"
                        android:padding="@dimen/ayp_16dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ayp_16dp">
                        <ImageView
                            android:layout_width="@dimen/aya_24dp"
                            android:layout_height="@dimen/aya_24dp"
                            android:layout_marginEnd="@dimen/ayp_16dp"
                            app:srcCompat="@drawable/assignedcourses"/>
                        <TextView
                            android:textColor="#de000000"
                            android:id="@+id/assignedCoursesText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#009ae0"
                            android:id="@+id/number_assignedcourses"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_minimumOrderValue"
                        android:background="@drawable/shape_rectangle_gray_outline_r2"
                        android:padding="@dimen/ayp_16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ayp_16dp">
                        <ImageView
                            android:layout_width="@dimen/aya_24dp"
                            android:layout_height="@dimen/aya_24dp"
                            android:layout_marginEnd="@dimen/ayp_16dp"
                            app:srcCompat="@drawable/minordervalue"/>
                        <TextView
                            android:textColor="#de000000"
                            android:id="@+id/minOrderValueText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#009ae0"
                            android:id="@+id/number_minimumOrderValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/couponUsageLimit"
                        android:background="@drawable/shape_rectangle_gray_outline_r2"
                        android:padding="@dimen/ayp_16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ayp_16dp">
                        <ImageView
                            android:layout_width="@dimen/aya_24dp"
                            android:layout_height="@dimen/aya_24dp"
                            android:layout_marginEnd="@dimen/ayp_16dp"
                            app:srcCompat="@drawable/couponusagelimit"/>
                        <TextView
                            android:textColor="@color/black_opaque"
                            android:id="@+id/couponUsageLimitText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#009ae0"
                            android:id="@+id/number_couponUsageLimit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/usagePerStudent"
                        android:background="@drawable/shape_rectangle_gray_outline_r2"
                        android:padding="@dimen/ayp_16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ayp_16dp"
                        android:layout_marginBottom="@dimen/ayp_16dp">
                        <ImageView
                            android:layout_width="@dimen/aya_24dp"
                            android:layout_height="@dimen/aya_24dp"
                            android:layout_marginEnd="@dimen/ayp_16dp"
                            app:srcCompat="@drawable/couponusageperstudent"/>
                        <TextView
                            android:textColor="@color/black_opaque"
                            android:id="@+id/usagePerStudentText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#009ae0"
                            android:id="@+id/number_usagePerStudent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/ll_shareCoupon"
                android:background="@color/white"
                android:paddingLeft="20dp"
                android:paddingTop="16dp"
                android:paddingRight="20dp"
                android:paddingBottom="15dp"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">
                <ImageView
                    android:id="@+id/iv_sharecoupon"
                    android:layout_width="@dimen/ayp_16dp"
                    android:layout_height="@dimen/ayp_16dp"
                    android:tint="@color/link"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="16dp"
                    app:srcCompat="@drawable/ic_share_new"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/link"
                    android:id="@+id/sharecoupon_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coupon_share_button_text"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/iv_sharecoupon"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    app:srcCompat="@drawable/arrow_right_blue"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/ll_makeInactive"
                android:background="@color/white"
                android:paddingLeft="20dp"
                android:paddingTop="16dp"
                android:paddingRight="20dp"
                android:paddingBottom="15dp"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ayp_8dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_makeinactive"
                    android:layout_width="@dimen/ayp_16dp"
                    android:layout_height="@dimen/ayp_16dp"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="16dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/link"
                    android:id="@+id/makeinactive_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/make_inactive"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/iv_makeinactive"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    app:srcCompat="@drawable/arrow_right_blue"/>
            </RelativeLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/deleteLayout"
                android:background="@color/white"
                android:paddingLeft="20dp"
                android:paddingTop="16dp"
                android:paddingRight="20dp"
                android:paddingBottom="15dp"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    app:srcCompat="@drawable/ic_delete"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/filter_done"
                    android:id="@+id/delete_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/deleteCouponText"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/bottom_shareWhatsapp"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ll_shareWhatsapp"
            android:background="@drawable/bg_btn_share_whatsapp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="16dp">
            <ImageView
                android:id="@+id/ivShareIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_whatsapp_outline"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:id="@+id/tv_share_whatsapp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_on_whatsapp"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
