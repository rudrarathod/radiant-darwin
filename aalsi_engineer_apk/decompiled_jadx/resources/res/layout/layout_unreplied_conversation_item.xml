<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="100dp"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/bg_unreplied_conversation_ring"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <ImageView
            android:id="@+id/ivConversationIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/ivOnlineStatus"
            android:background="@drawable/shape_circle_filled_green"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginBottom="4dp"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="4dp"
            android:layout_alignParentEnd="true"
            android:backgroundTint="#00ff00"/>
    </RelativeLayout>
    <TextView
        android:textSize="12sp"
        android:ellipsize="end"
        android:id="@+id/tvConversationName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:maxLines="1"
        android:textAlignment="center"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>
</LinearLayout>
