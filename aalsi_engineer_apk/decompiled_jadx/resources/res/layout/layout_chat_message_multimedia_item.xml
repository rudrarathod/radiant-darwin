<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/tv_unread_count"
        android:background="@color/lightblue"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"/>
    <TextView
        android:textSize="14sp"
        android:gravity="center"
        android:id="@+id/date"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/date"
        android:layout_below="@+id/tv_unread_count"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/date"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true">
        <ImageView
            android:id="@+id/iv_user_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"/>
        <LinearLayout
            android:id="@+id/message_layout_left"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/message_width_change_layout_left_outer"
                android:background="@drawable/chat_message_shape_left"
                android:paddingLeft="5dp"
                android:paddingTop="5dp"
                android:paddingRight="5dp"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/sender_left"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:lineSpacingExtra="4dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/llReplyLayout"
                    android:background="@drawable/reply_chat_message_shape_left"
                    android:padding="@dimen/_4sdp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_3sdp">
                    <TextView
                        android:textSize="@dimen/ayp_12sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@+id/tvMetaTitle"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/ivReplyImage"
                        android:visibility="gone"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/ic_default_meta_image"
                        android:paddingEnd="@dimen/_6sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvMetaTitle"/>
                    <TextView
                        android:textSize="@dimen/ts_14sp"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:id="@+id/tvParentTextUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:maxLines="1"
                        app:layout_constraintStart_toEndOf="@+id/ivReplyImage"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/ts_14sp"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:id="@+id/tvParentUserText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:maxLines="2"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivReplyImage"
                        app:layout_constraintTop_toBottomOf="@+id/tvParentTextUserName"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <RelativeLayout
                    android:id="@+id/message_width_change_layout_left_inner"
                    android:padding="@dimen/_4sdp"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="125dp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:id="@+id/imageView_message_left"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:layout_centerInParent="true"
                            app:srcCompat="@drawable/ic_image_placeholder"/>
                    </androidx.cardview.widget.CardView>
                    <ProgressBar
                        android:id="@+id/progress_bar_left"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"/>
                    <ImageView
                        android:id="@+id/imageView_download_left"
                        android:visibility="gone"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_margin="8dp"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        app:srcCompat="@drawable/ic_download_attachment"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/message_layout_resend_click_left"
                    android:paddingLeft="5dp"
                    android:paddingTop="8dp"
                    android:paddingRight="5dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:textColorLink="@color/link"
                        android:autoLink="all"
                        android:id="@+id/message_left"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"/>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/black"
                        android:gravity="right"
                        android:id="@+id/time_left"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toRightOf="@+id/message_width_change_layout_left_outer"
                android:layout_alignTop="@+id/message_width_change_layout_left_outer"
                android:layout_alignBottom="@+id/message_width_change_layout_left_outer"
                android:layout_toEndOf="@+id/message_width_change_layout_left_outer">
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabDoodleLeft"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:tint="@color/white"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    app:backgroundTint="@color/divider"
                    app:fabSize="mini"
                    app:srcCompat="@drawable/ic_brush"/>
            </RelativeLayout>
        </LinearLayout>
        <TextView
            android:textStyle="italic"
            android:textColor="@color/black"
            android:id="@+id/deletedMsgLeft"
            android:background="@drawable/chat_message_shape_left"
            android:padding="15dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/ic_deleted_blocked"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_below="@+id/date">
        <RelativeLayout
            android:id="@+id/message_layout_right"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/message_width_change_layout_right_outer"
                android:background="@drawable/chat_message_shape_right"
                android:paddingLeft="5dp"
                android:paddingTop="5dp"
                android:paddingRight="5dp"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="8dp"
                android:layout_alignParentEnd="true">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/llReplyLayoutRight"
                    android:background="@drawable/reply_chat_message_shape_right"
                    android:padding="@dimen/_6sdp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_2sdp">
                    <TextView
                        android:textSize="@dimen/ayp_12sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:id="@+id/tvMetaTitleRight"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/ivReplyImageRight"
                        android:visibility="gone"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/ic_default_meta_image"
                        android:paddingEnd="@dimen/_6sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvMetaTitleRight"/>
                    <TextView
                        android:textSize="@dimen/ts_14sp"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:id="@+id/tvParentTextUserNameRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:maxLines="1"
                        app:layout_constraintStart_toEndOf="@+id/ivReplyImageRight"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/ts_14sp"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:id="@+id/tvParentUserTextRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:maxLines="1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivReplyImageRight"
                        app:layout_constraintTop_toBottomOf="@+id/tvParentTextUserNameRight"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <RelativeLayout
                    android:id="@+id/message_width_change_layout_right_inner"
                    android:padding="@dimen/_4sdp"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="125dp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:id="@+id/imageView_message_right"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:layout_centerInParent="true"
                            app:srcCompat="@drawable/ic_image_placeholder"/>
                    </androidx.cardview.widget.CardView>
                    <ProgressBar
                        android:id="@+id/progress_bar_right"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"/>
                    <ImageView
                        android:id="@+id/imageView_download_right"
                        android:visibility="visible"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_margin="8dp"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        app:srcCompat="@drawable/ic_download_attachment"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/message_layout_resend_click_right"
                    android:paddingLeft="4dp"
                    android:paddingTop="8dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:textColorLink="@color/white"
                        android:autoLink="all"
                        android:id="@+id/message_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="3dp"/>
                    <LinearLayout
                        android:gravity="end|center_vertical"
                        android:layout_gravity="end|center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="10sp"
                            android:textColor="@color/white"
                            android:id="@+id/time_right"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="end|center_vertical"
                        android:layout_gravity="end|center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="10sp"
                            android:textColor="@color/red3"
                            android:id="@+id/textViewTapToResend"
                            android:paddingTop="5dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tap_to_resend"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="20dp"
                android:layout_toLeftOf="@+id/message_width_change_layout_right_outer"
                android:layout_alignTop="@+id/message_width_change_layout_right_outer"
                android:layout_alignBottom="@+id/message_width_change_layout_right_outer"
                android:layout_marginStart="20dp"
                android:layout_toStartOf="@+id/message_width_change_layout_right_outer">
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabDoodleRight"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="16dp"
                    android:tint="@color/white"
                    android:layout_marginEnd="16dp"
                    app:backgroundTint="@color/divider"
                    app:fabSize="mini"
                    app:srcCompat="@drawable/ic_brush"/>
            </RelativeLayout>
            <TextView
                android:textSize="14sp"
                android:id="@+id/tvSeenRight"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:text="@string/layout_chat_message_multimedia_item_tvSeenRight_text"
                android:layout_below="@+id/message_width_change_layout_right_outer"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:textStyle="italic"
            android:textColor="@color/black"
            android:layout_gravity="end"
            android:id="@+id/deletedMsgRight"
            android:background="@drawable/chat_message_shape_left"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/ic_deleted_blocked"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
    </LinearLayout>
</RelativeLayout>
