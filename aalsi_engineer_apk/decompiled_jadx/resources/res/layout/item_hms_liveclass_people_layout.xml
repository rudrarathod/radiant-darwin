<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clRootView"
    android:tag="layout/item_hms_liveclass_people_layout_0"
    android:paddingTop="@dimen/_4sdp"
    android:paddingBottom="@dimen/_4sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_5sdp"
    android:paddingStart="@dimen/_8sdp"
    android:paddingEnd="@dimen/_2sdp">
    <ImageView
        android:id="@+id/iv_participant_pic"
        android:visibility="visible"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_22sdp"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_user_default_icon"/>
    <TextView
        android:textSize="@dimen/_10ssp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tvParticipantInitials"
        android:background="@drawable/shape_circle_filled_red_1"
        android:visibility="gone"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_22sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivStudentsActivitySymbol"
        android:padding="@dimen/_4sdp"
        android:visibility="gone"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_22sdp"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_live_class_mic_enabled"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvParticipantName"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/_120sdp"
        android:maxLines="1"
        android:layout_marginStart="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_participant_pic"
        app:layout_constraintStart_toEndOf="@+id/iv_participant_pic"
        app:layout_constraintTop_toTopOf="@+id/iv_participant_pic"
        style="@style/nunito_sans_semi_bold_14_black"/>
    <ImageView
        android:id="@+id/ivBlockedStatus"
        android:background="?android:attr/selectableItemBackground"
        android:padding="@dimen/_2sdp"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_new_blocked_user"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        android:layout_marginStart="@dimen/_6sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvParticipantName"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textStyle="normal"
        android:id="@+id/tvAdminLabel"
        android:background="@drawable/bg_liveclasschat_admin_label"
        android:paddingTop="@dimen/_3sdp"
        android:paddingBottom="@dimen/_3sdp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/admin"
        android:layout_alignParentTop="true"
        android:paddingStart="@dimen/_6sdp"
        android:paddingEnd="@dimen/_6sdp"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_alignParentStart="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivBlockedStatus"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/nunito_sans_regular_10_chat"/>
    <ImageView
        android:id="@+id/ivHandRaiseAcceptReject"
        android:background="?android:attr/selectableItemBackground"
        android:padding="@dimen/_5sdp"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="@dimen/_24sdp"
        android:layout_height="@dimen/_24sdp"
        android:src="@drawable/ic_tick_liveclass_people"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivHandRaiseReject"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivHandRaiseReject"
        android:background="?android:attr/selectableItemBackground"
        android:padding="@dimen/_5sdp"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="@dimen/_24sdp"
        android:layout_height="@dimen/_24sdp"
        android:src="@drawable/ic_cross_liveclass_people"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivMenuOptions"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivMenuOptions"
        android:background="?android:attr/selectableItemBackground"
        android:padding="@dimen/_5sdp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/_26sdp"
        android:layout_height="@dimen/_26sdp"
        android:src="@drawable/ic_ellipsis_dots_liveclass_people_grey"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
