<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/rl_left"
            android:layout_width="70dp"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="4dp"
                app:cardElevation="0dp">
                <RelativeLayout
                    android:id="@+id/rl_thumbnail"
                    android:layout_width="70dp"
                    android:layout_height="50dp">
                    <ImageView
                        android:id="@+id/iv_thumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:foregroundGravity="center"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/color_white"
                        android:id="@+id/tv_duration"
                        android:background="#87000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:layout_alignParentBottom="true"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <ProgressBar
                android:id="@+id/pb_view_progress"
                android:background="@drawable/drawable_view_progress"
                android:layout_width="70dp"
                android:layout_height="4dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progressDrawable="@drawable/drawable_view_progress"
                android:layout_below="@+id/cv_thumbnail"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
            <ImageView
                android:id="@+id/iv_locked"
                android:background="@drawable/bg_round_grey_stroke_white"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:tint="@color/white"
                android:layout_centerInParent="true"
                app:srcCompat="@drawable/ic_lock"/>
            <ImageView
                android:id="@+id/iv_play"
                android:background="@drawable/bg_round_grey_stroke_white"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:tint="@color/white"
                android:layout_centerInParent="true"
                app:srcCompat="@drawable/ic_play_arrow"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@+id/iv_student_locked"
            android:layout_toEndOf="@+id/rl_left">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorPrimaryText"
                android:ellipsize="end"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_views_remaining"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:tint="@color/colorSecondaryText"
                    app:srcCompat="@drawable/ic_remove_red_eye"/>
                <TextView
                    android:textSize="14sp"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_views_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_duration_remaining"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:tint="@color/colorSecondaryText"
                    app:srcCompat="@drawable/ic_clock_time"/>
                <TextView
                    android:textSize="14sp"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_duration_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <TextView
                android:textSize="10sp"
                android:textColor="#5aa367"
                android:id="@+id/tv_threshold"
                android:background="#8ef6a0"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textAllCaps="true"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/pb_downloading"
            android:visibility="visible"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:indeterminate="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:layout_toStartOf="@+id/ll_update_status"/>
        <ImageView
            android:id="@+id/iv_download"
            android:visibility="visible"
            android:layout_width="25dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:layout_toStartOf="@+id/ll_update_status"/>
        <ImageView
            android:id="@+id/iv_student_locked"
            android:visibility="visible"
            android:layout_width="25dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:layout_toStartOf="@+id/iv_download"
            app:srcCompat="@drawable/ic_locked"/>
        <LinearLayout
            android:id="@+id/ll_update_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="16sp"
                android:id="@+id/tv_update_status"
                android:padding="4dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:background="#efefef"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
