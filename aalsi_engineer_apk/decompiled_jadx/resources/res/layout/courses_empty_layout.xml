<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:background="#f1f1f1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/courses_empty_imageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/empty_courses"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_DE000000"
                android:id="@+id/courses_empty_title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="@dimen/ayp_16dp"
                android:layout_marginRight="40dp"
                android:singleLine="false"
                android:lineSpacingExtra="3sp"
                android:inputType="textMultiLine"
                android:textAlignment="center"/>
            <TextView
                android:textAppearance="@style/empty_subhead"
                android:textColor="@color/color_99000000"
                android:gravity="top|center_horizontal"
                android:id="@+id/courses__empty_subtitle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/student_courses_empty_subheading"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:lineSpacingExtra="4sp"
                android:translationY="-2.15sp"/>
            <TextView
                android:textAppearance="@style/empty_button_text_style"
                android:textSize="14sp"
                android:gravity="center"
                android:id="@+id/empty_button"
                android:layout_width="153dp"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:text="@string/empty_courses_button_text"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:lineSpacingExtra="5sp"
                app:srcCompat="@drawable/empty_button_drawable"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
