<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ayp_8dp"
    app:cardElevation="1dp">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_toLeftOf="@+id/marks"
                android:layout_alignParentLeft="true"
                android:layout_toStartOf="@+id/marks"
                android:layout_alignParentStart="true"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:gravity="end"
                android:id="@+id/marks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="10sp"
                    android:textColor="@color/ForestGreen"
                    android:gravity="center_vertical"
                    android:id="@+id/testTypeOnline"
                    android:background="@drawable/shape_rectangle_filled_online_test_green_r17"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="@string/label_online_test"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="10sp"
                    android:textColor="@color/colorSecondaryText"
                    android:gravity="center_vertical"
                    android:id="@+id/testTypeOffline"
                    android:background="@drawable/shape_offline_test"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="@string/class_test"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="10sp"
                    android:textColor="@color/black"
                    android:gravity="center_vertical"
                    android:id="@+id/testTypePractice"
                    android:background="@drawable/shape_practice_test"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="@string/practice_test"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="10sp"
                    android:textColor="@color/black"
                    android:gravity="center_vertical"
                    android:id="@+id/testTypeSubjective"
                    android:background="@drawable/shape_subjective_test"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="@string/subjective_test"/>
            </LinearLayout>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="#99000000"
                    android:id="@+id/createdByName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <View
                    android:id="@+id/bullet"
                    android:background="@drawable/shape_circle_transparent_black_no_outline"
                    android:visibility="gone"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_margin="@dimen/ayp_8dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="#99000000"
                    android:ellipsize="marquee"
                    android:id="@+id/batchName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLength="25"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_timings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <ImageView
                android:id="@+id/iv_clock"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:maxWidth="18dp"
                android:maxHeight="18dp"
                android:tint="#99000000"
                app:srcCompat="@drawable/ic_clock_time"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="#99000000"
                android:id="@+id/tv_timings"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.cardview.widget.CardView>
