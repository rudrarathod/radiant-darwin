<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cv_subcategory"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/_16sdp"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:id="@+id/ll_rb"
        android:paddingTop="@dimen/_3sdp"
        android:paddingBottom="@dimen/_3sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/_6sdp"
        android:paddingEnd="@dimen/_10sdp"
        android:paddingVertical="@dimen/_3sdp">
        <RadioButton
            android:textSize="14sp"
            android:textColor="@color/color_3C4852"
            android:gravity="center"
            android:id="@+id/rb_option"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="Student"
            android:drawablePadding="0dp"
            android:buttonTint="@color/switch_radio_track_selector"
            style="@style/Widget.AppCompat.CompoundButton.RadioButton"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
