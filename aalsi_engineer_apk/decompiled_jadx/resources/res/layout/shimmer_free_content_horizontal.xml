<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_view_container"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp"
    app:shimmer_duration="800">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/cardView3"
                android:background="#52000000"
                android:layout_width="@dimen/_230sdp"
                android:layout_height="@dimen/_130sdp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:elevation="0dp"
                app:cardCornerRadius="6dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <View
                    android:id="@+id/ivContentPreview"
                    android:background="#52000000"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/ivPlayIcon"
                    android:background="#52000000"
                    android:visibility="gone"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_play_video_free_content"/>
                <View
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/tvDuration"
                    android:background="#52000000"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_12sdp"/>
            </androidx.cardview.widget.CardView>
            <View
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tvContentTitle"
                android:background="#52000000"
                android:layout_width="@dimen/_230sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="@+id/cardView3"
                app:layout_constraintStart_toStartOf="@+id/cardView3"
                app:layout_constraintTop_toBottomOf="@+id/cardView3"/>
            <View
                android:textColor="@color/colorPrimary"
                android:id="@+id/tvShowContent"
                android:background="#52000000"
                android:layout_width="@dimen/_74sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="@+id/cardView3"
                app:layout_constraintTop_toBottomOf="@+id/tvContentTitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/cardView4"
                android:background="#52000000"
                android:layout_width="@dimen/_230sdp"
                android:layout_height="@dimen/_130sdp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:elevation="0dp"
                app:cardCornerRadius="6dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <View
                    android:id="@+id/ivContentPreview2"
                    android:background="#52000000"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/ivPlayIcon2"
                    android:background="#52000000"
                    android:visibility="gone"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_play_video_free_content"/>
                <View
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_gravity="end|bottom"
                    android:background="#52000000"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_12sdp"/>
            </androidx.cardview.widget.CardView>
            <View
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tvContentTitle2"
                android:background="#52000000"
                android:layout_width="@dimen/_230sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="@+id/cardView4"
                app:layout_constraintStart_toStartOf="@+id/cardView4"
                app:layout_constraintTop_toBottomOf="@+id/cardView4"/>
            <View
                android:textColor="@color/colorPrimary"
                android:background="#52000000"
                android:layout_width="@dimen/_74sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="@+id/cardView4"
                app:layout_constraintTop_toBottomOf="@+id/tvContentTitle2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
