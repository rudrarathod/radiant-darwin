<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/frame1"
    android:paddingTop="48dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/aya_24dp"
    android:paddingStart="24dp"
    android:paddingEnd="22dp">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/tv_login_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="@dimen/eight_dp"
        android:text="@string/sign_in_to_unlock"
        app:layout_constraintBottom_toTopOf="@+id/tv_enter_number_email"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/tv_enter_number_email"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="@dimen/eight_dp"
        android:text="@string/you_are_currently_logged_in_as_a_guest_don_t_miss_out_sign_in_to_get_full_access_now"
        android:lineSpacingExtra="4sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_login_heading"/>
    <Button
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btn_continue"
        android:background="@drawable/bg_button_click_gradient"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aya_24dp"
        android:textAllCaps="false"
        app:layout_constraintBottom_toTopOf="@+id/cl_guest_login"
        app:layout_constraintTop_toBottomOf="@+id/tv_enter_number_email"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:id="@+id/cl_guest_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_continue">
        <View
            android:id="@+id/line_1"
            android:background="@color/grayE5"
            android:layout_width="0dp"
            android:layout_height="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/label_1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/label_1"
            app:layout_constraintTop_toTopOf="@+id/label_1"/>
        <TextView
            android:id="@+id/label_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:text="@string/or"
            app:layout_constraintLeft_toRightOf="@+id/line_1"
            app:layout_constraintRight_toLeftOf="@+id/line_2"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/line_2"
            android:background="@color/grayE5"
            android:layout_width="0dp"
            android:layout_height="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/label_1"
            app:layout_constraintLeft_toRightOf="@+id/label_1"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/label_1"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/progress_front"
            android:gravity="center"
            android:id="@+id/tv_login_as_different_user"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="28dp"
            android:text="@string/login_as_a_different_user"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/line_2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
