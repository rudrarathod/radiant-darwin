<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layout_challenges"
    android:background="@color/grayF1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rlBackgroundImage"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rl_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:id="@+id/tvMissingOut"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/layout_challenges_card_tvMissingOut_text"
                android:textAllCaps="false"
                android:layout_marginStart="16dp"/>
            <LinearLayout
                android:id="@+id/llRank"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp">
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/ivRank"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        app:srcCompat="@drawable/ic_rank"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorText_Black_Alpha_99"
                        android:id="@+id/textRank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_toEndOf="@+id/ivRank"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:id="@+id/tvRank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/textRank"
                        android:layout_marginStart="8dp"
                        android:layout_toEndOf="@+id/ivRank"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/llPoints"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="50dp"
                android:layout_toEndOf="@+id/llRank">
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/ivPoints"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        app:srcCompat="@drawable/ic_price_cut"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorText_Black_Alpha_99"
                        android:id="@+id/textPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_toEndOf="@+id/ivPoints"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:id="@+id/tvPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/textPoints"
                        android:layout_marginStart="8dp"
                        android:layout_toEndOf="@+id/ivPoints"/>
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/button_color"
            android:id="@+id/tvScoreboard"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/layout_challenges_card_tvScoreboard_text"
            android:layout_below="@+id/rl_main"
            android:paddingStart="16dp"
            android:paddingEnd="10dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rlWinPoints"
        android:background="@color/white"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:id="@+id/ivBottomPoints"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_win_points"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black"
            android:id="@+id/tvWinPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="20dp"
            android:layout_toEndOf="@+id/ivBottomPoints"/>
        <ImageView
            android:id="@+id/ivNext"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:tint="@color/black"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/arrow_right_blue"/>
    </RelativeLayout>
</LinearLayout>
