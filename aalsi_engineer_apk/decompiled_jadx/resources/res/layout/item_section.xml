<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/banner"
    android:background="@color/assignment_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentTop="true">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/colorText_Black_Alpha_99"
        android:gravity="center_vertical"
        android:id="@+id/tv_heading"
        android:padding="10dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:textAllCaps="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_sort_type"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/ic_sort_new"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorSecondaryText"
            android:gravity="center_vertical"
            android:id="@+id/tv_sort_type"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/sort"
            android:textAllCaps="true"
            android:layout_marginStart="3dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_filter"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_filter"
            android:layout_width="14dp"
            android:layout_height="14dp"
            app:srcCompat="@drawable/ic_filter_outline"
            app:tint="@color/colorSecondaryText"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorSecondaryText"
            android:gravity="center_vertical"
            android:id="@+id/tv_filter"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/filter"
            android:textAllCaps="true"
            android:layout_marginStart="3dp"/>
    </LinearLayout>
</LinearLayout>
