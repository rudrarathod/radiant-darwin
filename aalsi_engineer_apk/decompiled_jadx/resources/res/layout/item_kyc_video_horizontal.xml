<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ayp_16dp"
        android:layout_marginRight="@dimen/ayp_16dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="4dp"
        app:cardElevation="2dp">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rl_thumbnail"
                android:layout_width="160dp"
                android:layout_height="90dp">
                <ImageView
                    android:id="@+id/iv_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@color/colorSecondaryText"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"
                    android:foregroundGravity="center"/>
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_centerInParent="true"
                    app:srcCompat="@drawable/ic_play_button_gray"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_below="@+id/rl_thumbnail"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_alignStart="@+id/rl_thumbnail"
                android:layout_alignEnd="@+id/rl_thumbnail">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_emblem1"
                        android:background="@drawable/shape_rectangle_filled_light_blue_r2_borderless_new"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/color_99000000"
                            android:gravity="center_horizontal"
                            android:id="@+id/tv_emblem1"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_emblem2"
                        android:background="@drawable/shape_rectangle_filled_light_blue_r2_borderless_new"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:gravity="center_horizontal"
                            android:id="@+id/tv_emblem2"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12dp"
                            android:layout_marginRight="12dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</androidx.appcompat.widget.LinearLayoutCompat>
