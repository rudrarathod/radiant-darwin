<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginTop="10dp"
    android:layout_marginRight="12dp"
    android:layout_marginBottom="10dp">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:cardUseCompatPadding="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_attachment"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:maxHeight="400dp"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/gray89"
                app:cardCornerRadius="10dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_options"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/iv_attachment_type"
                        android:padding="7dp"
                        android:layout_width="40dp"
                        android:layout_height="40dp"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorPrimaryText"
                        android:ellipsize="end"
                        android:id="@+id/tv_attachment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="3dp"
                        android:maxLines="3"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/iv_download_attachment"
                        android:padding="7dp"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:tint="@color/black"
                        app:srcCompat="@drawable/ic_download"/>
                    <ProgressBar
                        android:id="@+id/pb_downloading"
                        android:padding="7dp"
                        android:visibility="visible"
                        android:layout_width="40dp"
                        android:layout_height="40dp"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/iv_remove_attachment"
                        android:padding="7dp"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:tint="@color/black"
                        app:srcCompat="@drawable/ic_close_cross"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
