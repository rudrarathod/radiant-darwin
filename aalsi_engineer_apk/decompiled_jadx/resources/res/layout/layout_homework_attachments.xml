<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="14dp"
    android:layout_marginTop="16dp"
    android:layout_marginRight="14dp">
    <ImageView
        android:id="@+id/iv_attachment"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:maxHeight="400dp"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/gray89"
        app:cardCornerRadius="2dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_options"
            android:background="@color/white"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_attachment_type"
                android:padding="7dp"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/pdf"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:id="@+id/tv_attachment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="20dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/failed_upload"
                android:id="@+id/tv_attachment_failed"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:text="@string/failed_to_upload"
                android:layout_marginEnd="10dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_download_attachment"
                android:padding="7dp"
                android:visibility="gone"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:tint="@color/black"
                app:srcCompat="@drawable/ic_download"/>
            <ProgressBar
                android:id="@+id/pb_downloading"
                android:padding="7dp"
                android:visibility="gone"
                android:layout_width="35dp"
                android:layout_height="35dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_remove_attachment"
                android:padding="7dp"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:tint="@color/black"
                app:srcCompat="@drawable/ic_close_cross"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
