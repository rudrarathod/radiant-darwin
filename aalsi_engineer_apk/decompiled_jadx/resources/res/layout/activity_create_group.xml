<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/colorPrimary"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">
        <LinearLayout
            android:gravity="start"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:gravity="center_vertical"
                android:id="@+id/iv_user_image"
                android:background="@drawable/shape_circle_gray_no_outline"
                android:visibility="visible"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_title_name"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="33dp"
                android:layout_marginLeft="8dp"
                android:singleLine="true"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
            <ImageView
                android:id="@+id/iv_options"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:tint="@color/white"
                android:contentDescription="@string/option"
                app:srcCompat="@drawable/ic_dots"/>
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:background="#f7f7f7"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ll_btn_done"
        android:layout_below="@+id/toolbar">
        <com.google.android.material.appbar.AppBarLayout
            android:background="#f7f7f7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:background="#f7f7f7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="enterAlways|scroll">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_name"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/colorSecondaryText"
                            android:gravity="start|center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/label_group_name"
                            android:layout_marginStart="16dp"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">
                            <EditText
                                android:textColorHint="@color/colorSecondaryText"
                                android:id="@+id/et_grp_name"
                                android:background="@color/white"
                                android:padding="16dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:hint="@string/label_hint_enter_group_name"
                                android:maxLines="1"
                                android:layout_weight="1"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/royalblue"
                                android:gravity="start|center_vertical"
                                android:id="@+id/tv_edit"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:text="@string/edit"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_data"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/ll_participants_group"
                            android:background="#f7f7f7"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/colorSecondaryText"
                                android:gravity="start|center_vertical"
                                android:id="@+id/tv_participants_group"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:text="@string/label_participants"
                                android:textAllCaps="true"
                                android:layout_marginStart="16dp"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/royalblue"
                                android:gravity="start|center_vertical"
                                android:id="@+id/tv_add_participants_group"
                                android:padding="4dp"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginRight="16dp"
                                android:text="@string/add_participants"
                                android:textAllCaps="true"
                                android:layout_marginEnd="16dp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/ll_search"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <include layout="@layout/divider"/>
                            <include layout="@layout/common_search_new"/>
                            <include layout="@layout/divider"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/ll_no_data"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            app:srcCompat="@drawable/ic_students_empty"/>
                        <TextView
                            android:textSize="20sp"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/label_no_participants_to_show"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/colorSecondaryText"
                            android:gravity="center"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/label_no_recp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:id="@+id/llAddParticipants"
                        android:background="@color/white"
                        android:paddingLeft="16dp"
                        android:paddingTop="8dp"
                        android:paddingRight="16dp"
                        android:paddingBottom="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:baselineAligned="false">
                        <RelativeLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/layoutImage"
                            android:background="@drawable/shape_circle_color_primary"
                            android:layout_width="44dp"
                            android:layout_height="44dp">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                app:srcCompat="@drawable/ic_add_participants"/>
                        </RelativeLayout>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:id="@+id/tv_description"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/add_participants"
                            android:layout_marginStart="16dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_participants"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/ll_btn_done"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_done"
            android:background="@drawable/bg_button_click_color_primary"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/label_create"
            android:textAllCaps="false"/>
    </LinearLayout>
</RelativeLayout>
