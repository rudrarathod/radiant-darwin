<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/white"
    android:padding="@dimen/_16sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_icon"
        android:layout_width="@dimen/_86sdp"
        android:layout_height="@dimen/_66sdp"
        android:elevation="0dp"
        app:cardCornerRadius="@dimen/_4sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_thumbnail"
            android:background="@color/color_52000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/course_placeholder"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ivPlayIcon"
            android:visibility="visible"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/ic_play_video_free_content"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:layout_gravity="end|bottom"
            android:id="@+id/tv_video_time"
            android:background="@drawable/shape_rectangle_filled_black_r1"
            android:paddingLeft="@dimen/_2sdp"
            android:paddingTop="@dimen/_1sdp"
            android:paddingRight="@dimen/_2sdp"
            android:paddingBottom="@dimen/_1sdp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:paddingHorizontal="@dimen/_2sdp"
            android:paddingVertical="@dimen/_1sdp"/>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:id="@+id/iv_play_pause"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_marginStart="@dimen/_35sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_play_button"
        app:tint="@color/white"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        app:layout_constraintEnd_toStartOf="@+id/iv_delete_button"
        app:layout_constraintStart_toEndOf="@+id/cv_icon"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_3C4852"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <ProgressBar
            android:id="@+id/pb_last_seek"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            app:srcCompat="@drawable/ic_progressbar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:id="@+id/tv_exhausted"
            android:background="@color/absent_red"
            android:padding="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="@string/item_offline_download_video_tv_exhausted_text"
            android:textAllCaps="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_7A8B94"
            android:id="@+id/tv_views"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:drawablePadding="@dimen/_4sdp"
            app:drawableStartCompat="@drawable/ic_remove_red_eye_secondary"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_7A8B94"
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:drawablePadding="@dimen/_4sdp"
            app:drawableStartCompat="@drawable/ic_clock_time_colorsecondarytext_small"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tv_license_expired"
            android:background="@drawable/shape_rectangle_gray_filled_r2"
            android:paddingLeft="@dimen/_6sdp"
            android:paddingTop="@dimen/_2sdp"
            android:paddingRight="@dimen/_6sdp"
            android:paddingBottom="@dimen/_2sdp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="@string/expired_caps"
            android:paddingHorizontal="@dimen/_6sdp"
            android:paddingVertical="@dimen/_2sdp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_delete_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_trash"/>
    <ProgressBar
        android:id="@+id/pb_loading"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_14sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_delete_button"
        app:srcCompat="@drawable/ic_trash"/>
</androidx.constraintlayout.widget.ConstraintLayout>
