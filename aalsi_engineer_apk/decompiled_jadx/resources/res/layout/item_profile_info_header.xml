<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/layout_header"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:id="@+id/order"
        android:background="@drawable/shape_circle_color_primary"
        android:paddingTop="2dp"
        android:layout_width="24dp"
        android:layout_height="24sp"
        android:textAlignment="center"
        android:lineHeight="21dp"
        android:textFontWeight="600"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/sectionName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_weight="1"
        style="@style/BaseTextAppearance.ShadowBoldTitle"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/editLayout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="5dp"
        android:layout_marginEnd="5dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_edit"
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:srcCompat="@drawable/ic_edit_white_24dp"
            app:tint="@color/link"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_add"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:srcCompat="@drawable/ic_add_circle_outline"
            app:tint="@color/link"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/link"
            android:id="@+id/tv_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="5dp"
            android:text="@string/edit"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="5dp"
            android:lineHeight="21dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon"
        android:background="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="@color/black"
        app:srcCompat="@drawable/ic_arrow_down_line"/>
</androidx.appcompat.widget.LinearLayoutCompat>
