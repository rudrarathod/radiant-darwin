<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <RelativeLayout
            android:gravity="center_horizontal"
            android:id="@+id/rl_left"
            android:layout_width="70dp"
            android:layout_height="50dp">
            <ImageView
                android:id="@+id/iv_thumbnail"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/iv_locked"
                android:background="@drawable/bg_round_grey_stroke_white"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:tint="@color/white"
                android:layout_centerInParent="true"
                app:srcCompat="@drawable/ic_lock"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@+id/ll_student_locked"
            android:layout_toEndOf="@+id/rl_left">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorPrimaryText"
                android:ellipsize="end"
                android:id="@+id/tv_doc_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorSecondaryText"
                android:ellipsize="end"
                android:id="@+id/tv_doc_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_student_locked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/ll_update_status">
            <ImageView
                android:id="@+id/iv_student_locked"
                android:visibility="visible"
                android:layout_width="25dp"
                android:layout_height="30dp"
                android:layout_marginStart="5dp"
                app:srcCompat="@drawable/ic_locked"/>
            <ImageView
                android:id="@+id/iv_download_doc"
                android:visibility="gone"
                android:layout_width="25dp"
                android:layout_height="30dp"
                android:layout_marginStart="5dp"
                app:srcCompat="@drawable/ic_download"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_update_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="16sp"
                android:id="@+id/tv_update_status"
                android:padding="4dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:background="#efefef"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
