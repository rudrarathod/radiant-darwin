<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ivUserDP"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="@dimen/ayp_16dp"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="@+id/tvUserType"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvUserName"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tvUserName"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/ayp_16dp"
        android:alpha="0.87"
        android:layout_marginStart="@dimen/ayp_16dp"
        app:layout_constraintStart_toEndOf="@+id/ivUserDP"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="italic"
        android:textColor="@color/black"
        android:gravity="center_vertical"
        android:id="@+id/tvUserType"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:alpha="0.6"
        android:layout_marginStart="@dimen/ayp_16dp"
        app:layout_constraintStart_toEndOf="@+id/ivUserDP"
        app:layout_constraintTop_toBottomOf="@+id/tvUserName"/>
</androidx.constraintlayout.widget.ConstraintLayout>
