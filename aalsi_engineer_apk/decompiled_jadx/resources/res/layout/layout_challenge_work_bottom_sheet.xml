<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/bottom_sheet_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="android.support.design.widget.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/ll_sheet_top"
        android:paddingTop="24dp"
        android:paddingBottom="@dimen/aya_24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black_opaque"
            android:id="@+id/tv_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/layout_challenge_work_bottom_sheet_tv_heading_text"
            android:layout_centerVertical="true"
            android:layout_marginStart="24dp"/>
        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="24dp"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_close"/>
    </RelativeLayout>
    <View
        android:id="@+id/v_sheet_divider"
        android:background="@color/gray79"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/black_opaque"
        android:id="@+id/textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/aya_24dp"
        android:text="@string/peer_challenge_how_works"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black_opaque"
            android:id="@+id/heading1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/layout_challenge_work_bottom_sheet_heading1_text"/>
        <ImageView
            android:id="@+id/ivPoint1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_win_points"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black_opaque"
            android:id="@+id/tvWon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/ivPoint1"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black_opaque"
            android:id="@+id/heading2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/layout_challenge_work_bottom_sheet_heading2_text"/>
        <ImageView
            android:id="@+id/ivPoint2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_win_points"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black_opaque"
            android:id="@+id/tvLost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/ivPoint2"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black_opaque"
            android:id="@+id/heading3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/layout_challenge_work_bottom_sheet_heading3_text"/>
        <ImageView
            android:id="@+id/ivPoint3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_win_points"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black_opaque"
            android:id="@+id/tvNotAttempted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/ivPoint3"/>
    </RelativeLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/black_opaque"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/aya_24dp"
        android:text="@string/challenge_as_many_as_you_can_and_climb_up_the_leaderboard"/>
    <View
        android:id="@+id/tv2"
        android:background="@color/gray79"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <Button
        android:textSize="16sp"
        android:textColor="#de000000"
        android:gravity="center"
        android:id="@+id/tv_apply"
        android:background="@color/white"
        android:padding="@dimen/ayp_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/dismiss"
        android:textAllCaps="true"
        style="@style/Widget.MaterialComponents.Button.TextButton"/>
</LinearLayout>
