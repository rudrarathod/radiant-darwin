<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:id="@+id/tv_image_aspect_info"
        android:background="@drawable/shape_rectangle_filled_light_blue_r5_borderless"
        android:paddingTop="@dimen/ayp_8dp"
        android:paddingBottom="@dimen/ayp_8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aya_24dp"
        android:text="@string/notification_bottom_sheet_info"
        android:textAlignment="center"
        android:paddingStart="@dimen/ayp_16dp"
        android:paddingEnd="@dimen/ayp_16dp"
        android:layout_marginStart="@dimen/aya_24dp"
        android:layout_marginEnd="@dimen/aya_24dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <View
        android:background="@color/gray79"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/red3"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?android:attr/selectableItemBackground"
        android:text="@string/cancel"
        android:textAllCaps="true"/>
</LinearLayout>
