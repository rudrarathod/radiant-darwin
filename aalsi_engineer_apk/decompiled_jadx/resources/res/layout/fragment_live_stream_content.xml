<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/grayF1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/layout_search_container"
                android:background="@color/gray91"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_alignParentTop="true">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/layout_search"
                    android:background="@drawable/shape_rectangle_filled_white_r7"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp">
                    <androidx.appcompat.widget.SearchView
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/search_view"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/colorSecondaryText"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/tv_search"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/label_search"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_data"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:gravity="center_horizontal"
                    android:id="@+id/text_info"
                    android:background="@drawable/shape_rectangle_filled_light_blue_r5_borderless"
                    android:padding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/label_live_streaming_processing"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/color_99000000"
                    android:id="@+id/tv_total_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="16dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_list"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_empty_state"
                android:background="@color/white"
                android:padding="10dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/iv_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="80dp"
                    app:srcCompat="@drawable/ic_empty_live_class"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_empty_title"
                    android:padding="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/you_dont_have_any_live_recordings_yet"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_empty_description"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/now_you_can_go_live"/>
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/btn_go_live_empty_state"
                    android:padding="10dp"
                    android:visibility="gone"
                    android:layout_width="238dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/go_live_now"
                    android:textAllCaps="false"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_gravity="end|bottom"
        android:id="@+id/fab_live"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="20dp"
        android:layout_alignParentEnd="true"
        app:backgroundTint="@color/colorAccent"
        app:fabSize="normal"
        app:pressedTranslationZ="12dp"
        app:srcCompat="@drawable/ic_go_live_fab"/>
</RelativeLayout>
