<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_dp"
                android:layout_width="130dp"
                android:layout_height="130dp"/>
            <TextView
                android:textColor="@color/colorPrimary"
                android:id="@+id/tv_change_dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/change_dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_personal_details"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/colorSecondaryText"
                    android:paddingLeft="10dp"
                    android:paddingTop="5dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/personal_details"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:weightSum="3">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/colorSecondaryText"
                        android:gravity="start"
                        android:paddingLeft="15dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/name"
                        android:layout_weight="1"/>
                    <EditText
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:id="@+id/et_name"
                        android:background="@android:color/transparent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLength="50"
                        android:layout_weight="2"
                        android:inputType="textPersonName"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:weightSum="3">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/colorSecondaryText"
                        android:gravity="start"
                        android:paddingLeft="15dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/mobile"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/colorSecondaryText"
                        android:id="@+id/tv_mobile_no"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:weightSum="3">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/colorSecondaryText"
                        android:gravity="start"
                        android:paddingLeft="15dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/text_email"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/colorSecondaryText"
                        android:id="@+id/tv_email"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:weightSum="3">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/colorSecondaryText"
                        android:gravity="start"
                        android:paddingLeft="15dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/about"
                        android:layout_weight="1"/>
                    <EditText
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:id="@+id/et_bio"
                        android:background="@android:color/transparent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:inputType="textShortMessage"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_bank_details"
                android:paddingBottom="5dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:paddingLeft="10dp"
                    android:paddingTop="5dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bank_details"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:weightSum="2">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/colorSecondaryText"
                        android:gravity="start"
                        android:paddingLeft="15dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/beneficiary_name"
                        android:layout_weight="1"/>
                    <EditText
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:id="@+id/et_beneficiary_name"
                        android:background="@android:color/transparent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="textPersonName"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:weightSum="2">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/colorSecondaryText"
                        android:gravity="start"
                        android:paddingLeft="15dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/account_no"
                        android:layout_weight="1"/>
                    <EditText
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:id="@+id/et_account_no"
                        android:background="@android:color/transparent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="number"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:weightSum="2">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/colorSecondaryText"
                        android:gravity="start"
                        android:paddingLeft="15dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/ifsc_code"
                        android:layout_weight="1"/>
                    <EditText
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:id="@+id/et_ifsc_code"
                        android:background="@android:color/transparent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="text"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
