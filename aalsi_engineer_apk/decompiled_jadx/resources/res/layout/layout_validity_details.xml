<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_validity"
        android:background="@color/white"
        android:paddingTop="@dimen/_16sdp"
        android:paddingBottom="@dimen/_16sdp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/_16sdp"
        android:paddingEnd="@dimen/_16sdp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_DE000000"
            android:id="@+id/tv_validity"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 Months . 3"
            android:layout_marginEnd="8dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="false"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="8sp"
                android:textColor="@color/white"
                android:id="@+id/tv_promoted"
                android:background="@drawable/shape_rectangle_filled_light_blue_r2_borderless_new"
                android:padding="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_promoted"/>
        </LinearLayout>
        <ImageButton
            android:id="@+id/stepOneArrowDown"
            android:background="@color/white"
            android:visibility="visible"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:contentDescription="downArrowButton"
            android:paddingStart="@dimen/ayp_16dp"
            android:paddingEnd="@dimen/ayp_16dp"
            app:srcCompat="@drawable/coupon_arrow_bottom"/>
        <ImageButton
            android:id="@+id/stepOneArrowUp"
            android:background="@color/white"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:contentDescription="upArrowButton"
            android:paddingStart="@dimen/ayp_16dp"
            android:paddingEnd="@dimen/ayp_16dp"
            app:srcCompat="@drawable/coupon_arrow_up"/>
    </LinearLayout>
    <View
        android:background="@color/gray91"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llStudentPriceDetails"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ayp_16dp"
        android:paddingEnd="@dimen/ayp_16dp">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPriceDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="@color/gray91"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryText"
                android:gravity="start|center_vertical"
                android:id="@+id/tvStudentAmountPayable"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorPrimaryText"
                android:gravity="end|center_vertical"
                android:id="@+id/tvStudentAmountPayableAmount"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="@color/gray91"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
