<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/aya_24dp"
    android:paddingStart="22dp"
    android:paddingEnd="22dp">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_282828"
        android:ellipsize="end"
        android:id="@+id/couponType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:maxEms="8"
        android:scrollHorizontally="true"
        android:textAllCaps="true"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ayp_8dp"
        android:layout_marginBottom="@dimen/ayp_16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorText_Black_Alpha_99"
            android:ellipsize="end"
            android:id="@+id/couponName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:maxEms="15"
            android:layout_weight="1"
            android:layout_marginEnd="40dp"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/llCouponExpire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/expireImage"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:tint="#ff4058"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ic_clock_time"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#ff4058"
                android:ellipsize="end"
                android:id="@+id/couponValidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_centerVertical="true"
                android:layout_marginStart="5dp"
                android:layout_toEndOf="@+id/expireImage"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:background="@color/grayE5"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ayp_8dp"
        android:layout_marginBottom="@dimen/ayp_8dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/couponId"
                android:background="@drawable/coupon_bgdash"
                android:paddingLeft="@dimen/ayp_12dp"
                android:paddingTop="@dimen/ayp_8dp"
                android:paddingRight="@dimen/ayp_12dp"
                android:paddingBottom="@dimen/ayp_8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/intercom_composer_blue"
            android:gravity="end"
            android:layout_gravity="center"
            android:id="@+id/couponAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAllCaps="true"/>
    </LinearLayout>
    <View
        android:background="@color/grayE5"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
