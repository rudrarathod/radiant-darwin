<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_resource"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:background="@color/white"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?android:attr/selectableItemBackground">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_width="96dp"
                android:layout_height="72dp"
                android:layout_margin="24dp"
                app:cardCornerRadius="2dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/iv_video_thumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/ic_youtube_video"/>
                    <ImageView
                        android:id="@+id/iv_play"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        app:srcCompat="@drawable/ic_play_button_gray"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:id="@+id/tv_video_duration"
                        android:background="#66000000"
                        android:paddingLeft="3dp"
                        android:paddingRight="3dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:id="@+id/tv_video_live"
                        android:background="@color/absent_red"
                        android:paddingLeft="3dp"
                        android:paddingRight="3dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/live"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentBottom="true"
                        android:textAllCaps="true"
                        android:layout_alignParentEnd="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/tv_inactive"
                        android:background="#66000000"
                        android:paddingLeft="3dp"
                        android:paddingRight="3dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/inactive"
                        android:layout_alignParentTop="true"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:paddingRight="10dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:id="@+id/tv_video_title"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:maxLines="2"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_video_options"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">
                        <ImageView
                            android:id="@+id/iv_video_options"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:tint="@color/gray7A7A7A"
                            app:srcCompat="@drawable/ic_dots"/>
                        <ImageView
                            android:id="@+id/ivShare"
                            android:padding="8dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@drawable/ic_share_gray"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/colorSecondaryText"
                    android:ellipsize="end"
                    android:id="@+id/tv_video_by"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="1"/>
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_video_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:id="@+id/iv_tag"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:srcCompat="@drawable/ic_tag"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorSecondaryText"
                        android:ellipsize="end"
                        android:id="@+id/tv_tags"
                        android:padding="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="2"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <View
        android:background="@color/gray91"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <include
        android:visibility="gone"
        layout="@layout/common_footer_layout_gray91"/>
</LinearLayout>
