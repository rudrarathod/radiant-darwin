<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:tag="layout/item_raised_hand_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_5sdp"
    android:layout_marginBottom="@dimen/_5sdp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/llRaiseHandBG"
        android:background="@drawable/round_chat_corner_raise_hand"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_22sdp"
        android:minWidth="@dimen/_130sdp">
        <TextView
            android:textColor="@color/colorSecondaryText"
            android:ellipsize="end"
            android:id="@+id/tvParticipantName"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/_81sdp"
            android:maxLines="1"
            android:layout_marginStart="@dimen/_2sdp"
            style="@style/nunito_sans_regular_12_chat_bold"/>
        <TextView
            android:textColor="@color/colorSecondaryText"
            android:gravity="center"
            android:id="@+id/tvMessage"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_2sdp"
            style="@style/nunito_sans_regular_12_chat_bold"/>
    </LinearLayout>
    <ImageView
        android:gravity="end"
        android:id="@+id/ivInfo"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:contentDescription="@string/app_name"
        app:srcCompat="@drawable/ic_info_n"/>
</LinearLayout>
