<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_view_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginStart="15dp">
            <RelativeLayout
                android:layout_width="314dp"
                android:layout_height="128dp">
                <View
                    android:background="@color/grayE5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ayp_8dp"
                    android:layout_marginBottom="@dimen/ayp_8dp"
                    android:layout_marginStart="@dimen/ayp_8dp"
                    android:layout_marginEnd="@dimen/ayp_8dp">
                    <View
                        android:background="@color/gray74"
                        android:layout_width="150dp"
                        android:layout_height="20dp"/>
                    <View
                        android:background="@color/gray74"
                        android:layout_width="150dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="@dimen/ayp_8dp"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <View
                    android:background="@color/gray74"
                    android:layout_width="100dp"
                    android:layout_height="20dp"
                    android:layout_margin="@dimen/ayp_8dp"
                    android:layout_alignParentBottom="true"/>
                <View
                    android:background="@color/gray74"
                    android:layout_width="100dp"
                    android:layout_height="20dp"
                    android:layout_margin="@dimen/ayp_8dp"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="314dp"
                android:layout_height="128dp"
                android:layout_marginLeft="@dimen/ayp_8dp"
                android:layout_marginStart="@dimen/ayp_8dp">
                <View
                    android:background="@color/grayE5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/ayp_8dp">
                    <View
                        android:background="@color/gray74"
                        android:layout_width="150dp"
                        android:layout_height="20dp"/>
                    <View
                        android:background="@color/gray74"
                        android:layout_width="150dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="@dimen/ayp_8dp"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <View
                    android:background="@color/gray74"
                    android:layout_width="100dp"
                    android:layout_height="20dp"
                    android:layout_margin="@dimen/ayp_8dp"
                    android:layout_alignParentBottom="true"/>
                <View
                    android:background="@color/gray74"
                    android:layout_width="100dp"
                    android:layout_height="20dp"
                    android:layout_margin="@dimen/ayp_8dp"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/dynamic_card_heading"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:paddingLeft="@dimen/ayp_16dp"
            android:paddingRight="@dimen/ayp_16dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</LinearLayout>
