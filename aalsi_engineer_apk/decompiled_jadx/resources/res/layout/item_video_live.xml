<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/rl_left"
            android:layout_width="70dp"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="4dp"
                app:cardElevation="0dp">
                <RelativeLayout
                    android:id="@+id/rl_thumbnail"
                    android:layout_width="70dp"
                    android:layout_height="50dp">
                    <ImageView
                        android:id="@+id/iv_thumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:foregroundGravity="center"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/color_white"
                        android:id="@+id/tv_duration"
                        android:background="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:layout_alignParentBottom="true"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:layout_marginEnd="15dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <ImageView
                android:id="@+id/iv_play"
                android:background="@drawable/bg_round_grey_stroke_white"
                android:visibility="visible"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:tint="@color/white"
                android:layout_centerInParent="true"
                app:srcCompat="@drawable/ic_play_arrow"/>
            <ImageView
                android:id="@+id/ivLockLayer"
                android:background="@drawable/bg_locked_layer"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:adjustViewBounds="true"
                android:foregroundGravity="center"
                app:srcCompat="@drawable/ic_lock_new_enabled"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/rl_left">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/color_DE000000"
                        android:ellipsize="end"
                        android:id="@+id/tv_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:layout_gravity="center"
                        android:id="@+id/llLabel"
                        android:background="@drawable/shape_rectangle_filled_white_radius_2"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:id="@+id/tv_label"
                            android:padding="2dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/item_video_live_tv_label_text"
                            android:textAlignment="center"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/iv_delete"
                        android:visibility="gone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:srcCompat="@drawable/ic_trash"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_details1"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/iv_details1"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:srcCompat="@drawable/ic_remove_red_eye_secondary"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/color_99000000"
                        android:ellipsize="end"
                        android:id="@+id/tv_details1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_marginStart="6dp"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/iv_dot"
                        android:visibility="gone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:srcCompat="@drawable/default_dot"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/color_99000000"
                        android:ellipsize="end"
                        android:id="@+id/tv_sub_details1"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_details2"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/iv_details2"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:srcCompat="@drawable/ic_remove_red_eye_secondary"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/color_99000000"
                        android:ellipsize="end"
                        android:id="@+id/tv_details2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_downloading"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ProgressBar
                    android:id="@+id/pb_downloading"
                    android:visibility="gone"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:indeterminate="true"
                    android:layout_marginStart="5dp"/>
                <ImageView
                    android:id="@+id/iv_download"
                    android:visibility="gone"
                    android:layout_width="25dp"
                    android:layout_height="30dp"
                    android:tint="@color/colorPrimary"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:background="#efefef"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
