<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/ayp_4dp"
    android:layout_marginBottom="@dimen/ayp_4dp"
    app:cardCornerRadius="2dp"
    app:cardElevation="2dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/ayp_16dp"
        android:layout_marginEnd="4dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textColor="#de000000"
                android:ellipsize="end"
                android:id="@+id/tvHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:maxEms="8"
                android:scrollHorizontally="true"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_8740FF"
                android:id="@+id/tv_one_time_class"
                android:background="@drawable/shape_one_time_class"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/one_time_class"
                android:textAllCaps="true"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_timimgs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ayp_8dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="fitXY"
                android:tint="@color/color_777777"
                app:srcCompat="@drawable/ic_clock_time"/>
            <TextView
                android:textSize="16sp"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/tv_timings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="9dp"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                style="@style/BaseTextAppearance.ShadowTitle"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#666666"
                android:id="@+id/tv_present"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginEnd="@dimen/_8sdp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_tutor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_tutor_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#de000000"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/tv_tutor_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="9dp"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="9dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/ll_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/link"
                    android:gravity="start"
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="9dp"/>
                <ImageView
                    android:id="@+id/iv_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tint="@color/link"
                    app:srcCompat="@drawable/ic_chevron_right"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
