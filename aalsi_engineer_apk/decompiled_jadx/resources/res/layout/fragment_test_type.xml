<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/gray91"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_btn_done"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/b_done"
            android:background="@drawable/bg_button_click_color_primary"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/label_next"
            android:textAllCaps="false"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/ll_btn_done"
        android:layout_alignParentTop="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llPracticeTestNew"
                android:background="#ffebcf"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_16dp"
                android:layout_marginStart="@dimen/ayp_16dp"
                android:layout_marginEnd="@dimen/ayp_16dp"
                android:elevation="2dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="@dimen/ayp_12dp"
                    app:srcCompat="@drawable/ic_new_lable"/>
                <TextView
                    android:textSize="@dimen/ts_14sp"
                    android:textColor="@color/black"
                    android:id="@+id/tvPracticeTestNew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/ayp_12dp"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#99000000"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/select_test_type"
                android:textAllCaps="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/ayp_16dp"
                android:paddingEnd="@dimen/ayp_16dp">
                <RadioButton
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/onlineTest"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_online_test"
                    android:layoutDirection="rtl"/>
                <FrameLayout
                    android:id="@+id/frameLayout"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RadioButton
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:id="@+id/practiceTest"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/practice_test"
                        android:layoutDirection="rtl"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/newTagPracticeTest"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="115dp"
                        app:srcCompat="@drawable/ic_new_lable"/>
                </FrameLayout>
                <RadioButton
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/classTest"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/class_test"
                    android:layoutDirection="rtl"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/assign_to"
                android:textAllCaps="true"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_assign_to"
                android:background="@color/white"
                android:paddingLeft="20dp"
                android:paddingTop="5dp"
                android:paddingRight="20dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/to"
                    android:textAllCaps="true"/>
                <LinearLayout
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/royalblue"
                    android:orientation="horizontal"
                    android:id="@+id/ll_assign_to_students"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/layout_enter_details_et_name_hint"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:inputType="textCapSentences"
                    android:imeOptions="actionDone"
                    android:backgroundTint="@android:color/transparent">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:id="@+id/tv_student_test_1"
                        android:background="@drawable/bg_button_click_color_primary"
                        android:padding="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/all_students"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorPrimary"
                        android:layout_gravity="center"
                        android:id="@+id/tv_student_test_count"
                        android:padding="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/iv_students_test"
                    android:padding="10dp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:tint="@color/colorPrimary"
                    app:srcCompat="@drawable/ic_add_circle_outline"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorSecondaryText"
                android:id="@+id/tv_test_name_label"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/fragment_test_type_tv_test_name_label_text"
                android:textAllCaps="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_name"
                android:background="@color/white"
                android:paddingLeft="20dp"
                android:paddingTop="5dp"
                android:paddingRight="20dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">
                <EditText
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/royalblue"
                    android:gravity="start|center_vertical"
                    android:id="@+id/et_name"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/layout_enter_details_et_name_hint"
                    android:maxLines="1"
                    android:inputType="textCapSentences"
                    android:imeOptions="actionDone"
                    android:backgroundTint="@android:color/transparent"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include
        android:id="@+id/common_progressbar_layout"
        android:visibility="gone"
        layout="@layout/common_progressbar"/>
</RelativeLayout>
