<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/grayF1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/ll_btn_done">
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/sv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#e86565"
                        android:gravity="center_horizontal"
                        android:id="@+id/tv_archive_label"
                        android:background="@color/red_FFEDF0"
                        android:padding="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/fragment_overview_tv_archive_label_text"/>
                    <RelativeLayout
                        android:background="@color/white"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textStyle="bold"
                            android:id="@+id/tv_batch_name"
                            android:paddingTop="15dp"
                            android:paddingBottom="15dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true"
                            style="@style/BaseTextAppearance.HeavyWeightTitle"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/tv_batch_name">
                            <View
                                android:background="@color/gray89"
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <RelativeLayout
                                    android:gravity="start|top"
                                    android:layout_gravity="start|top"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.6">
                                    <ImageView
                                        android:id="@+id/id_iv_clock"
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        app:srcCompat="@drawable/ic_start_date_new"/>
                                    <TextView
                                        android:id="@+id/id_tv_timings"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:layout_marginLeft="10dp"
                                        android:text="@string/batch_start_date"
                                        android:layout_toRightOf="@+id/id_iv_clock"
                                        android:layout_alignTop="@+id/id_iv_clock"
                                        android:layout_alignBottom="@+id/id_iv_clock"
                                        android:layout_marginStart="10dp"
                                        android:layout_toEndOf="@+id/id_iv_clock"
                                        style="@style/BaseTextAppearance.MediumWeightTitle"/>
                                    <TextView
                                        android:textColor="#de000000"
                                        android:id="@+id/tv_timings"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="5dp"
                                        android:layout_below="@+id/id_tv_timings"
                                        android:layout_alignLeft="@+id/id_tv_timings"
                                        android:layout_alignStart="@+id/id_tv_timings"
                                        style="@style/BaseTextAppearance.SubTitle"/>
                                </RelativeLayout>
                                <RelativeLayout
                                    android:gravity="start|top"
                                    android:layout_gravity="start|top"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.4">
                                    <ImageView
                                        android:id="@+id/id_iv_batch_code"
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:tint="@color/colorSecondaryText"
                                        app:srcCompat="@drawable/ic_hash"/>
                                    <TextView
                                        android:id="@+id/id_tv_batch_code"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:layout_marginLeft="10dp"
                                        android:text="@string/fragment_overview_id_tv_batch_code_text"
                                        android:layout_toRightOf="@+id/id_iv_batch_code"
                                        android:layout_alignTop="@+id/id_iv_batch_code"
                                        android:layout_alignBottom="@+id/id_iv_batch_code"
                                        android:layout_marginStart="10dp"
                                        android:layout_toEndOf="@+id/id_iv_batch_code"
                                        style="@style/BaseTextAppearance.MediumWeightTitle"/>
                                    <LinearLayout
                                        android:orientation="horizontal"
                                        android:id="@+id/ll_batch_code_whatsapp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@+id/id_tv_batch_code"
                                        android:layout_alignLeft="@+id/id_tv_batch_code"
                                        android:layout_alignStart="@+id/id_tv_batch_code">
                                        <TextView
                                            android:textColor="#de000000"
                                            android:id="@+id/tv_batch_code"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="5dp"
                                            android:maxLines="2"
                                            android:singleLine="false"
                                            android:layout_weight="1"
                                            style="@style/BaseTextAppearance.SubTitle"/>
                                        <ImageView
                                            android:id="@+id/iv_share_whatsapp"
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_marginTop="4dp"
                                            android:layout_marginStart="8dp"
                                            app:srcCompat="@drawable/ic_whatsapp_share"/>
                                    </LinearLayout>
                                </RelativeLayout>
                            </LinearLayout>
                            <View
                                android:background="@color/gray89"
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/ll_attendance"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <RelativeLayout
                                    android:gravity="start|top"
                                    android:layout_gravity="start|top"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.7">
                                    <ImageView
                                        android:id="@+id/id_iv_attendance"
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:tint="@color/colorSecondaryText"
                                        app:srcCompat="@drawable/ic_check_square"/>
                                    <TextView
                                        android:textSize="14sp"
                                        android:textColor="@color/colorSecondaryText"
                                        android:id="@+id/id_tv_attendance"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:layout_marginLeft="10dp"
                                        android:text="@string/fragment_overview_id_tv_attendance_text"
                                        android:layout_toRightOf="@+id/id_iv_attendance"
                                        android:layout_alignTop="@+id/id_iv_attendance"
                                        android:layout_alignBottom="@+id/id_iv_attendance"
                                        android:layout_marginStart="10dp"
                                        android:layout_toEndOf="@+id/id_iv_attendance"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:textColor="@color/black"
                                        android:id="@+id/tv_attendance"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="5dp"
                                        android:layout_below="@+id/id_tv_attendance"
                                        android:layout_alignLeft="@+id/id_tv_attendance"
                                        android:layout_alignStart="@+id/id_tv_attendance"/>
                                </RelativeLayout>
                                <RelativeLayout
                                    android:gravity="center_vertical"
                                    android:layout_gravity="center_vertical"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.3">
                                    <TextView
                                        android:textSize="14sp"
                                        android:textColor="@color/royalblue"
                                        android:id="@+id/tv_mark_review_attendance"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="28dp"
                                        android:text="@string/mark"
                                        android:layout_marginStart="28dp"/>
                                </RelativeLayout>
                            </LinearLayout>
                            <View
                                android:background="@color/gray89"
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/ll_course"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <ImageView
                                        android:id="@+id/id_iv_class"
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        app:srcCompat="@drawable/ic_book_outline"/>
                                    <TextView
                                        android:id="@+id/id_tv_class"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:layout_marginLeft="10dp"
                                        android:text="@string/course"
                                        android:layout_toRightOf="@+id/id_iv_class"
                                        android:layout_alignTop="@+id/id_iv_class"
                                        android:layout_alignBottom="@+id/id_iv_class"
                                        android:layout_marginStart="10dp"
                                        android:layout_toEndOf="@+id/id_iv_class"
                                        style="@style/BaseTextAppearance.MediumWeightTitle"/>
                                    <TextView
                                        android:textColor="#de000000"
                                        android:id="@+id/tv_class"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="5dp"
                                        android:layout_below="@+id/id_tv_class"
                                        android:layout_alignLeft="@+id/id_tv_class"
                                        android:layout_alignStart="@+id/id_tv_class"
                                        style="@style/BaseTextAppearance.SubTitle"/>
                                </RelativeLayout>
                            </LinearLayout>
                            <View
                                android:background="@color/gray89"
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/ll_subjects"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <ImageView
                                        android:id="@+id/id_iv_book"
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:maxWidth="18dp"
                                        android:maxHeight="18dp"
                                        android:layout_alignTop="@+id/id_tv_subject"
                                        android:layout_alignBottom="@+id/id_tv_subject"
                                        app:srcCompat="@drawable/ic_book_closed"/>
                                    <TextView
                                        android:id="@+id/id_tv_subject"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="10dp"
                                        android:text="@string/fragment_overview_id_tv_subject_text"
                                        android:layout_toRightOf="@+id/id_iv_book"
                                        android:layout_marginStart="10dp"
                                        android:layout_toEndOf="@+id/id_iv_book"
                                        style="@style/BaseTextAppearance.MediumWeightTitle"/>
                                    <TextView
                                        android:textColor="#de000000"
                                        android:id="@+id/tv_subject"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="5dp"
                                        android:layout_below="@+id/id_tv_subject"
                                        android:layout_alignLeft="@+id/id_tv_subject"
                                        android:layout_alignStart="@+id/id_tv_subject"
                                        style="@style/BaseTextAppearance.SubTitle"/>
                                </RelativeLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </RelativeLayout>
                    <View
                        android:background="@color/gray89"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"/>
                    <co.classplus.app.ui.custom.CommonTextWithIconButton
                        android:id="@+id/ctwib_edit_batch_details"
                        android:background="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        app:iv_icon="@drawable/ic_edit_pencil_new"
                        app:text="@string/edit_batch_details"/>
                    <TextView
                        android:id="@+id/tv_challenges"
                        android:paddingTop="16dp"
                        android:paddingBottom="11dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/challenges_caps"
                        android:textAllCaps="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        style="@style/BaseTextAppearance.SmallSubTitle"/>
                    <include
                        android:id="@+id/ll_challenges"
                        android:visibility="gone"
                        layout="@layout/layout_challenges_card"/>
                    <include
                        android:id="@+id/ll_live_stream"
                        layout="@layout/item_go_live"/>
                    <include
                        android:id="@+id/ll_zoom_live"
                        layout="@layout/item_go_live"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_batch_timings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:background="@color/grayF1"
                            android:paddingLeft="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="16dp">
                            <TextView
                                android:id="@+id/tv_batch_timings"
                                android:paddingTop="16dp"
                                android:paddingRight="16dp"
                                android:paddingBottom="11dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/batch_timings"
                                android:layout_weight="1"
                                android:textAllCaps="true"
                                android:paddingEnd="16dp"
                                style="@style/BaseTextAppearance.SmallSubTitle"/>
                            <LinearLayout
                                android:gravity="end|center_vertical"
                                android:orientation="horizontal"
                                android:id="@+id/ll_batch_timings_view_all"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/colorPrimary"
                                    android:gravity="center_vertical"
                                    android:id="@+id/tv_view_all"
                                    android:paddingRight="16dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/view_all"
                                    android:textAllCaps="true"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/ll_batches"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <androidx.recyclerview.widget.RecyclerView
                                android:orientation="horizontal"
                                android:id="@+id/rv_batches"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                        </LinearLayout>
                        <View
                            android:background="@color/gray89"
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"/>
                        <co.classplus.app.ui.custom.CommonTextWithIconButton
                            android:id="@+id/ctwib_add_batch_timings"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            app:iv_icon="@drawable/ic_edit_pencil_new"
                            app:text="@string/edit_batch_timings"/>
                        <TextView
                            android:textColor="@color/blue"
                            android:gravity="center_horizontal"
                            android:id="@+id/tv_view_all_batch"
                            android:background="@color/white"
                            android:padding="16dp"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/view_all"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_batch_no_timings"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:background="@color/grayF1"
                            android:paddingLeft="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="16dp">
                            <TextView
                                android:paddingTop="16dp"
                                android:paddingRight="16dp"
                                android:paddingBottom="11dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/batch_timings"
                                android:layout_weight="1"
                                android:textAllCaps="true"
                                android:paddingEnd="16dp"
                                style="@style/BaseTextAppearance.SmallSubTitle"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="14sp"
                                android:textColor="#99000000"
                                android:gravity="center"
                                android:id="@+id/tv_no_classes_added"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="24dp"
                                android:text="@string/no_classes_added"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="#99000000"
                                android:gravity="center"
                                android:id="@+id/tv_batch_timings_added"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="24dp"
                                android:text="@string/batch_timings_added"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_students"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:background="@color/grayF1"
                            android:paddingLeft="16dp"
                            android:paddingTop="16dp"
                            android:paddingRight="16dp"
                            android:paddingBottom="11dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/tv_total_students"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textAllCaps="true"
                                style="@style/BaseTextAppearance.SmallSubTitle"/>
                            <LinearLayout
                                android:gravity="end|center_vertical"
                                android:orientation="horizontal"
                                android:id="@+id/ll_join_requests"
                                android:visibility="gone"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <ImageView
                                    android:layout_gravity="center_vertical"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginRight="5dp"
                                    android:src="@drawable/shape_circle_color_primary"
                                    android:layout_marginEnd="5dp"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/colorPrimary"
                                    android:gravity="center_vertical"
                                    android:id="@+id/tv_join_requests"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/layout_students"
                            android:background="@color/white"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <RelativeLayout
                                android:gravity="start"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:id="@+id/iv_student_1"
                                    android:layout_width="35dp"
                                    android:layout_height="35dp"
                                    android:layout_alignParentLeft="true"
                                    android:layout_alignParentStart="true"
                                    app:srcCompat="@drawable/ic_logo"/>
                                <ImageView
                                    android:id="@+id/iv_student_2"
                                    android:layout_width="35dp"
                                    android:layout_height="35dp"
                                    android:layout_marginLeft="25dp"
                                    android:layout_alignParentLeft="true"
                                    android:layout_marginStart="25dp"
                                    android:layout_alignParentStart="true"
                                    app:srcCompat="@drawable/ic_logo"/>
                                <ImageView
                                    android:id="@+id/iv_student_3"
                                    android:layout_width="35dp"
                                    android:layout_height="35dp"
                                    android:layout_marginLeft="50dp"
                                    android:layout_alignParentLeft="true"
                                    android:layout_marginStart="50dp"
                                    android:layout_alignParentStart="true"
                                    app:srcCompat="@drawable/ic_logo"/>
                            </RelativeLayout>
                            <TextView
                                android:id="@+id/tv_students"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/ayp_16dp"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/ayp_16dp"
                                style="@style/BaseTextAppearance.Title"/>
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:tint="@color/black"
                                app:srcCompat="@drawable/ic_chevron_right"/>
                        </LinearLayout>
                        <View
                            android:background="@color/gray89"
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"/>
                        <co.classplus.app.ui.custom.CommonTextWithIconButton
                            android:id="@+id/tv_add_student"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            app:iv_icon="@drawable/ic_add_plus"
                            app:text="@string/add_students_no_caps"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_faculties"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:background="@color/grayF1"
                            android:paddingLeft="16dp"
                            android:paddingTop="16dp"
                            android:paddingRight="16dp"
                            android:paddingBottom="11dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/tv_faculty_count"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/faculties_and_size"
                                android:layout_weight="1"
                                android:textAllCaps="true"
                                style="@style/BaseTextAppearance.SmallSubTitle"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/ll_faculty_added"
                            android:background="@color/white"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="60dp">
                            <TextView
                                android:textColor="@color/tint_black"
                                android:gravity="center_horizontal"
                                android:padding="@dimen/_12sdp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/no_faculty_added"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/layout_faculties"
                            android:background="@color/white"
                            android:padding="@dimen/ayp_16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <RelativeLayout
                                android:gravity="start"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:id="@+id/iv_faculty_1"
                                    android:layout_width="35dp"
                                    android:layout_height="35dp"
                                    android:layout_alignParentLeft="true"
                                    android:layout_alignParentStart="true"
                                    app:srcCompat="@drawable/ic_logo"/>
                                <ImageView
                                    android:id="@+id/iv_faculty_2"
                                    android:layout_width="35dp"
                                    android:layout_height="35dp"
                                    android:layout_marginLeft="25dp"
                                    android:layout_alignParentLeft="true"
                                    android:layout_marginStart="25dp"
                                    android:layout_alignParentStart="true"
                                    app:srcCompat="@drawable/ic_logo"/>
                                <ImageView
                                    android:id="@+id/iv_faculty_3"
                                    android:layout_width="35dp"
                                    android:layout_height="35dp"
                                    android:layout_marginLeft="50dp"
                                    android:layout_alignParentLeft="true"
                                    android:layout_marginStart="50dp"
                                    android:layout_alignParentStart="true"
                                    app:srcCompat="@drawable/ic_logo"/>
                            </RelativeLayout>
                            <TextView
                                android:id="@+id/tv_faculties"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/ayp_16dp"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/ayp_16dp"
                                style="@style/BaseTextAppearance.Title"/>
                            <ImageView
                                android:id="@+id/iv_chevron_forward"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:tint="@color/black"
                                app:srcCompat="@drawable/ic_chevron_right"/>
                        </LinearLayout>
                        <View
                            android:background="@color/gray89"
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"/>
                        <co.classplus.app.ui.custom.CommonTextWithIconButton
                            android:id="@+id/tv_add_faculty"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            app:iv_icon="@drawable/ic_add_plus"
                            app:text="@string/add_faculty"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/colorSecondaryText"
                            android:id="@+id/tv_faculty_note"
                            android:padding="@dimen/_12sdp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/faculty_note"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_announcements"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/tv_recent_announcements"
                            android:paddingLeft="16dp"
                            android:paddingTop="16dp"
                            android:paddingRight="16dp"
                            android:paddingBottom="11dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/fragment_overview_tv_recent_announcements_text"
                            android:layout_weight="1"
                            android:textAllCaps="true"
                            style="@style/BaseTextAppearance.SmallSubTitle"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/ll_announcements_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <include
                                    android:id="@+id/layout_recent_announcement"
                                    layout="@layout/item_notice_history"/>
                            </RelativeLayout>
                            <View
                                android:background="@color/gray89"
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"/>
                            <TextView
                                android:textSize="16sp"
                                android:textColor="@color/royalblue"
                                android:gravity="center"
                                android:id="@+id/tv_view_announcements"
                                android:background="@color/white"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/view_all"/>
                        </LinearLayout>
                        <TextView
                            android:gravity="center"
                            android:id="@+id/tv_announcement_empty"
                            android:background="@color/white"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="65dp"
                            android:text="@string/no_announcements"
                            style="@style/BaseTextAppearance.SubTitle"/>
                    </LinearLayout>
                    <View
                        android:background="@color/grayF1"
                        android:layout_width="match_parent"
                        android:layout_height="25dp"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <include
            android:visibility="gone"
            layout="@layout/common_progressbar"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_btn_done"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:elevation="8dp">
        <Button
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/b_done"
            android:background="@drawable/bg_button_click_color_primary"
            android:padding="10dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/mark_attendance"
            android:textAllCaps="false"/>
    </LinearLayout>
</RelativeLayout>
