<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@color/white"
    android:layout_width="@dimen/_420sdp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/_8sdp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingLeft="@dimen/_14sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingRight="@dimen/_14sdp"
        android:paddingBottom="@dimen/_8sdp"
        android:layout_width="@dimen/_420sdp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingVertical="@dimen/_8sdp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llCoursePopupHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:id="@+id/tvDialogName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/buy_course_to_continue_watching"
                android:maxLines="1"
                android:layout_weight="1"
                style="@style/nunito_sans_bold_12"/>
            <TextView
                android:textColor="@color/colorPrimary"
                android:gravity="center_vertical"
                android:id="@+id/tvViewCourse"
                android:background="@drawable/shape_rectangle_filled_white_outline_primary_r5"
                android:paddingLeft="@dimen/_6sdp"
                android:paddingTop="@dimen/_3sdp"
                android:paddingRight="@dimen/_6sdp"
                android:paddingBottom="@dimen/_3sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_course"
                android:drawablePadding="@dimen/_6sdp"
                android:layout_marginStart="@dimen/_12sdp"
                android:paddingHorizontal="@dimen/_6sdp"
                android:paddingVertical="@dimen/_3sdp"
                app:drawableEndCompat="@drawable/icon_arrow_top_right"
                style="@style/nunito_sans_semi_bold_12_black"/>
            <ImageView
                android:id="@+id/ivDialogClose"
                android:background="?attr/selectableItemBackground"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:src="@drawable/ic_close_cross_black"
                android:contentDescription="@string/drawer_close"
                android:layout_marginStart="@dimen/_12sdp"
                app:tint="@color/color_7D8592"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clCourseDetail"
            android:background="@drawable/shape_rectangle_gray_outline_r8"
            android:padding="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llCoursePopupHeader">
            <ImageView
                android:id="@+id/ivCourseImage"
                android:background="@drawable/shape_rectangle_filled_white_outline_gray_r8"
                android:layout_width="@dimen/_180sdp"
                android:layout_height="@dimen/_100sdp"
                android:src="@drawable/course_placeholder"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTags"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_marginEnd="@dimen/_12sdp"
                app:layout_constraintEnd_toStartOf="@+id/tvCourseTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivCourseImage"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/color_3C4852"
                android:ellipsize="end"
                android:id="@+id/tvCourseTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/common_empty_sub_msg_test"
                android:maxLines="2"
                android:lineSpacingExtra="@dimen/_2sdp"
                android:layout_marginStart="@dimen/_12sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivCourseImage"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/nunito_sans_bold_16"/>
            <TextView
                android:textColor="@color/color_7D8592"
                android:ellipsize="end"
                android:id="@+id/tvCourseHighlight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/highlights_of_the_course"
                android:maxLines="1"
                android:lineSpacingExtra="@dimen/_2sdp"
                android:layout_marginStart="@dimen/_12sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivCourseImage"
                app:layout_constraintTop_toBottomOf="@+id/tvCourseTitle"
                style="@style/nunito_sans_primary_bold_14_grey"/>
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tvCourseDuration"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:maxLines="1"
                android:drawablePadding="@dimen/_6sdp"
                android:layout_marginStart="@dimen/_12sdp"
                app:drawableStartCompat="@drawable/ic_clock_live"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivCourseImage"
                app:layout_constraintTop_toBottomOf="@+id/tvCourseHighlight"
                style="@style/nunito_sans_regular_14_black"/>
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tvCourseMaterial"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:text="@string/view_free_study_material"
                android:maxLines="1"
                android:drawablePadding="@dimen/_6sdp"
                android:layout_marginStart="@dimen/_12sdp"
                app:drawableStartCompat="@drawable/ic_play_circle_live_18"
                app:drawableTint="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivCourseImage"
                app:layout_constraintTop_toBottomOf="@+id/tvCourseDuration"
                style="@style/nunito_sans_regular_14_black"/>
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tvCourseOffers"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:text="@string/available_offers"
                android:maxLines="1"
                android:drawablePadding="@dimen/_6sdp"
                android:layout_marginStart="@dimen/_12sdp"
                app:drawableStartCompat="@drawable/icon_coupon_offer_live_orange"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivCourseImage"
                app:layout_constraintTop_toBottomOf="@+id/tvCourseMaterial"
                style="@style/nunito_sans_regular_14_black"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llExcitingOffers"
            android:background="@drawable/shape_rectangle_filled_light_green_r5"
            android:padding="@dimen/_6sdp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clCourseDetail">
            <TextView
                android:textSize="@dimen/_11ssp"
                android:id="@+id/tvExcitingOffers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/exciting_coupons_available"
                android:drawablePadding="@dimen/_6sdp"
                android:layout_weight="1"
                app:drawableStartCompat="@drawable/icon_coupon_offer_live"
                style="@style/nunito_sans_semi_bold_14_black"/>
            <TextView
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/color_32A22A"
                android:gravity="center"
                android:id="@+id/tvCouponViewAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_all"
                android:drawablePadding="@dimen/_4sdp"
                app:drawableEndCompat="@drawable/ic_chevron_right_black"
                app:drawableTint="@color/color_32A22A"
                style="@style/nunito_sans_bold_14"/>
        </LinearLayout>
        <View
            android:id="@+id/viewSeparator"
            android:background="@color/separator_grey"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:layout_marginTop="@dimen/_12sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llExcitingOffers"/>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/llPriceInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnBuyNow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/viewSeparator">
            <TextView
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold"
                android:textColor="@color/color_3C4852"
                android:id="@+id/tv_disc_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginEnd="@dimen/_8sdp"/>
            <TextView
                android:textSize="@dimen/_12ssp"
                android:textColor="@color/color_7A8B94"
                android:gravity="bottom"
                android:id="@+id/tv_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginEnd="@dimen/_8sdp"/>
            <TextView
                android:textSize="@dimen/_11ssp"
                android:textColor="@color/colorGreen"
                android:gravity="bottom"
                android:id="@+id/tv_discount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <TextView
            android:gravity="center"
            android:id="@+id/btnBuyNow"
            android:background="@drawable/shape_rectangle_filled_primary_r8"
            android:paddingLeft="@dimen/_32sdp"
            android:paddingTop="@dimen/_6sdp"
            android:paddingRight="@dimen/_32sdp"
            android:paddingBottom="@dimen/_6sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="@string/buy_now"
            android:backgroundTint="@color/color_00ADE7"
            android:paddingHorizontal="@dimen/_32sdp"
            android:paddingVertical="@dimen/_6sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/viewSeparator"
            style="@style/nunito_sans_regular_14_white"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
