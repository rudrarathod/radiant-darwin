<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="@dimen/ayp_16dp"
    android:paddingTop="@dimen/ayp_16dp"
    android:paddingRight="@dimen/ayp_16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/llshare"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="@color/black"
            app:srcCompat="@drawable/ic_whatsapp_outline"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black_opaque"
            android:id="@+id/tv_share_whatsapp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_on_whatsapp"
            android:layout_marginStart="15dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_sharecoupon"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/ic_share_new"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black_opaque"
            android:id="@+id/tv_share_coupon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/coupon_share_button_text"
            android:layout_marginStart="15dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_edit_coupon"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="@color/black"
            app:srcCompat="@drawable/pencil_bottom_write"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black_opaque"
            android:id="@+id/tv_edit_coupon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/coupon_bottomsheet_listingscreen_tv_edit_coupon_text"
            android:layout_marginStart="15dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_make_inactive"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="@color/black"
            app:srcCompat="@drawable/make_inactive"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black_opaque"
            android:id="@+id/tv_make_inactive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/make_inactive"
            android:layout_marginStart="15dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_make_active"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="@color/black"
            app:srcCompat="@drawable/make_active"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black_opaque"
            android:id="@+id/tv_make_active"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/make_active"
            android:layout_marginStart="15dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_view_edit_history"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="@color/black"
            app:srcCompat="@drawable/edit_history"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black_opaque"
            android:id="@+id/tvEditHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/coupon_bottomsheet_listingscreen_tvEditHistory_text"
            android:layout_marginStart="15dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_delete"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="@color/black"
            app:srcCompat="@drawable/ic_delete"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black_opaque"
            android:id="@+id/tvDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            android:layout_marginStart="15dp"/>
    </LinearLayout>
    <View
        android:background="#e5e5e5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"/>
    <TextView
        android:textColor="@color/filter_done"
        android:gravity="center_horizontal"
        android:id="@+id/cancel"
        android:padding="@dimen/ayp_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/cancel_caps"/>
</LinearLayout>
