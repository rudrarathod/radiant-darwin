<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/shape_rectangle_filled_white_r7"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <View
        android:background="@color/divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <RelativeLayout
        android:id="@+id/rl_day_timing"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/iv_cancel_class">
            <RelativeLayout
                android:gravity="start|center_vertical"
                android:id="@+id/rl_day_from"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="10dp">
                <TextView
                    android:id="@+id/tv_day_from"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:text="@string/item_day_timing_tv_day_from_text"
                    android:layout_alignParentTop="true"
                    style="@style/BaseTextAppearance.UpperCaseTitle"/>
                <TextView
                    android:id="@+id/tv_day_from_time"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:text="@string/item_day_timing_tv_day_from_time_text"
                    android:layout_below="@+id/tv_day_from"
                    style="@style/BaseTextAppearance.ShadowTitle"/>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="start|center_vertical"
                android:id="@+id/rl_day_to"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingRight="10dp"
                android:paddingBottom="16dp"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/divider_day"
                android:paddingStart="16dp"
                android:paddingEnd="10dp">
                <TextView
                    android:id="@+id/tv_day_to"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:text="@string/item_day_timing_tv_day_to_text"
                    android:layout_alignParentTop="true"
                    style="@style/BaseTextAppearance.UpperCaseTitle"/>
                <TextView
                    android:id="@+id/tv_day_to_time"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:text="@string/item_day_timing_tv_day_to_time_text"
                    android:layout_below="@+id/tv_day_to"
                    style="@style/BaseTextAppearance.ShadowTitle"/>
            </RelativeLayout>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_cancel_class"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:paddingStart="10dp"
            android:paddingEnd="0dp"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_cross_cp"/>
    </RelativeLayout>
</LinearLayout>
