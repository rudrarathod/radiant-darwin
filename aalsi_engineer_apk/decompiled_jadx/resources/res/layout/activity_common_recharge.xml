<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@drawable/bg_primary_color_gradient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_choice_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_12sdp"
            android:baselineAligned="false"
            app:layout_constraintBottom_toTopOf="@+id/parent_scroll_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/ll_primary_choice"
                android:background="@drawable/shape_rectangle_filled_white_outline_gray_r8"
                android:padding="@dimen/_15sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/_6sdp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorPrimary"
                    android:ellipsize="end"
                    android:id="@+id/tvPrimaryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:text="@string/sms"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/color_7D8592"
                    android:ellipsize="end"
                    android:id="@+id/tvPrimaryLeftText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:maxLines="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/ll_secondary_choice"
                android:background="@drawable/shape_rectangle_filled_white_outline_gray_r8"
                android:padding="@dimen/_15sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/_6sdp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorPrimary"
                    android:ellipsize="end"
                    android:id="@+id/tvSecondaryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:text="@string/text_email"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/color_7D8592"
                    android:ellipsize="end"
                    android:id="@+id/tvSecondaryLeftText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:maxLines="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/ll_last_choice"
                android:background="@drawable/shape_rectangle_filled_white_outline_gray_r8"
                android:padding="@dimen/_15sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorPrimary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tvLastText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:text="@string/live_hours"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/color_7D8592"
                    android:ellipsize="end"
                    android:id="@+id/tvLastLeftText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/parent_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginRight="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_16sdp"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginVertical="@dimen/_16sdp"
            app:layout_constraintBottom_toTopOf="@+id/button_pay"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_choice_selection">
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/ll_choice_selection">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColorHint="@color/colorSecondaryText"
                        android:id="@+id/tv_sms_units"
                        android:padding="5dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="16sp"
                        android:id="@+id/tv_clear"
                        android:padding="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/clear_non_caps"/>
                </LinearLayout>
                <View
                    android:background="@color/gray91"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginTop="@dimen/_4sdp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorPrimaryText"
                        android:gravity="center"
                        android:id="@+id/tv_min_sms"
                        android:background="@drawable/shape_rectangle_filled_white_outline_primary_r5"
                        android:padding="5dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="0.2"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorPrimaryText"
                        android:gravity="center"
                        android:id="@+id/tv_min_sms_2x"
                        android:background="@drawable/shape_rectangle_filled_white_outline_primary_r5"
                        android:padding="5dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="0.2"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorPrimaryText"
                        android:gravity="center"
                        android:id="@+id/tv_min_sms_5x"
                        android:background="@drawable/shape_rectangle_filled_white_outline_primary_r5"
                        android:padding="5dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:id="@+id/tv_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorPrimaryText"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_sms_days_left"
                    android:background="@drawable/shape_rectangle_filled_light_blue_r5_borderless"
                    android:padding="@dimen/_10sdp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_marginBottom="@dimen/_20sdp"
                    android:text="@string/sms_recharge_estimated_days"
                    android:layout_marginVertical="@dimen/_20sdp"/>
                <ImageView
                    android:background="@drawable/bg_dotted_line"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_8sdp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="@string/payment_details"
                    android:textAllCaps="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorPrimaryText"
                        android:gravity="start|center_vertical"
                        android:id="@+id/totalText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/total_sms"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorPrimaryText"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_total_sms"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorPrimaryText"
                        android:gravity="start|center_vertical"
                        android:id="@+id/subtotalText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_sms_recharge_subtotalText_text"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorPrimaryText"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_subtotal_sms"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/llCoinDiscount"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorPrimaryText"
                        android:gravity="start|center_vertical"
                        android:id="@+id/coinText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/coin_discount"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorPrimaryText"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_coin_sms"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/llGst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_8sdp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/colorPrimaryText"
                        android:gravity="start|center_vertical"
                        android:id="@+id/gstText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:text="@string/gst_percent"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/colorPrimaryText"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_gst_sms"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:layout_weight="1"/>
                </LinearLayout>
                <ImageView
                    android:background="@drawable/bg_dotted_line"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_8sdp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimaryText"
                        android:gravity="start|center_vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/amount_payable"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimaryText"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_price"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <Button
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/button_pay"
            android:background="@drawable/bg_button_click_color_primary"
            android:padding="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_20sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:textAllCaps="false"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:layout_marginVertical="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/llProgress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/payment_progress_layout"/>
</LinearLayout>
