<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ayp_8dp"
        android:layout_marginBottom="8dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:elevation="0dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_stats_card_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ayp_16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="@dimen/ayp_16dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#de000000"
                    android:id="@+id/tv_stats"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:lines="2"
                    android:layout_weight="1"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="16dp"/>
            </LinearLayout>
            <TextView
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#de000000"
                android:id="@+id/tv_no_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="@dimen/ayp_16dp"
                android:layout_below="@+id/tv_stats"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="@dimen/ayp_16dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginLeft="@dimen/ayp_16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/imview1"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginRight="4dp"
                    android:adjustViewBounds="true"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/present_green"
                    android:id="@+id/tv_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:textSize="12sp"
                    android:ellipsize="end"
                    android:id="@+id/tv_tag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
