<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/grayF1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:id="@+id/app_bar_store_faculties"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_store_faculties"
            android:background="@drawable/bg_primary_color_gradient"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"/>
    </com.google.android.material.appbar.AppBarLayout>
    <include
        android:id="@+id/common_search_view"
        layout="@layout/common_search"/>
    <View
        android:background="@color/grayE5"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/ayp_12sp"
                    android:textColor="@color/black"
                    android:layout_gravity="center"
                    android:id="@+id/tv_faculties_course"
                    android:padding="@dimen/ayp_16dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAllCaps="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/colorPrimary"
                    android:gravity="end|center_vertical"
                    android:id="@+id/tv_view_faculty_permission"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/ayp_16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="true"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_store_faculties"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <co.classplus.app.ui.custom.CommonTextWithIconButton
                    android:id="@+id/tv_add_faculty"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/ayp_16dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:iv_icon="@drawable/ic_add_plus"
                    app:text="@string/add_faculty"
                    app:textColor="@color/colorPrimary"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
