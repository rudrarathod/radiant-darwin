<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/coupons_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@drawable/bg_primary_color_gradient"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:background="@color/coupons_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="10dp"
        android:layout_above="@+id/button_container"
        android:layout_below="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/ayp_12sp"
                android:textColor="@color/colorText_Black_Alpha_99"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_16dp"
                android:layout_marginBottom="@dimen/ayp_8dp"
                android:text="@string/offer_name"
                android:maxLines="1"
                android:layout_marginStart="@dimen/ayp_16dp"/>
            <EditText
                android:textSize="16sp"
                android:layout_gravity="center"
                android:id="@+id/couponName"
                android:background="@color/white"
                android:padding="@dimen/ayp_16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/coupon_creation_couponName_hint"
                android:maxLines="1"
                android:maxLength="20"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ff4058"
                android:id="@+id/couponNameError"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/field_required"
                android:layout_marginStart="@dimen/ayp_16dp"/>
            <TextView
                android:textSize="@dimen/ayp_12sp"
                android:textColor="@color/colorText_Black_Alpha_99"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_16dp"
                android:layout_marginBottom="@dimen/ayp_8dp"
                android:text="@string/coupon_code"
                android:layout_marginStart="@dimen/ayp_16dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:textSize="16sp"
                    android:layout_gravity="center"
                    android:id="@+id/couponCode"
                    android:background="@null"
                    android:padding="@dimen/ayp_16dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_coupon_code"
                    android:maxLines="1"
                    android:maxLength="16"
                    android:digits="0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
                    android:layout_weight="1"
                    android:inputType="textFilter"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/greenTick"
                    android:visibility="gone"
                    android:layout_width="@dimen/ayp_16dp"
                    android:layout_height="@dimen/ayp_16dp"
                    android:layout_marginEnd="@dimen/ayp_16dp"
                    app:srcCompat="@drawable/coupon_check"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/ayp_12sp"
                android:textColor="#ff4058"
                android:id="@+id/couponCodeError"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_4dp"
                android:text="@string/field_required"
                android:layout_marginStart="@dimen/ayp_16dp"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_16dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/colorText_Black_Alpha_99"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coupon_type"
                    android:layout_marginStart="@dimen/ayp_16dp"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivCouponType"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:focusable="true"
                    android:visibility="visible"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/information_circular_button_symbol__1_"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/white"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioGroup
                    android:layout_gravity="left"
                    android:id="@+id/couponType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="rtl">
                    <RadioButton
                        android:layout_gravity="start"
                        android:id="@+id/publicCoupon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/ayp_16dp"
                        android:checked="true"
                        android:text="@string/public_coupon"/>
                    <RadioButton
                        android:layout_gravity="start"
                        android:id="@+id/privateCoupon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/private_coupon"/>
                </RadioGroup>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="@dimen/ayp_8dp"
                android:layout_marginStart="@dimen/ayp_16dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorText_Black_Alpha_99"
                        android:layout_gravity="bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/course_selection_type"
                        android:textAllCaps="true"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/ivCourseSelectionInfo"
                        android:paddingLeft="5dp"
                        android:paddingRight="5dp"
                        android:focusable="true"
                        android:visibility="visible"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/ayp_16dp"
                        app:srcCompat="@drawable/information_circular_button_symbol__1_"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/white"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioGroup
                    android:layout_gravity="left"
                    android:id="@+id/RGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="rtl">
                    <RadioButton
                        android:layout_gravity="start"
                        android:id="@+id/assignAll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/ayp_16dp"
                        android:checked="true"
                        android:text="@string/assign_to_all_courses"/>
                    <RadioButton
                        android:layout_gravity="start"
                        android:id="@+id/assignSpecific"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:checked="false"
                        android:text="@string/assign_to_specific_courses"/>
                </RadioGroup>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/ayp_12sp"
                android:textColor="@color/colorText_Black_Alpha_99"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_16dp"
                android:layout_marginBottom="@dimen/ayp_8dp"
                android:text="@string/number_of_times_code_can_be_used"
                android:layout_marginStart="@dimen/ayp_16dp"/>
            <EditText
                android:textSize="16sp"
                android:layout_gravity="center"
                android:id="@+id/editCodeMaximum"
                android:background="@color/white"
                android:padding="@dimen/ayp_16dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/coupon_creation_editCodeMaximum_text"
                android:maxLength="9"
                android:inputType="number"/>
            <TextView
                android:textSize="@dimen/ayp_12sp"
                android:textColor="#ff4058"
                android:id="@+id/editCodeMaximumError"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_2dp"
                android:text="@string/field_required"
                android:layout_marginStart="@dimen/ayp_16dp"/>
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp">
                <CheckBox
                    android:id="@+id/chk_coupon_unlimited"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:checked="false"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_chk_coupon_unlimited"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/check_if_you_want_to_set_number_of_times_to_unlimited"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@+id/chk_coupon_unlimited"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/ayp_12sp"
                android:textColor="@color/colorText_Black_Alpha_99"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_16dp"
                android:layout_marginBottom="@dimen/ayp_8dp"
                android:text="@string/usage_per_student"
                android:layout_marginStart="@dimen/ayp_16dp"/>
            <EditText
                android:textSize="16sp"
                android:layout_gravity="center"
                android:id="@+id/editStudentMaximum"
                android:background="@color/white"
                android:padding="@dimen/ayp_16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1"
                android:maxLength="9"
                android:inputType="number"/>
            <TextView
                android:textSize="@dimen/ayp_12sp"
                android:textColor="#ff4058"
                android:id="@+id/editStudentMaximumError"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_4dp"
                android:text="@string/field_required"
                android:layout_marginStart="@dimen/ayp_16dp"/>
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/rl_usage_per_student_checkbox"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp">
                <CheckBox
                    android:id="@+id/chk_per_student"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:checked="false"
                    android:layout_marginStart="10dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_chk_per_student"
                    android:paddingTop="@dimen/ayp_4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/userUnlimitedCheck"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@+id/chk_per_student"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="@dimen/ayp_16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_16dp"
                android:layout_marginBottom="100dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black_opaque"
                        android:layout_gravity="center"
                        android:background="@color/white"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/visibility"
                        android:layout_weight="1"/>
                    <Switch
                        android:id="@+id/toggle"
                        android:layout_width="48dp"
                        android:layout_height="22dp"
                        android:checked="true"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorText_Black_Alpha_99"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ayp_8dp"
                    android:text="@string/toggleOffText"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <androidx.cardview.widget.CardView
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardElevation="10dp">
        <Button
            android:textSize="18sp"
            android:textColor="@color/white"
            android:id="@+id/button"
            android:background="@drawable/bg_button_click_color_primary"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/label_next"
            android:textAllCaps="false"/>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
