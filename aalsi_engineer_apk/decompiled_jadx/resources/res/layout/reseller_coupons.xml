<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/bottom_overview_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:behavior_hideable="true"
    app:behavior_peekHeight="0dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <LinearLayout
        android:orientation="vertical"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/llButtonContainer">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_sheet_top"
            android:padding="@dimen/aya_24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_promo_code"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/reseller_coupons_tv_promo_code_text"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/button"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:tint="@color/black"
                app:srcCompat="@drawable/ic_cross_cp"/>
        </LinearLayout>
        <View
            android:id="@+id/v_sheet_divider"
            android:background="@color/gray79"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_below="@+id/ll_sheet_top"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/coupon_reseller_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/ayp_16dp">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/ayp_16dp"
                android:layout_height="@dimen/ayp_16dp"
                android:layout_marginLeft="@dimen/ayp_16dp"
                android:layout_marginTop="@dimen/ayp_16dp"
                android:layout_marginRight="@dimen/ayp_8dp"
                android:layout_marginBottom="@dimen/ayp_16dp"
                app:srcCompat="@drawable/arrow_up_coupon"/>
            <TextView
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/twelve_percent"/>
            <View
                android:background="#9952b062"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/ayp_16dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#99000000"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ayp_16dp"
                android:layout_marginRight="@dimen/ayp_16dp"
                android:layout_marginBottom="@dimen/ayp_16dp"
                android:text="@string/creator_has_applied_coupons_on_this_course_and_increased_the_sale"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ayp_16dp"
            android:text="@string/coupons_3"
            android:textAllCaps="true"/>
        <View
            android:background="#e7e7e7"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/ayp_8dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_reseller_availableCoupons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/v_sheet_divider"/>
        <TextView
            android:padding="@dimen/ayp_16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/effective_price_after_assigning_coupon_discount_cannot_be_less_than_the_the_owner_share"/>
        <View
            android:id="@+id/tv2"
            android:background="@color/gray79"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_below="@+id/recycler_availableCoupons"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llButtonContainer"
        android:background="@color/white"
        android:padding="@dimen/ayp_12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:layout_gravity="center"
            android:id="@+id/createCoupon"
            android:background="@drawable/bg_primary_color_gradient"
            android:padding="@dimen/ayp_16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reseller_coupons_createCoupon_text"
            android:textAllCaps="false"/>
    </LinearLayout>
</RelativeLayout>
