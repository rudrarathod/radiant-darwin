<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <RelativeLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:layout_width="70dp"
            android:layout_height="50dp">
            <ImageView
                android:id="@+id/ivItemIcon"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/iv_locked"
                android:background="@drawable/bg_round_grey_stroke_white"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:tint="@color/white"
                android:layout_centerInParent="true"
                app:srcCompat="@drawable/ic_lock"/>
        </RelativeLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:layout_marginStart="8dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorPrimaryText"
                android:ellipsize="end"
                android:id="@+id/tv_test_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_marks"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:tint="@color/colorSecondaryText"
                        app:srcCompat="@drawable/ic_star_outline"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorPrimaryText"
                        android:id="@+id/tv_scored_marks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorSecondaryText"
                        android:id="@+id/tv_max_marks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/colorSecondaryText"
                    android:ellipsize="end"
                    android:id="@+id/tv_total_attempts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="2dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_re_attempt"
                android:background="@drawable/bg_button_click_color_primary"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="@string/label_reattempt_test"
                android:textAllCaps="false"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/absent_red"
                android:ellipsize="end"
                android:id="@+id/tv_num_attempts_rem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/iv_student_locked"
                android:visibility="visible"
                android:layout_width="25dp"
                android:layout_height="30dp"
                app:srcCompat="@drawable/ic_locked"/>
            <TextView
                android:textSize="16sp"
                android:gravity="end"
                android:id="@+id/tv_update_status"
                android:padding="4dp"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="#efefef"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
