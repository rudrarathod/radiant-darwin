<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/layout_search_container"
    android:background="#f7f7f7"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_below="@+id/toolbar">
    <LinearLayout
        android:gravity="start"
        android:orientation="horizontal"
        android:id="@+id/layout_search"
        android:background="@drawable/shape_rectangle_filled_white_radius_2"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_margin="8dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/iv_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_search"
            app:tint="@color/colorSecondaryTextAlpha"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="14sp"
            android:textColorHint="@color/colorSecondaryText"
            android:gravity="start|center_vertical"
            android:layout_gravity="center"
            android:id="@+id/et_search"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:hint="@string/label_search_by_name"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/searchOverlayButton"
        android:background="#00000000"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        style="@style/Base.Widget.AppCompat.Button.Borderless"/>
</FrameLayout>
