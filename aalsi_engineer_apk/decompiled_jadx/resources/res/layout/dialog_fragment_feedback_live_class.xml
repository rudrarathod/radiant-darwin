<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@color/white"
    android:layout_width="@dimen/_270sdp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/_8sdp"
    app:cardUseCompatPadding="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:padding="@dimen/_16sdp"
        android:layout_width="@dimen/_270sdp"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/_13ssp"
            android:gravity="center"
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/nunito_sans_bold_14"/>
        <RatingBar
            android:id="@+id/rbLiveRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:numStars="5"
            android:stepSize="1"
            android:progressTint="@color/color_FDB306"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDialogTitle"/>
        <TextView
            android:textSize="@dimen/_12ssp"
            android:id="@+id/tvRatingTitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="@string/test"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rbLiveRating"
            style="@style/nunito_sans_semi_bold_14_black"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textColorHint="@color/color_7D8592"
            android:gravity="start"
            android:id="@+id/etRatingFeedback"
            android:background="@drawable/shape_rectangle_filled_white_outline_gray_r16"
            android:padding="@dimen/_16sdp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/_100sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:hint="@string/feel_free_to_add_comment"
            android:maxLines="4"
            android:maxLength="160"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvRatingTitle"/>
        <TextView
            android:enabled="false"
            android:gravity="center"
            android:id="@+id/btnSubmitFeedback"
            android:background="@drawable/shape_rectangle_filled_primary_r8"
            android:paddingLeft="@dimen/_16sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingRight="@dimen/_16sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:text="@string/submit"
            android:alpha="0.5"
            android:backgroundTint="@color/color_00ADE7"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingVertical="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etRatingFeedback"
            style="@style/nunito_sans_regular_14_white"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
