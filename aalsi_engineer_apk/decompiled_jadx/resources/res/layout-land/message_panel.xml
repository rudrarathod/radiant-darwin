<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout-land/message_panel_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/viewSeparator"
        android:background="@color/separator_grey"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_1sdp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llChatLock"
        android:background="@drawable/bg_round_white_stroke_blue"
        android:padding="@dimen/_6sdp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_8sdp">
        <ImageView
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:src="@drawable/lock_content"
            app:tint="@color/color_7D8592"/>
        <TextView
            android:textColor="@color/colorSecondaryText"
            android:textColorHint="@color/colorGray"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/buy_course_to_enable_the_chat"
            android:layout_marginStart="@dimen/_8sdp"
            style="@style/nunito_sans_regular_12"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llMessageParent"
        android:background="@android:color/white"
        android:padding="@dimen/_7sdp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_round_white_stroke_blue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageButton
                android:id="@+id/ibEmoji"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/_4sdp"
                android:layout_width="@dimen/_27sdp"
                android:layout_height="@dimen/_27sdp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/application_name"
                app:srcCompat="@drawable/ic_liveclass_emoji_keyboard"/>
            <com.vanniktech.emoji.EmojiEditText
                android:textColor="@color/colorSecondaryText"
                android:textColorHint="@color/colorGray"
                android:id="@+id/etEmoji"
                android:background="@android:color/transparent"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/write_something"
                android:maxLines="3"
                android:maxLength="500"
                android:inputType="textMultiLine"
                android:imeOptions="flagNoExtractUi|actionDone"
                android:autofillHints="Message"
                style="@style/nunito_sans_regular_12"/>
        </LinearLayout>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/ibSend"
            android:background="@drawable/liveclass_bg_rounded_blue"
            android:visibility="visible"
            android:layout_width="@dimen/_26sdp"
            android:layout_height="@dimen/_26sdp"
            android:contentDescription="@string/app_name"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            app:srcCompat="@drawable/ic_liveclass_send_msg_button"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ibHandRaise"
            android:background="@drawable/liveclass_bg_rounded_blue"
            android:padding="@dimen/_5sdp"
            android:visibility="gone"
            android:layout_width="@dimen/_26sdp"
            android:layout_height="@dimen/_26sdp"
            android:contentDescription="@string/app_name"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            app:srcCompat="@drawable/ic_liveclass_hand_raise"/>
    </LinearLayout>
</LinearLayout>
