<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:padding="10.0dip" android:shape="rectangle"
          xmlns:android="http://schemas.android.com/apk/res/android">
            <solid android:color="@color/colorPrimaryWithAlpha" />
            <corners android:radius="6.0dip" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape android:shape="rectangle"
          xmlns:android="http://schemas.android.com/apk/res/android">
            <solid android:color="@color/colorPrimary" />
            <gradient android:startColor="#ff0095de" android:endColor="#ff00c0ee" android:angle="180.0" android:type="linear" />
            <corners android:radius="6.0dip" />
        </shape>
    </item>
</selector>
