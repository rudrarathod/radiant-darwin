<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="false" android:text="P">
        <shape android:visible="true" android:shape="rectangle" android:useLevel="false">
            <solid android:color="@color/present_green" />
            <corners android:radius="17.0dip" />
        </shape>
    </item>
    <item android:state_checked="true" android:text="A">
        <shape android:visible="true" android:shape="rectangle" android:useLevel="false">
            <solid android:color="@color/white" />
            <stroke android:width="1.0dip" android:color="@color/divider" />
            <corners android:radius="17.0dip" />
        </shape>
    </item>
</selector>
