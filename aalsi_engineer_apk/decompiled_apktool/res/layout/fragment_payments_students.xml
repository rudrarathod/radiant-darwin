        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@id/ll_no_students" android:visibility="visible" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_centerInParent="true">
            <ImageView android:layout_width="100.0dip" android:layout_height="100.0dip" android:src="@drawable/ic_students_empty" />
            <TextView android:textSize="20.0sp" android:textColor="@color/black" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10.0dip" android:text="@string/no_students" />
        </LinearLayout>
    </RelativeLayout>
    <include layout="@layout/common_progressbar" />
</RelativeLayout>
